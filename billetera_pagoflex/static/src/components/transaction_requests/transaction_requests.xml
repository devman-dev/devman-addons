<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="billetera_pagoflex.Wallet_transfer_request" owl="1">
        <div class="col-12">
            <div class="row">
                <div>
                    <t t-if="state.transactions_filter.length == 0">
                        <hr />
                        <div class="text-center">
                            <p class="text-muted mb-1" style="font-size: 14px;">No hay movimientos</p>
                        </div>
                        <hr />
                    </t>
                    <t t-foreach="state.transactions_filter" t-as="transaction" t-key="transaction.id">
                        <div class="my-3">
                            <div class="row align-items-center text-start text-md-start">
                                <div class="col-6 mb-2 mb-md-0 d-flex justify-content-start align-items-center flex-wrap">
                                    <div class="px-2 ps-0">
                                        <t t-if="transaction.transfer_request_state == 'revisar' or transaction.transfer_request_state == 'nuevo'">
                                            <a href="#" class="cancel-transfer" t-att-data-href="'/wallet/transfer_request/cancel/' + transaction.id" data-bs-toggle="modal" data-bs-target="#confirmCancelModal">
                                                <i class="fa fa-times text-danger" aria-hidden="true"></i>
                                            </a>
                                        </t>
                                        <t t-else="">
                                            <span>&#160;&#160;&#160;</span>
                                        </t>
                                    </div>

                                    <!-- Modal de confirmación -->
                                    <div class="modal fade" id="confirmCancelModal" tabindex="-1" aria-labelledby="confirmCancelLabel" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="confirmCancelLabel">Confirmar
                                                        Cancelación</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    ¿Estás seguro de que querés cancelar
                                                    esta solicitud de transferencia?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                                                    <a id="confirmCancelBtn" t-att-href="'/wallet/transfer_request/cancel/' + transaction.id" class="btn btn-danger">Sí</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="" style="min-width: 100px; padding-left: 0px; font-size: 14px;">
                                        <t t-if="transaction.transfer_request_state == 'cancelado'">
                                            <span class="ps-2 position-relative">
                                                Cancelado <span class="position-absolute top-50 start-0 translate-middle p-1 bg-danger border border-light rounded-circle" />
                                            </span>
                                        </t>
                                        <t t-if="transaction.transfer_request_state == 'revisar'">
                                            <span class="ps-2 position-relative">
                                                Revisando <span class="position-absolute top-50 start-0 translate-middle p-1 bg-warning border border-light rounded-circle" />
                                            </span>
                                        </t>
                                        <t t-elif="transaction.transfer_request_state == 'nuevo'">
                                            <span class="ps-2 position-relative">
                                                Pendiente <span class="position-absolute top-50 start-0 translate-middle p-1 bg-info border border-light rounded-circle" />
                                            </span>
                                        </t>
                                        <t t-elif="transaction.transfer_request_state == 'pasado'">
                                            <span class="ps-2 position-relative">
                                                Aprobado <span class="position-absolute top-50 start-0 translate-middle p-1 bg-success border border-light rounded-circle" />
                                            </span>
                                        </t>
                                        <div class="text-start" style="font-size: 12px; margin-top: -2px;">
                                            <span class="me-1">
                                                <t t-out="transaction.alias_destination_account"/>
                                            </span>
                                            <span class="ms-1">
                                                <t t-out="transaction.description"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6 text-md-start mb-2 mb-md-0 d-flex flex-column align-items-end">
                                    <span style="font-size: 12px; font-weight: bold;">$
                                        <t t-out="transaction.amount.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })" />
                                    </span>
                                    <span style="font-size: 12px;">
                                        <t t-out="new Date(transaction.date + 'T00:00:00').toLocaleDateString('es-AR')" />
                                    </span>
                                </div>

                            </div>
                        </div>
                    </t>
                    <a t-att-href="'/wallet/tranfers_request/all/1'" class="btn btn-link float-end p-0">Ver movimientos <i class="fa fa-angle-right" aria-hidden="true" style="margin-left: 10px;"></i>
                    </a>
                </div>
            </div>
        </div>
