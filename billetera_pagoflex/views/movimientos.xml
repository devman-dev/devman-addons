<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="web_template_movements" name="Movimientos">
        <t t-call="website.layout">
            <style>
                main {
                background: linear-gradient(to top, #56FC81, #ffffff);
                font-family: Helvetica, Arial, sans-serif;
                }
                .text-truncate {
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
            </style>

            <div class="container" id="web_template_movements">
               <div class="row d-flex justify-content-center">
                    <div class="col-12 col-lg-5" id="web_template_movements">   
                        <div class="d-flex justify-content-between pt-3 pb-2">
                            <a href="/wallet" class="col-1 text-dark">
                                <i class="fa fa-arrow-left" aria-hidden="true" style="font-size: 18px; margin-right: 10px;"/>
                            </a>    
                            <p>Actividad</p>
                            <a class="text-end" t-att-href="'/wallet/export_excel/' + str(id_service) + '/?redirect_url=' + request.httprequest.url">Exportar Excel</a>
                        </div>
                        <div class="row pt-2 pb-2">
                            <!-- Barra de búsqueda -->
                            <!-- <div class="input-group" style="max-width: 85%;">
                                <span class="input-group-text bg-white" id="basic-addon1" style="border-right: none;">
                                    <i class="fa fa-search fa-lg"/>
                                </span>
                                <input type="text" class="form-control" placeholder="Buscar" aria-label="Buscar" aria-describedby="basic-addon1" style="border-left: none;"/>
                            </div> -->
                            <!-- Boton Filtros -->
                            <!-- <div class="d-flex flex-column align-items-center justify-content-center ps-2" style="max-width: 10%">
                                <i class="fa fa-sliders fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 40px; width: 40px;"/>
                            </div> -->
                        </div>
                    
                        <div class="row bg-white mx-2 my-3 py-3" style="border: 1px solid #56FC81; border-radius: 1rem; max-height: 650px; overflow-y: auto;">
                            <t t-if="not transactions">
                                <div class="text-center">
                                    <p class="text-muted mb-1" style="font-size: 14px;">No hay movimientos</p>
                                </div>
                            </t>
                            <t t-foreach="transactions" t-as="transaction">
                                <!-- Transaccion Acreditacion -->
                                <t t-if="transaction.collection_trans_type == 'movimiento_recaudacion' and transaction.operation.name == 'Transferencia'">
                                    <div class="col-2 ps-2 pe-1 mb-3">
                                        <i class="fa fa-exchange fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                    </div>
                                    <div class="col-6 px-0 mb-3">
                                        <div class="d-flex justify-content-between aling-items-end">
                                            <span class="small text-muted">
                                                <t t-out="transaction.date.strftime('%d/%m/%Y')"/>
                                            </span>
                                            <t t-if="transaction.customer_origin">
                                                <span class="font-weight-bold ">
                                                    <t t-out="customer_origin"/>
                                                </span>
                                            </t>
                                            <!-- <t t-elif="transaction.origen_name_account_extern">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.origin_name_account_extern"/>
                                                </span>
                                            </t> -->
                                            <t t-elif="transaction.origin_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.origin_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.origin_account_cuit">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.origin_account_cuit"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.origin_account_cvu">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.origin_account_cvu"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.origin_account_cbu">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.origin_account_cbu"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.alias_origen">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.alias_origen"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.alias_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.description"/>
                                                </span>
                                            </t>
                                        </div>
                                        <span class="text-center text-muted small">
                                            <t t-out="transaction.operation.name"/>
                                            ingreso
                                        </span>
                                    </div>
                                    <div t-att-class="'col-4 ps-1 pe-2 mb-3 d-flex justify-content-end align-items-start small ' + ('text-danger' if transaction.amount &lt; 0 else 'text-secondary')">
                                        $ <t t-out="('{:,.2f}'.format(transaction.amount)).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                    </div>
                                </t>
                                <!-- Retiro Transaccion -->
                                <t t-elif="transaction.collection_trans_type == 'retiro' and transaction.operation.name == 'Transferencia'">
                                    <div class="col-2 ps-2 pe-1 mb-3">
                                        <i class="fa fa-exchange fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                    </div>
                                    <div class="col-6 px-0 mb-3">
                                        <div class="d-flex justify-content-between aling-items-end">
                                            <span class="small text-muted">
                                                <t t-out="transaction.date.strftime('%d/%m/%Y')"/>
                                            </span>
                                            <t t-if="transaction.customer_destination">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="customer_destination"/>
                                                </span>
                                            </t>
                                            <!-- <t t-elif="transaction.origen_name_account_extern">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.origin_name_account_extern"/>
                                                </span>
                                            </t> -->
                                            <t t-elif="transaction.name_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.name_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cuit_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cuit_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cvu_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cvu_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cbu_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cbu_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.alias_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.alias_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.alias_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.description"/>
                                                </span>
                                            </t>
                                        </div>
                                        <span class="text-center text-muted small">
                                            <t t-out="transaction.operation.name"/>
                                            <t t-out="transaction.collection_trans_type"/>
                                        </span>
                                    </div>
                                    <div t-att-class="'col-4 ps-1 pe-2 mb-3 d-flex justify-content-end align-items-start small ' + ('text-danger' if transaction.amount &lt; 0 else 'text-secondary')">
                                        $ <t t-out="('{:,.2f}'.format(transaction.amount)).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                    </div>
                                </t>
                                <!-- Gastos de comision-->
                                <t t-elif="transaction.operation.name == 'Gastos'">
                                    <div class="col-2 ps-2 pe-1 mb-3">
                                        <i class="fa fa-money fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                    </div>
                                    <div class="col-6 px-0 mb-3">
                                        <div class="d-flex justify-content-between aling-items-end">
                                            <span class="small text-muted">
                                                <t t-out="transaction.date.strftime('%d/%m/%Y')"/>
                                            </span>
                                            <span class="font-weight-bold text-truncate ps-2 small">
                                                <t t-out="transaction.description"/>
                                            </span>
                                        </div>
                                        <span class="text-center text-muted small">
                                            <t t-out="transaction.operation.name"/>
                                        </span>
                                    </div>
                                    <div t-att-class="'col-4 ps-1 pe-2 mb-3 d-flex justify-content-end align-items-start small ' + ('text-danger' if transaction.amount &lt; 0 else 'text-secondary')">
                                        $ <t t-out="('{:,.2f}'.format(transaction.amount)).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                    </div>
                                </t>
                                
                                <!-- Pago de Servicios-->
                                <t t-elif="transaction.collection_trans_type == 'retiro' and transaction.operation.name == 'Pago de Servicio'">
                                    <div class="col-2 ps-2 pe-1 mb-3">
                                        <i class="fa fa-arrow-up" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                    </div>
                                    <div class="col-6 px-0 mb-3">
                                        <div class="d-flex justify-content-between aling-items-end">
                                            <span class="small text-muted">
                                                <t t-out="transaction.date.strftime('%d/%m/%Y')"/>
                                            </span>
                                            <t t-if="transaction.customer_destination">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="customer_destination"/>
                                                </span>
                                            </t>
                                            <!-- <t t-elif="transaction.origen_name_account_extern">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.origin_name_account_extern"/>
                                                </span>
                                            </t> -->
                                            <t t-elif="transaction.name_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.name_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cuit_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cuit_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cvu_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cvu_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cbu_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cbu_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.alias_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.alias_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.alias_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.description"/>
                                                </span>
                                            </t>
                                        </div>
                                        <span class="text-center text-muted small">
                                            <t t-out="transaction.operation.name"/>
                                            <!-- <t t-out="transaction.collection_trans_type"/> -->
                                        </span>
                                    </div>
                                    <div t-att-class="'col-4 ps-1 pe-2 mb-3 d-flex justify-content-end align-items-start small ' + ('text-danger' if transaction.amount &lt; 0 else 'text-secondary')">
                                        $ <t t-out="('{:,.2f}'.format(transaction.amount)).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                    </div>
                                </t>

                                <!-- Extraccion Efectivo Pesos -->
                                <t t-elif="transaction.collection_trans_type == 'retiro' and transaction.operation.name == 'Extraccion Efectivo Pesos'">
                                    <div class="col-2 ps-2 pe-1 mb-3">
                                        <i class="fa fa-arrow-up" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                    </div>
                                    <div class="col-6 px-0 mb-3">
                                        <div class="d-flex justify-content-between aling-items-end">
                                            <span class="small text-muted">
                                                <t t-out="transaction.date.strftime('%d/%m/%Y')"/>
                                            </span>
                                            <t t-if="transaction.customer_destination">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="customer_destination"/>
                                                </span>
                                            </t>
                                            <!-- <t t-elif="transaction.origen_name_account_extern">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.origin_name_account_extern"/>
                                                </span>
                                            </t> -->
                                            <t t-elif="transaction.name_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.name_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cuit_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cuit_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cvu_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cvu_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cbu_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cbu_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.alias_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.alias_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.alias_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.description"/>
                                                </span>
                                            </t>
                                        </div>
                                        <span class="text-center text-muted small">
                                            <t t-out="transaction.operation.name"/>
                                            <!-- <t t-out="transaction.collection_trans_type"/> -->
                                        </span>
                                    </div>
                                    <div t-att-class="'col-4 ps-1 pe-2 mb-3 d-flex justify-content-end align-items-start small ' + ('text-danger' if transaction.amount &lt; 0 else 'text-secondary')">
                                        $ <t t-out="('{:,.2f}'.format(transaction.amount)).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                    </div>
                                </t>
                                
                                <!-- Default -->
                                <t t-else="">
                                    <div class="col-2 ps-2 pe-1 mb-3">
                                        <i class="fa fa-exchange fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                    </div>
                                    <div class="col-6 px-0 mb-3">
                                        <div class="d-flex justify-content-between aling-items-end">
                                            <span class="small text-muted">
                                                <t t-out="transaction.date.strftime('%d/%m/%Y')"/>
                                            </span>
                                            <t t-if="transaction.customer_destination">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="customer_destination"/>
                                                </span>
                                            </t>
                                            <!-- <t t-elif="transaction.origen_name_account_extern">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.origin_name_account_extern"/>
                                                </span>
                                            </t> -->
                                            <t t-elif="transaction.name_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.name_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cuit_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cuit_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cvu_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cvu_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.cbu_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.cbu_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.alias_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.alias_destination_account"/>
                                                </span>
                                            </t>
                                            <t t-elif="transaction.alias_destination_account">
                                                <span class="font-weight-bold text-truncate ps-2 small">
                                                    <t t-out="transaction.description"/>
                                                </span>
                                            </t>
                                        </div>
                                        <span class="text-center text-muted small">
                                            <t t-out="transaction.operation.name"/>
                                            <!-- <t t-out="transaction.collection_trans_type"/> -->
                                        </span>
                                    </div>
                                    <div t-att-class="'col-4 ps-1 pe-2 mb-3 d-flex justify-content-end align-items-start small ' + ('text-danger' if transaction.amount &lt; 0 else 'text-secondary')">
                                        $ <t t-out="('{:,.2f}'.format(transaction.amount)).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>                
            </div>
        </t>
    </template>

</odoo>