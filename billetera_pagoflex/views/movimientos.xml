                            <i class="fa fa-exchange fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                        </div>
                        <div class="col-6 px-0 mb-3">
                            <div class="d-flex justify-content-between aling-items-end">
                                <span class="small text-muted">
                                    <t t-out="transaction.date.strftime('%d/%m/%Y')"/>
                                </span>
                                <strong class="font-weight-bold">Juan perez</strong>
                            </div>
                            <span class="text-center text-muted small">Transferencia recibida </span>
                        </div>
                            
                        <div class="col-4 ps-1 pe-2 mb-3 d-flex justify-content-end align-items-start">
                            $ <t t-out="('{:,.2f}'.format(transaction.amount)).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
