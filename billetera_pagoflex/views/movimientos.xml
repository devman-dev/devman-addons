<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="web_template_movements" name="Movimientos">
        <t t-call="website.layout">
            <style>
                main {
                background: linear-gradient(to top, #56FC81, #ffffff);
                font-family: Helvetica, Arial, sans-serif;
                }
            </style>

            <div class="container">
                
                <div class="row pt-3 pb-2">
                    <a href="/wallet" class="col-1 text-dark">
                        <i class="fa fa-arrow-left" aria-hidden="true" style="font-size: 18px; margin-right: 10px;"/>
                    </a>    
                    <p class="col-11 text-center m-0 p-0 pe-5">Actividad</p>
                </div>
                <div class="row pt-2 pb-2">
                    <!-- Barra de búsqueda -->
                    <div class="input-group" style="max-width: 85%;">
                        <span class="input-group-text bg-white" id="basic-addon1" style="border-right: none;">
                            <i class="fa fa-search fa-lg"/>
                        </span>
                        <input type="text" class="form-control" placeholder="Buscar" aria-label="Buscar" aria-describedby="basic-addon1" style="border-left: none;"/>
                    </div>
                    <!-- Boton Filtros -->
                    <div class="d-flex flex-column align-items-center justify-content-center ps-2" style="max-width: 10%">
                        <i class="fa fa-sliders fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 40px; width: 40px;"/>
                    </div>
                </div>
                
                <div class="row bg-white mx-2 my-3 py-3" style="border: 1px solid #56FC81; border-radius: 1rem;">
                    <t t-if="not transactions">
                        <div class="text-center">
                            <p class="text-muted mb-1" style="font-size: 14px;">No hay movimientos</p>
                        </div>
                    </t>
                    <t t-foreach="transactions" t-as="transaction">
                        
