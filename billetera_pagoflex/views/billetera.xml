<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="website_wallet_menu" model="website.menu">
        <field name="name">Billetera</field>
        <field name="url">/wallet</field>
        <field name="parent_id" ref="website.main_menu" />
        <field name="sequence" type="int">90</field>
    </record>

    <!-- Billetera -->
    <template id="web_template_wallet" name="Billetera">
        <t t-call="website.layout">
            <style>
                main {
                background: linear-gradient(to top, #56FC81, #ffffff);
                font-family: Helvetica, Arial, sans-serif;
                }

                .wallet-card {
                background-color: white;
                border-radius: 0.5rem;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                }

                .wallet-section {
                margin-top: 2rem;
                margin-bottom: 2rem;
                }

                .btn-outline-secondary {
                text-align: center;
                }
            </style>

            <div class="container px-4 px-md-0">
                <div class="row  pt-4 px-2 px-md-0">
                    <div class="col-12 col-md-6 ">
                        <div class="px-2">
                            <div class="row py-2">
                                <span class="text-center px-2">Hola <t t-out="user_name"/>
                                </span>
                            </div>
                            <div class="row" style="background-color:#56FC81; border-radius: 1rem;">
                                <div class="col-12">
                                    <label class="d-flex align-items-center justify-content-between py-2" style="cursor: pointer;">
                                        <i class="fa fa-eye" aria-hidden="true"></i>
                                        <span class="" style="padding-left: 5rem;">Saldo Disponible</span>
                                        <select class="px-3" id="currency_select" name="currency" style="background-color:#56FC81; border: #C6FDFF; outline: #C6FDFF;">
                                            <option value="pesos" t-att-selected="'selected'">Pesos</option>
                                            <option value="dolar" t-att-selected="">Dólar</option>
                                            <option value="qr" t-att-selected="">QR</option>
                                        </select>
                                    </label>
                                </div>
                                <div class="col-12 text-center d-flex justify-content-around align-items-center py-3" style="">
                                    <h4 class="mb-0 text-secundary">
                                        $                                        
                                        <span t-att-class="'mb-0 ' + ('text-danger' if customer_balance &lt; 0 else 'text-secondary')">
                                            <t t-out="('{:,.2f}'.format(customer_balance)).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                        </span>
                                    </h4>
                                </div>
                            </div>
                            <div class="row p-4" style="font-size: 14px;">
                                <div class="col-12 p-2 my-2 d-flex justify-content-around align-items-center">
                                    <!-- <a href="/wallet/transfer/accounts" class="d-flex flex-column align-items-center justify-content-center" style="color: black;">
                                        <i class="fa fa-long-arrow-up fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                        <span class="">Ingresar</span>
                                    </a>
                                    <a href="/wallet/transfer/accounts" class="d-flex flex-column align-items-center justify-content-center" style="color: black;">
                                        <i class="fa fa-long-arrow-down fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                        <span class="">Sacar</span>
                                    </a> -->
                                    <a href="/wallet/transfer_request" class="d-flex flex-column align-items-center justify-content-center" style="color: black;">
                                        <i class="fa fa-exchange fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                        <span class="">Pedido de Transferencias</span>
                                    </a>
                                    <!-- <a href="/wallet/transfer/accounts" class="d-flex flex-column align-items-center justify-content-center" style="color: black;">
                                        <i class="fa fa-user-o fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                        <span class="">CVU</span>
                                    </a>
                                    <a href="/wallet/transfer/accounts" class="d-flex flex-column align-items-center justify-content-center" style="color: black;">
                                        <i class="fa fa-qrcode fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                        <span class="">QR</span>
                                    </a> -->
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 pb-5">
                        <div class="row bg-white" style="border: 1px solid #56FC81; border-radius: 1rem;">
                            <p class="col-6 text-right pt-3 m-0">Actividad</p>
                            <a href="/wallet/movements/all/1" class="col-6 text-end pt-3 m-0" style="color: #02F1FB">Ver todo <i class="fa fa-angle-right" aria-hidden="true" style="margin-left: 10px;"></i>
                            </a>
                            <div class="col-12 px-3">
                                <hr/>
                            </div>
                            <div class="col-12 col-md-6 p-2">
                                <div class="px-2">
                                    <owl-component class="" name="billetera_pagoflex.Wallet_filters"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>