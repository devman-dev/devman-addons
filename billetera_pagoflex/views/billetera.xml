<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="website_wallet_menu" model="website.menu">
        <field name="name">Billetera</field>
        <field name="url">/wallet</field>
        <field name="parent_id" ref="website.main_menu" />
        <field name="sequence" type="int">90</field>
    </record>

    <!-- Billetera -->
    <template id="web_template_wallet" name="Billetera">
                <t t-call="website.layout">
            <style>
                main {
                background: linear-gradient(to top, #56FC81, #ffffff);
                font-family: Helvetica, Arial, sans-serif;
                }

                .wallet-card {
                background-color: white;
                border-radius: 0.5rem;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                }

                .wallet-section {
                margin-top: 2rem;
                margin-bottom: 2rem;
                }

                .btn-outline-secondary {
                text-align: center;
                }
            </style>

            <div class="container px-4 px-md-0">
                <div class="row d-flex justify-content-center pt-4 px-2 px-md-0 ">
                    <div class="col-12 col-lg-4  ">
                        <div class="px-2">
                            <div class="row py-2">
                                <span class="text-center px-2">Hola, <t t-out="user_name"/>
                                </span>
                            </div>

                            <t t-foreach="grouped_transactions.items()" t-as="group">
                                <div class="row my-2" style="background-color:#56FC81; border-radius: 1rem; border: 1px solid #56FC81;">
                                    <div class="row pt-3">
                                        <div class="col-9">
                                            <span style="margin-left:10px;">
                                            <t t-if="group[0] != 'Sin Servicio'">
                                                <t t-out="request.env['collection.services.commission'].sudo().browse(group[0]).display_name"/>
                                            </t>
                                            </span>
                                        </div>
                                        <div class="col-3 d-flex justify-content-end px-0">
                                            <a href="#" class="btn-sm btn-primary" data-bs-toggle="modal" t-att-data-bs-target="'#watchDataModal_'+ str(group[0])">
                                                Ver Datos
                                            </a>
                                        </div>

                                        <div class="modal fade" t-att-id="'watchDataModal_'+ str(group[0])" tabindex="-1" aria-labelledby="watchDataLabel" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content" style="background: linear-gradient(to top, #C6FDFF, #ffffff); border: 1px solid #56FC81;">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="watchDataLabel">Datos de la cuenta</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p>
                                                            <b>Nombre: </b>
                                                            <t t-out="request.env['collection.services.commission'].sudo().browse(group[0]).name_account"/>
                                                        </p>
                                                        <p>
                                                            <b>CUIT: </b>
                                                            <t t-out="request.env['collection.services.commission'].sudo().browse(group[0]).cuit"/>
                                                        </p>
                                                        <p>
                                                            <b>CBU: </b>
                                                            <t t-out="request.env['collection.services.commission'].sudo().browse(group[0]).cbu"/>
                                                        </p>
                                                        <p>
                                                            <b>CVU: </b>
                                                            <t t-out="request.env['collection.services.commission'].sudo().browse(group[0]).cvu"/>
                                                        </p>
                                                        <p>
                                                            <b>ALIAS: </b>
                                                            <t t-out="request.env['collection.services.commission'].sudo().browse(group[0]).alias"/>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row pt-2 pb-3">
                                        <div class="col-9">
                                            <h4 class="mb-0 text-secundary" style="margin-left:10px;">
                                                $
                                                <span t-att-class="'mb-0 ' + ('text-danger' if group[1] &lt; 0 else 'text-secondary')">
                                                    <t t-out="('{:,.2f}'.format(group[1])).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                                </span>
                                            </h4>
                                        </div>
                                        <div class="col-3 d-flex justify-content-end px-0">
                                            <a t-att-href="'/wallet/movements/all/' + str(group[0]) + '/1'" style="text-shadow: 0 0 6px #C6FDFF">Ver todo <i class="fa fa-angle-right" aria-hidden="true"/>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <!-- Botones de accion -->
                            <div class="row p-4" style="font-size: 14px;">
                                <div class="col-12 p-2 my-2 d-flex justify-content-around align-items-center">
                                    <!-- <a href="/wallet/transfer/accounts" class="d-flex flex-column align-items-center justify-content-center" style="color: black;">
                                        <i class="fa fa-long-arrow-up fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                        <span class="text-center pt-1" style="max-width: 90px;">Ingresar</span>
                                    </a>-->
                                    <a href="/wallet/transfer_request" class="d-flex flex-column align-items-center justify-content-center" style="color: black;" data-value="transferencia">
                                        <i class="fa fa-exchange fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"/>
                                        <span class="text-center pt-1" style="max-width: 90px;">Pedido de Transferencias</span>
                                    </a>

                                     <a href="/wallet/transfer_request/withdrawal" class="d-flex flex-column align-items-center justify-content-center" style="color: black;" data-value="retiro">
                                        <i class="fa fa-long-arrow-down fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                        <span class="text-center pt-1" style="max-width: 90px;">Pedido Retiro Efectivo</span>
                                    </a>

                                    <!-- <a href="/wallet/transfer/accounts" class="d-flex flex-column align-items-center justify-content-center" style="color: black;">
                                        <i class="fa fa-user-o fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                        <span class="text-center pt-1" style="max-width: 90px;">CVU</span>
                                    </a>
                                    <a href="/wallet/transfer/accounts" class="d-flex flex-column align-items-center justify-content-center" style="color: black;">
                                        <i class="fa fa-qrcode fa-lg" aria-hidden="true" style="display: flex; align-items: center; justify-content: center;background-color:#C6FDFF; border-radius: 50%; height: 45px; width: 45px;"></i>
                                        <span class="text-center pt-1" style="max-width: 90px;">QR</span>
                                    </a> -->
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- <div class="col-12 pb-5">
                        <div class="row bg-white" style="border: 1px solid #56FC81; border-radius: 1rem;">
                            <p class="col-6 text-right pt-3 m-0">Actividad</p>
                            <a href="/wallet/movements/all/1" class="col-6 text-end pt-3 m-0" style="color: #02F1FB">Ver todo <i class="fa fa-angle-right" aria-hidden="true" style="margin-left: 10px;"></i>
                            </a>
                            <div class="col-12 px-3">
                                <hr/>
                            </div>
                            <div class="col-12 col-md-6 p-2">
                                <div class="px-2">
                                    <owl-component class="" name="billetera_pagoflex.Wallet_filters"/>
                                </div>
                            </div>
                        </div>
                    </div> -->
                </div>
            </div>
        </t>
    </template>

</odoo>