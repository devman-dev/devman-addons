<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Transferencia Enviada -->
    <template id="web_form_template_request_transfer" name="Pedido de transferencias">
        <t t-call="website.layout">

            <style>
                body {
                background-color: #f8f9fa;
                }
            </style>

            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-sm-10 col-md-8 col-lg-6">
                        <form action="/wallet/transfer_request/sended" method="post" enctype="multipart/form-data" class="o_mark_required p-4 bg-white shadow rounded">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />

                            <button class="btn btn-secondary mb-3" onclick="document.getElementById('transfer-form').classList.toggle('d-none')" type="button">
                                Mostrar/Ocultar Formulario
                            </button>

                            <div id="transfer-form" class="d-none">
                                <div class="mb-3">
                                    <label for="fecha" class="form-label">Fecha</label>
                                    <input type="date" id="fecha" name="fecha" class="form-control" t-att-value="time.strftime('%Y-%m-%d')" required="True" />
                                </div>
                                <div class="mb-3">
                                    <label for="cuenta_destino" class="form-label">Nombre Cuenta de Destino</label>
                                    <input type="text" id="cuenta_destino" name="cuenta_destino" class="form-control" placeholder="Ingrese la cuenta de destino." />
                                </div>

                                <div class="mb-3">
                                    <label for="alias" class="form-label">Alias</label>
                                    <input type="text" id="alias" name="alias" class="form-control" placeholder="Ingrese el alias" />
                                </div>

                                <div class="mb-3">
                                    <label for="cvu" class="form-label">CBU/CVU</label>
                                    <input type="text" id="cvu" name="cvu" class="form-control" placeholder="Ingrese el CBU/CVU" />
                                </div>

                                <div class="mb-3">
                                    <label for="cuit" class="form-label">CUIT/CUIL</label>
                                    <input type="text" id="cuit" name="cuit" class="form-control" placeholder="Ingrese el CUIT/CUIL" />
                                </div>

                                <div class="mb-3">
                                    <label for="monto" class="form-label">Monto</label>
                                    <input type="text" id="monto" name="monto" class="form-control" placeholder="Ingrese el monto" required="True" />
                                </div>

                                <script>
                                    document.addEventListener("DOMContentLoaded", function () {
                                        const montoInput = document.getElementById("monto");

                                        montoInput.addEventListener("blur", function () {  // Se ejecuta al salir del input
                                            let value = montoInput.value.replace(/\./g, "").replace(/,/g, "."); // Quita puntos y cambia coma por punto
                                            let number = parseFloat(value);

                                            if (!isNaN(number)) {
                                                montoInput.value = new Intl.NumberFormat("es-AR", {
                                                    minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2
                                                }).format(number);
                                            }
                                        });
                                    });
                                </script>

                                <div class="mb-3">
                                    <label for="comentario" class="form-label">Descripción</label>
                                    <textarea id="comentario" name="comentario" class="form-control" rows="3" placeholder="Agregue una descripción"></textarea>
                                </div>

                                <div class="text-center">
                                    <button type="submit" class="btn btn-primary">Solicitar
                                        Pedido de Transferencia</button>
                                </div>

                            </div>
                        </form>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="wallet-card px-4 bg-white shadow rounded">
                            <owl-component class="" name="billetera_pagoflex.Wallet_transfer_request" />
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>


    <template id="web_template_transfer_request" name="Pedidos de Transferencias">
        <t t-call="website.layout">
            <style>
                body {
                background-color: #f8f9fa;
                }
                .wallet-card {
                background-color: white;
                border-radius: 0.5rem;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                padding: 1.5rem;
                }

                .wallet-section {
                margin-top: 2rem;
                margin-bottom: 2rem;
                }

                .btn-outline-secondary {
                text-align: center;
                }
            </style>

            <div class="container">
                <div class="wallet-card mx-auto col-12 col-md-6 wallet-section">
                    <a href="/wallet/transfer_request">
                        <i class="fa fa-angle-left" aria-hidden="true" style="font-size: 18px; margin-right: 10px;"></i>
                        Atras
                    </a>
                    <hr />
                    <div class="mt-3">
                        <div>
                            <t t-if="not transactions">
                                <hr />
                                <div class="text-center">
                                    <p class="text-muted mb-1" style="font-size: 14px;">No hay
                                        movimientos</p>
                                </div>
                                <hr />
                            </t>
                            <t t-foreach="transactions" t-as="transaction">
                                <div class="my-3">
                                    <div class="row align-items-center text-start text-md-start">
                                        <div class="col-6 mb-2 mb-md-0 d-flex justify-content-start align-items-center flex-wrap">
                                            <div class="px-2 ps-0">
                                                <t t-if="transaction.transfer_request_state == 'revisar' or transaction.transfer_request_state == 'nuevo'">
                                                    <a href="#" class="cancel-transfer" t-att-data-href="'/wallet/transfer_request/cancel/%s' % (transaction.id)" data-bs-toggle="modal" data-bs-target="#confirmCancelModal">
                                                        <i class="fa fa-times text-danger" aria-hidden="true"></i>
                                                    </a>
                                                </t>
                                                <t t-else="">
                                                    <span>&#160;&#160;&#160;</span>
                                                </t>
                                            </div>

                                            <!-- Modal de confirmación -->
                                            <div class="modal fade" id="confirmCancelModal" tabindex="-1" aria-labelledby="confirmCancelLabel" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="confirmCancelLabel">Confirmar
                                                                Cancelación</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            ¿Estás seguro de que querés cancelar
                                                            esta solicitud de transferencia?
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                                                            <a id="confirmCancelBtn" t-att-href="'/wallet/transfer_request/cancel/%s' % (transaction.id)" class="btn btn-danger">Sí</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="" style="min-width: 100px; padding-left: 10px; font-size: 12px;">
                                                <t t-if="transaction.transfer_request_state == 'cancelado'">
                                                    <span class="ps-2 position-relative"> Cancelado <span class="position-absolute top-50 start-0 translate-middle p-1 bg-danger border border-light rounded-circle" />
                                                    </span>
                                                </t>
                                                <t t-if="transaction.transfer_request_state == 'revisar'">
                                                    <span class="ps-2 position-relative"> Revisando <span class="position-absolute top-50 start-0 translate-middle p-1 bg-warning border border-light rounded-circle" />
                                                    </span>
                                                </t>
                                                <t t-elif="transaction.transfer_request_state == 'nuevo'">
                                                    <span class="ps-2 position-relative"> Pendiente <span class="position-absolute top-50 start-0 translate-middle p-1 bg-info border border-light rounded-circle" />
                                                    </span>
                                                </t>
                                                <t t-elif="transaction.transfer_request_state == 'pasado'">
                                                    <span class="ps-2 position-relative"> Aprobado <span class="position-absolute top-50 start-0 translate-middle p-1 bg-success border border-light rounded-circle" />
                                                    </span>
                                                </t>
                                                <div class="text-start" style="font-size: 12px; margin-top: -2px;">
                                                    <span class="me-1">
                                                        <t t-out="transaction.alias_destination_account" />
                                                    </span>
                                                    <span class="ms-1">
                                                        <t t-out="transaction.description" />
                                                    </span>
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-6 text-md-start mb-2 mb-md-0 d-flex flex-column align-items-end">
                                            <span style="font-size: 12px; font-weight: bold;">$                       
                                                <t t-out="('{:,.2f}'.format(transaction.amount)).replace(',', 'X').replace('.', ',').replace('X', '.')" />
                                            </span>
                                            <span style="font-size: 12px;">
                                                <t t-out="transaction.date.strftime('%d/%m/%Y')" />
                                            </span>
                                        </div>

                                    </div>
                                </div>
                            </t>
                            <hr />
                            <nav aria-label="...">
                                <ul class="pagination pagination-lg justify-content-center">
                                    <t t-foreach="visible_pages" t-as="page_number">
                                        <li t-att-class="'page-item ' + ('active' if page_number == current_page else '')">
                                            <t t-if="page_number == '...'">
                                                <span class="page-link">...</span>
                                            </t>
                                            <t t-else="">
                                                <a class="page-link" t-att-href="'/wallet/tranfers_request/%s/%d' % (mov_type, page_number)">
                                                    <t t-esc="page_number" />
                                                </a>
                                            </t>
                                        </li>
                                    </t>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="web_form_template_transfer_request_sended" name="Billetera">
        <t t-call="website.layout">

            <style>
                body {
                background-color: #f8f9fa;
                }
            </style>

            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-sm-10 col-md-8 col-lg-6">
                        <form action="/wallet/transfer_request" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="" data-success-page="">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                            <div class="bg-white p-4 shadow rounded text-center">
                                <div style="margin: 15px 0;">
                                    <t t-if="state_request">
                                        <h4>Pedido de transferencia enviado <i class="fa fa-check-circle-o" aria-hidden="true" style="color:green;"></i>
                                        </h4>
                                    </t>
                                    <t t-else="">
                                        <h4>Ocurrio un error al crear el pedido de transferencia <i class="fa fa-times-circle-o" aria-hidden="true" style="color:red;"></i>
                                        </h4>
                                    </t>

                                </div>

                                <div class="form-group col-12 s_website_form_submit confirm-data d-flex justify-content-center">
                                    <button type="submit" class="btn btn-primary w-50">Volver</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </t>
    </template>

</odoo>