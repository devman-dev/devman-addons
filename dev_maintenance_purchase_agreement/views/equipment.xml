<odoo>
    <record id="form_equipment_dev_maintenance_purchase_agreement_inherited" model="ir.ui.view">
        <field name="name">form_equipment_dev_maintenance_purchase_agreement_inherited_name</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
				<page string="Maintenance Plan Material" name="plan_material">
					<field name="plan_material_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="quantity"/>
                        </list>
                        <form>
                            <group>
                                <group>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                </group>
                            </group>
                        </form>
                    </field>
				</page>
            </xpath>
        </field>
    </record>
</odoo>
