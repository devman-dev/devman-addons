<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agregar entrada en el menú del portal -->
    <template id="portal_my_home_menu_projects" name="Portal My Home Menu - Projects" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_project_count" t-value="request.env['project.project'].search_count([])"/>
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/project/static/img/project_icon.png'"/>
                <t t-set="title">Proyectos</t>
                <t t-set="url" t-value="'/my/projects'"/>
                <t t-set="text">Gestiona tus proyectos</t>
                <t t-set="count" t-value="portal_project_count"/>
            </t>
        </xpath>
    </template>

    <!-- Vista principal: Lista de proyectos con KPIs -->
    <template id="portal_my_projects" name="My Projects">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Proyectos</t>
            </t>

            <div class="container mt-2">
                <!-- KPIs Dashboard -->
                <div class="row mb-2">
                    <div class="col-12">
                        <h4 class="mb-1">Dashboard de Proyectos</h4>
                    </div>
                    
                    <!-- KPI: Total de Proyectos -->
                    <div class="col-lg-3 col-md-6 mb-1">
                        <div class="card border-primary kpi-card">
                            <div class="card-body">
                                <h2 class="text-primary mb-0">
                                    <t t-esc="kpis.get('total', 0)"/>
                                </h2>
                                <div class="kpi-content">
                                    <p class="text-muted mb-0">Total Proyectos</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPIs por Estado -->
                    <t t-foreach="stages" t-as="stage">
                        <div class="col-lg-3 col-md-6 mb-1">
                            <div class="card border-info kpi-card">
                                <div class="card-body">
                                    <h2 class="text-info mb-0">
                                        <t t-esc="kpis.get(stage.name, 0)"/>
                                    </h2>
                                    <div class="kpi-content">
                                        <p class="text-muted mb-0">
                                            <t t-esc="stage.name"/>
                                            <small class="text-muted">
                                                (<t t-esc="kpi_percentages.get(stage.name, 0)"/>%)
                                            </small>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Gráfico de barras simple con CSS -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card distribution-card">
                            <div class="card-header">
                                <h5>Distribución de Proyectos por Estado</h5>
                            </div>
                            <div class="card-body">
                                <t t-foreach="stages" t-as="stage">
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span><t t-esc="stage.name"/></span>
                                            <span><t t-esc="kpis.get(stage.name, 0)"/> proyectos</span>
                                        </div>
                                        <div class="progress">
                                            <div class="progress-bar bg-info" role="progressbar" 
                                                 t-att-style="'width: ' + str(kpi_percentages.get(stage.name, 0)) + '%'"
                                                 t-att-aria-valuenow="kpi_percentages.get(stage.name, 0)"
                                                 aria-valuemin="0" aria-valuemax="100">
                                                <t t-esc="kpi_percentages.get(stage.name, 0)"/>%
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Lista de Proyectos -->
                <div class="row">
                    <div class="col-12">
                        <h5 class="mb-1">Lista de Proyectos</h5>
                        <t t-if="not projects">
                            <div class="alert alert-info">
                                No hay proyectos disponibles.
                            </div>
                        </t>
                        <t t-else="">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Nombre</th>
                                            <th>Cliente</th>
                                            <th>Estado</th>
                                            <th>Tareas</th>
                                            <th>Fecha Creación</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="projects" t-as="project">
                                            <tr>
                                                <td>
                                                    <strong><t t-esc="project.name"/></strong>
                                                </td>
                                                <td>
                                                    <t t-if="project.partner_id">
                                                        <t t-esc="project.partner_id.name"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted">-</span>
                                                    </t>
                                                </td>
                                                <td>
                                                    <t t-if="project.stage_id">
                                                        <span class="badge bg-info">
                                                            <t t-esc="project.stage_id.name"/>
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-secondary">Sin Estado</span>
                                                    </t>
                                                </td>
                                                <td>
                                                    <t t-esc="project.task_count"/>
                                                </td>
                                                <td>
                                                    <t t-esc="project.create_date.strftime('%d/%m/%Y')"/>
                                                </td>
                                                <td>
                                                    <a t-attf-href="/project/#{project.id}" 
                                                       class="btn btn-sm btn-primary">
                                                        Ver Detalle
                                                    </a>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            
                            <!-- Paginación -->
                            <div t-if="pager" class="o_portal_pager text-center">
                                <t t-call="portal.pager"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Vista de detalle de proyecto -->
    <template id="portal_my_project_detail" name="My Project Detail">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <!-- Breadcrumb -->
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="/projects">Proyectos</a></li>
                    <li class="breadcrumb-item active"><t t-esc="project.name"/></li>
                </ol>

                <!-- Cabecera del Proyecto -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h3 class="mb-0"><t t-esc="project.name"/></h3>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>Cliente:</strong> 
                                            <t t-if="project.partner_id">
                                                <t t-esc="project.partner_id.name"/>
                                            </t>
                                            <t t-else="">-</t>
                                        </p>
                                        <p><strong>Estado:</strong> 
                                            <t t-if="project.stage_id">
                                                <span class="badge bg-info">
                                                    <t t-esc="project.stage_id.name"/>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-secondary">Sin Estado</span>
                                            </t>
                                        </p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Fecha Inicio:</strong> 
                                            <t t-if="project.date_start">
                                                <t t-esc="project.date_start.strftime('%d/%m/%Y')"/>
                                            </t>
                                            <t t-else="">-</t>
                                        </p>
                                        <p><strong>Fecha Creación:</strong> 
                                            <t t-esc="project.create_date.strftime('%d/%m/%Y')"/>
                                        </p>
                                    </div>
                                </div>
                                <t t-if="project.description">
                                    <hr/>
                                    <p><strong>Descripción:</strong></p>
                                    <div t-field="project.description"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPIs del Proyecto -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card border-primary">
                            <div class="card-body text-center">
                                <h2 class="text-primary mb-0">
                                    <t t-esc="task_kpis['total']"/>
                                </h2>
                                <p class="text-muted mb-0">Total Tareas</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-success">
                            <div class="card-body text-center">
                                <h2 class="text-success mb-0">
                                    <t t-esc="task_kpis['done']"/>
                                </h2>
                                <p class="text-muted mb-0">Tareas Completadas</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-warning">
                            <div class="card-body text-center">
                                <h2 class="text-warning mb-0">
                                    <t t-esc="task_kpis['in_progress']"/>
                                </h2>
                                <p class="text-muted mb-0">Tareas en Progreso</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Lista de Tareas -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="mb-0">Tareas del Proyecto</h4>
                            </div>
                            <div class="card-body">
                                <t t-if="not tasks">
                                    <p class="text-muted">No hay tareas en este proyecto.</p>
                                </t>
                                <t t-else="">
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Tarea</th>
                                                    <th>Asignado a</th>
                                                    <th>Estado</th>
                                                    <th>Prioridad</th>
                                                    <th>Fecha Límite</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="tasks" t-as="task">
                                                    <tr>
                                                        <td><t t-esc="task.name"/></td>
                                                        <td>
                                                            <t t-if="task.user_ids">
                                                                <t t-esc="', '.join(task.user_ids.mapped('name'))"/>
                                                            </t>
                                                            <t t-else="">-</t>
                                                        </td>
                                                        <td>
                                                            <span class="badge" 
                                                                  t-attf-class="badge bg-{{ 'success' if task.stage_id.fold else 'warning' }}">
                                                                <t t-esc="task.stage_id.name"/>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <t t-if="task.priority == '1'">
                                                                <span class="badge bg-danger">Alta</span>
                                                            </t>
                                                            <t t-elif="task.priority == '0'">
                                                                <span class="badge bg-secondary">Normal</span>
                                                            </t>
                                                        </td>
                                                        <td>
                                                            <t t-if="task.date_deadline">
                                                                <t t-esc="task.date_deadline.strftime('%d/%m/%Y')"/>
                                                            </t>
                                                            <t t-else="">-</t>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
