<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pagoflex_balance_adjustment_form" model="ir.ui.view">
        <field name="name">pagoflex.balance.adjustment.form</field>
        <field name="model">pagoflex.balance.adjustment</field>
        <field name="arch" type="xml">
            <form string="Ajuste de Saldo">
                <header>
                    <button name="action_confirm_and_send" string="Confirmar y Enviar al Gateway" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_check_status" string="Consultar Estado" type="object" invisible="not gateway_adjustment_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,synced,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="cvu_cbu"/>
                            <field name="direction" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="reason_code" readonly="state != 'draft'"/>
                            <field name="external_reference" readonly="state != 'draft'"/>
                            <field name="operator_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page string="Gateway Info">
                            <group>
                                <field name="idempotency_key"/>
                                <field name="gateway_adjustment_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pagoflex_balance_adjustment_tree" model="ir.ui.view">
        <field name="name">pagoflex.balance.adjustment.tree</field>
        <field name="model">pagoflex.balance.adjustment</field>
        <field name="arch" type="xml">
            <list string="Ajustes de Saldo" decoration-info="state == 'draft'" decoration-success="state == 'synced'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="cvu_cbu"/>
                <field name="direction"/>
                <field name="amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'synced'" decoration-danger="state == 'failed'"/>
                <field name="operator_id"/>
            </list>
        </field>
    </record>

    <record id="action_pagoflex_balance_adjustment" model="ir.actions.act_window">
        <field name="name">Ajustes de Saldo</field>
        <field name="res_model">pagoflex.balance.adjustment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pagoflex_balance_adjustment" 
              name="Ajustes de Saldo" 
              parent="pagoflex_wallet_gateway.menu_pagoflex_wallet_gateway_operations" 
              action="action_pagoflex_balance_adjustment" 
              sequence="30"/>
</odoo>
