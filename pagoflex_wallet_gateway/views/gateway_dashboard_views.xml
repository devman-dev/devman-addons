<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_dashboard_form" model="ir.ui.view">
        <field name="name">pf.gateway.dashboard.form</field>
        <field name="model">pf.gateway.dashboard</field>
        <field name="arch" type="xml">
            <form create="true" edit="true" delete="false" class="pf_gateway_dashboard_form">
                <sheet>
                    <div class="pf_gateway_dashboard_header">
                        <div class="oe_title">
                            <h1>Centro de Control</h1>
                            <div class="text-muted">Monitoreo operativo, calidad de datos y comisiones del gateway.</div>
                        </div>
                        <div class="pf_gateway_dashboard_actions">
                            <group class="pf_gateway_dashboard_dates">
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                            <button name="action_refresh_dashboard" type="object" string="Actualizar" class="btn btn-primary" icon="fa-refresh"/>
                            <button name="action_open_period_transfers" type="object" string="Transferencias del período" class="btn btn-secondary" icon="fa-exchange"/>
                            <button name="action_open_sync_logs" type="object" string="Logs" class="btn btn-secondary" icon="fa-list"/>
                            <button name="action_open_dashboard_app_config" type="object" string="Configurar apps" class="btn btn-secondary" icon="fa-cog" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin"/>
                        </div>
                    </div>

                    <field name="global_summary_html" widget="html" nolabel="1" readonly="1"/>
                    <field name="wallet_summary_html" widget="html" nolabel="1" readonly="1"/>
                    <field name="charts_summary_html" widget="pf_realtime_charts" nolabel="1" readonly="1"/>
                    <field name="top_users_summary_html" widget="html" nolabel="1" readonly="1"/>
                    <field name="reconciliation_summary_html" widget="html" nolabel="1" readonly="1"/>
                    <!-- <field name="temporal_reconciliation_html" widget="html" nolabel="1" readonly="1"/> -->
                    <field name="transaction_count_summary_html" widget="html" nolabel="1" readonly="1"/>
                    <div class="pf_dashboard_bottom_grid">
                        <field name="sync_summary_html" widget="html" nolabel="1" readonly="1"/>
                        <div>
                            <field name="exceptions_summary_html" widget="html" nolabel="1" readonly="1"/>
                            <div class="pf_dashboard_exception_actions">
                                <button name="action_open_dashboard_app_config" type="object" string="Ver apps" class="btn btn-secondary" icon="fa-cog"/>
                                <button name="action_open_incomplete_transfers" type="object" string="Ver transferencias incompletas" class="btn btn-secondary" icon="fa-exchange"/>
                                <button name="action_open_balance_sync_exceptions" type="object" string="Ver cuentas sin saldo" class="btn btn-secondary" icon="fa-credit-card"/>
                                <button name="action_open_unverified_users" type="object" string="Ver usuarios sin KYC" class="btn btn-secondary" icon="fa-user"/>
                            </div>
                        </div>
                    </div>

                    <div class="pf_gateway_dashboard_note">
                        Los valores mostrados corresponden al período seleccionado. Las transferencias se imputan por fecha negocio; si falta, se usa la fecha de transacción como respaldo. Volumen entrante incluye únicamente ingresos externos completados.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pf_gateway_dashboard" model="ir.actions.act_window">
        <field name="name">Centro de Control</field>
        <field name="res_model">pf.gateway.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_pf_gateway_dashboard"
              name="Centro de Control"
              parent="menu_pagoflex_wallet_gateway_operations"
              action="action_pf_gateway_dashboard"
              sequence="5"
              groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_auditor"/>
</odoo>
