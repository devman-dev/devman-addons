<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_sync_job_tree" model="ir.ui.view">
        <field name="name">pf.gateway.sync.job.tree</field>
        <field name="model">pf.gateway.sync.job</field>
        <field name="arch" type="xml">
            <list>
                <button name="action_run_now" type="object" string="Ejecutar ahora" class="btn-primary" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="resource"/>
                <field name="sync_mode"/>
                <field name="active"/>
                <field name="last_run_at"/>
                <field name="last_status"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_sync_job_form" model="ir.ui.view">
        <field name="name">pf.gateway.sync.job.form</field>
        <field name="model">pf.gateway.sync.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_now" type="object" string="Ejecutar ahora" class="btn-primary" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="resource"/>
                            <field name="sync_mode"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="last_run_at" readonly="1"/>
                            <field name="last_status" readonly="1"/>
                            <field name="last_message" readonly="1"/>
                        </group>
                    </group>
                    <field name="log_ids" readonly="1">
                        <list>
                            <field name="create_date"/>
                            <field name="status"/>
                            <field name="records_processed"/>
                            <field name="message"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pf_gateway_sync_job_search" model="ir.ui.view">
        <field name="name">pf.gateway.sync.job.search</field>
        <field name="model">pf.gateway.sync.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="resource"/>
                <field name="sync_mode"/>
                <filter name="filter_active" string="Activo" domain="[('active', '=', True)]"/>
                <filter name="filter_failed" string="Fallido" domain="[('last_status', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="action_pf_gateway_sync_job" model="ir.actions.act_window">
        <field name="name">Trabajos de sincronización</field>
        <field name="res_model">pf.gateway.sync.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pf_gateway_sync_job" name="Trabajos de sincronización" parent="menu_pagoflex_wallet_gateway_config" action="action_pf_gateway_sync_job" sequence="20" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"/>
</odoo>
