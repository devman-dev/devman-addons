<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_company_membership_tree" model="ir.ui.view">
        <field name="name">pf.gateway.company.membership.tree</field>
        <field name="model">pf.gateway.company.membership</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="company_cuit"/>
                <field name="user_id"/>
                <field name="user_email"/>
                <field name="bank_account_id"/>
                <field name="bank_account_cvu_cbu"/>
                <field name="role"/>
                <field name="active"/>
                <field name="source_updated_at"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_company_membership_form" model="ir.ui.view">
        <field name="name">pf.gateway.company.membership.form</field>
        <field name="model">pf.gateway.company.membership</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_memberships" type="object" string="Sincronizar membresias" class="btn-primary" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="external_id" readonly="1"/>
                            <field name="company_id"/>
                            <field name="company_external_id" readonly="1"/>
                            <field name="company_name" readonly="1"/>
                            <field name="company_cuit" readonly="1"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="user_external_id" readonly="1"/>
                            <field name="user_email" readonly="1"/>
                            <field name="user_partner_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Cuenta bancaria">
                        <field name="bank_account_id"/>
                        <field name="bank_account_external_id" readonly="1"/>
                        <field name="bank_account_cvu_cbu" readonly="1"/>
                        <field name="role" readonly="1"/>
                    </group>
                    <group string="Sincronizacion">
                        <field name="source_created_at" readonly="1"/>
                        <field name="source_updated_at" readonly="1"/>
                        <field name="last_sync_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Payload crudo" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator">
                            <field name="raw_payload" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pf_gateway_company_membership_search" model="ir.ui.view">
        <field name="name">pf.gateway.company.membership.search</field>
        <field name="model">pf.gateway.company.membership</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="company_cuit"/>
                <field name="user_id"/>
                <field name="user_email"/>
                <field name="bank_account_id"/>
                <field name="bank_account_cvu_cbu"/>
                <field name="role"/>
                <filter name="filter_active" string="Activas" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactivas" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pf_gateway_company_membership" model="ir.actions.act_window">
        <field name="name">Membresias de empresas</field>
        <field name="res_model">pf.gateway.company.membership</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- <menuitem id="menu_pf_gateway_company_membership" name="Membresias" parent="menu_pagoflex_wallet_gateway_operations" action="action_pf_gateway_company_membership" sequence="16"/> -->
</odoo>
