<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_company_location_tree" model="ir.ui.view">
        <field name="name">pf.gateway.company.location.tree</field>
        <field name="model">pf.gateway.company.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="branch_code"/>
                <field name="bank_account_id"/>
                <field name="contact_name"/>
                <field name="contact_email"/>
                <field name="contact_phone"/>
                <field name="is_active"/>
                <field name="source_updated_at"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_company_location_form" model="ir.ui.view">
        <field name="name">pf.gateway.company.location.form</field>
        <field name="model">pf.gateway.company.location</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_sync_company_locations"
                        type="object"
                        string="Sincronizar locales"
                        class="btn-primary"
                        groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"
                    />
                    <button
                        name="action_create_subaccount"
                        type="object"
                        string="Crear/Asignar cuenta"
                        class="btn-secondary"
                        groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_id" readonly="1"/>
                            <field name="company_id"/>
                            <field name="branch_code"/>
                            <field name="bank_account_id"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="contact_name"/>
                            <field name="contact_email"/>
                            <field name="contact_phone"/>
                        </group>
                    </group>
                    <group string="Sincronización">
                        <field name="source_created_at" readonly="1"/>
                        <field name="source_updated_at" readonly="1"/>
                        <field name="last_sync_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Comisionistas">
                            <button
                                name="action_sync_location_commission_agents"
                                type="object"
                                string="Sincronizar comisionistas"
                                class="btn-secondary"
                                groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"
                            />
                            <field name="location_commission_agent_ids">
                                <list editable="bottom">
                                    <field name="external_id" readonly="1"/>
                                    <field name="user_id"/>
                                    <field name="bank_account_id"/>
                                    <field name="commission_percentage"/>
                                    <field name="is_active"/>
                                    <field name="source_updated_at" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payload crudo" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator">
                            <field name="raw_payload" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pf_gateway_company_location_search" model="ir.ui.view">
        <field name="name">pf.gateway.company.location.search</field>
        <field name="model">pf.gateway.company.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <field name="branch_code"/>
                <field name="contact_name"/>
                <field name="contact_email"/>
                <filter name="filter_active" string="Activo" domain="[('is_active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactivo" domain="[('is_active', '=', False)]"/>
                <separator/>
                <filter
                    name="group_by_company_id"
                    string="Empresa"
                    context="{'group_by': 'company_id'}"
                />
            </search>
        </field>
    </record>

    <record id="action_pf_gateway_company_location" model="ir.actions.act_window">
        <field name="name">Locales de empresa</field>
        <field name="res_model">pf.gateway.company.location</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_company_id': 1}</field>
    </record>

    <menuitem
        id="menu_pf_gateway_company_location"
        name="Locales de empresa"
        parent="menu_pagoflex_wallet_gateway_operations"
        action="action_pf_gateway_company_location"
        sequence="16"
    />
</odoo>
