<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_incoming_transfer_commission_account_tree" model="ir.ui.view">
        <field name="name">pf.gateway.incoming.transfer.commission.account.tree</field>
        <field name="model">pf.gateway.incoming.transfer.commission.account</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_sync_wizard" type="object" string="Sincronizar" class="btn-primary" display="always"/>
                </header>
                <field name="user_display_name" string="Usuario"/>
                <field name="cvu_cbu"/>
                <field name="commission_percentage"/>
                <field name="is_active"/>
                <field name="bank_account_external_id"/>
                <field name="updated_at"/>
                <field name="last_sync_at"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_incoming_transfer_commission_account_form" model="ir.ui.view">
        <field name="name">pf.gateway.incoming.transfer.commission.account.form</field>
        <field name="model">pf.gateway.incoming.transfer.commission.account</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_open_sync_wizard" type="object" string="Consultar/Sincronizar" class="btn-primary"/>
                    <button name="action_sync_this_cvu" type="object" string="Sincronizar este CVU" invisible="not cvu_cbu"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_id" readonly="1"/>
                            <field name="cvu_cbu" readonly="1"/>
                            <field name="commission_percentage"/>
                            <field name="is_active" readonly="1"/>
                        </group>
                        <group>
                            <field name="bank_account_external_id" readonly="1"/>
                            <field name="created_at" readonly="1"/>
                            <field name="updated_at" readonly="1"/>
                            <field name="last_sync_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload crudo">
                            <field name="raw_payload" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pf_gateway_incoming_transfer_commission_account_search" model="ir.ui.view">
        <field name="name">pf.gateway.incoming.transfer.commission.account.search</field>
        <field name="model">pf.gateway.incoming.transfer.commission.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="cvu_cbu"/>
                <field name="bank_account_external_id"/>
                <filter name="filter_active" string="Activas" domain="[('is_active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactivas" domain="[('is_active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pf_gateway_incoming_transfer_commission_account" model="ir.actions.act_window">
        <field name="name">Comisiones por usuario</field>
        <field name="res_model">pf.gateway.incoming.transfer.commission.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
