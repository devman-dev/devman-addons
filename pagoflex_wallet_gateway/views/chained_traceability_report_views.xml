<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_chained_traceability_report_wizard_form" model="ir.ui.view">
        <field name="name">pf.gateway.chained.traceability.report.wizard.form</field>
        <field name="model">pf.gateway.chained.traceability.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Trazabilidad de movimientos por CUIT">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        El reporte rastrea transferencias salientes encadenadas. Si no informa CUITs se procesarán todos.
                    </div>
                    <group>
                        <field name="cuit_text" placeholder="20-12345678-9, 30-12345678-1"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="operation_scope"/>
                        <field name="max_depth"/>
                        <field name="export_format"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_xlsx" type="object" string="Generar XLSX" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pf_gateway_chained_traceability_report_wizard" model="ir.actions.act_window">
        <field name="name">Trazabilidad por CUIT</field>
        <field name="res_model">pf.gateway.chained.traceability.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pf_gateway_chained_traceability_report"
              name="Trazabilidad por CUIT"
              parent="menu_pagoflex_wallet_gateway_reports"
              action="action_pf_gateway_chained_traceability_report_wizard"
              sequence="60"
              groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_auditor"/>

    <record id="view_pf_gateway_traceability_report_audit_list" model="ir.ui.view">
        <field name="name">pf.gateway.traceability.report.audit.list</field>
        <field name="model">pf.gateway.traceability.report.audit</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="requested_at"/>
                <field name="requested_by_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="operation_scope"/>
                <field name="all_cuits"/>
                <field name="max_depth"/>
                <field name="uuid"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_traceability_report_audit_form" model="ir.ui.view">
        <field name="name">pf.gateway.traceability.report.audit.form</field>
        <field name="model">pf.gateway.traceability.report.audit</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="uuid"/>
                        <field name="requested_at"/>
                        <field name="requested_by_id"/>
                        <field name="company_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="timezone"/>
                        <field name="operation_scope"/>
                        <field name="max_depth"/>
                        <field name="all_cuits"/>
                        <field name="cuit_json"/>
                        <field name="parameter_hash"/>
                        <field name="schema_version"/>
                    </group>
                    <field name="event_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="event_at"/>
                            <field name="event_type"/>
                            <field name="user_id"/>
                            <field name="row_count"/>
                            <field name="file_size"/>
                            <field name="file_hash"/>
                            <field name="message"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pf_gateway_traceability_report_audit" model="ir.actions.act_window">
        <field name="name">Auditoría de trazabilidad</field>
        <field name="res_model">pf.gateway.traceability.report.audit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pf_gateway_traceability_report_audit"
              name="Auditoría de trazabilidad"
              parent="menu_pagoflex_wallet_gateway_reports"
              action="action_pf_gateway_traceability_report_audit"
              sequence="61"
              groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_auditor"/>
</odoo>
