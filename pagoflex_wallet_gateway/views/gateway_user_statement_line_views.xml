<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_user_statement_line_list" model="ir.ui.view">
        <field name="name">pf.gateway.user.statement.line.list</field>
        <field name="model">pf.gateway.user.statement.line</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="transaction_at"/>
                <field name="user_id"/>
                <field name="bank_account_id"/>
                <field name="cvu_cbu"/>
                <field name="app"/>
                <field name="name"/>
                <field name="origin_id"/>
                <field name="payment_id" optional="hide"/>
                <field name="adjustment_id" optional="hide"/>
                <field name="movement_nature"/>
                <field name="status"/>
                <field name="direction"/>
                <field name="counterparty_user_id"/>
                <field name="counterparty_name" optional="hide"/>
                <field name="source_bank_account_id" optional="hide"/>
                <field name="destination_bank_account_id" optional="hide"/>
                <field name="amount" sum="Total nominal"/>
                <field name="signed_amount" sum="Neto"/>
                <field name="running_balance"/>
                <field name="currency"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_user_statement_line_form" model="ir.ui.view">
        <field name="name">pf.gateway.user.statement.line.form</field>
        <field name="model">pf.gateway.user.statement.line</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="transfer_id"/>
                            <field name="adjustment_id"/>
                            <field name="bank_account_id"/>
                            <field name="cvu_cbu"/>
                            <field name="app"/>
                            <field name="transaction_at"/>
                            <field name="name"/>
                            <field name="origin_id"/>
                            <field name="payment_id"/>
                        </group>
                        <group>
                            <field name="movement_nature"/>
                            <field name="status"/>
                            <field name="direction"/>
                            <field name="amount"/>
                            <field name="signed_amount"/>
                            <field name="running_balance"/>
                            <field name="currency"/>
                        </group>
                    </group>
                    <group>
                        <group string="Origen">
                            <field name="source_bank_account_id"/>
                        </group>
                        <group string="Destino">
                            <field name="destination_bank_account_id"/>
                        </group>
                        <group string="Contraparte">
                            <field name="counterparty_user_id"/>
                            <field name="counterparty_name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pf_gateway_user_statement_line_pivot" model="ir.ui.view">
        <field name="name">pf.gateway.user.statement.line.pivot</field>
        <field name="model">pf.gateway.user.statement.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="user_id" type="row"/>
                <field name="app" type="row"/>
                <field name="cvu_cbu" type="row"/>
                <field name="direction" type="col"/>
                <field name="signed_amount" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pf_gateway_user_statement_line_graph" model="ir.ui.view">
        <field name="name">pf.gateway.user.statement.line.graph</field>
        <field name="model">pf.gateway.user.statement.line</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="transaction_at" interval="month"/>
                <field name="signed_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_pf_gateway_user_statement_line" model="ir.actions.act_window">
        <field name="name">Resumen de cuenta por usuario</field>
        <field name="res_model">pf.gateway.user.statement.line</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
