<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_user_create_subaccount_wizard_form" model="ir.ui.view">
        <field name="name">pf.gateway.user.create.subaccount.wizard.form</field>
        <field name="model">pf.gateway.user.create.subaccount.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Nuevo CVU">
                <field name="created_bank_account_id" invisible="1"/>
                
                <div invisible="created_bank_account_id == False" class="alert alert-success text-center" role="alert">
                    ¡CVU creado exitosamente!
                </div>
                
                <group invisible="created_bank_account_id != False">
                    <field name="user_id" readonly="1"/>
                    <field name="app"/>
                </group>
                
                <group string="Detalle de CVUs Actuales" invisible="created_bank_account_id != False">
                    <field name="existing_cvus_summary" nolabel="1"/>
                </group>

                <group invisible="created_bank_account_id == False">
                    <field name="created_bank_account_id" readonly="1"/>
                </group>

                <footer>
                    <button string="Crear CVU" name="action_create_subaccount" type="object" class="btn-primary" invisible="created_bank_account_id != False"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pf_gateway_user_create_subaccount_wizard" model="ir.actions.act_window">
        <field name="name">Crear Nuevo CVU</field>
        <field name="res_model">pf.gateway.user.create.subaccount.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
