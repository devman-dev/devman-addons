<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_incoming_transfer_commission_settings_form" model="ir.ui.view">
        <field name="name">pf.gateway.incoming.transfer.commission.settings.form</field>
        <field name="model">pf.gateway.incoming.transfer.commission.settings</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_sync_from_gateway" string="Sincronizar desde gateway" type="object" class="btn-primary" />
                    <button name="action_open_push_wizard" string="Actualizar en gateway" type="object" />
                </header>
                <sheet>
                    <group>
                        <group string="Comisión aplicada por defecto">
                            <field name="app_name" />
                            <field name="default_percentage" />
                            <field name="settlement_cvu" />
                            <field name="is_active" />
                        </group>
                        <group string="Datos informativos del gateway">
                            <field name="gateway_setting_id" readonly="1" />
                            <field name="settlement_bank_account_id" readonly="1" />
                            <field name="created_at" readonly="1" />
                            <field name="updated_at" readonly="1" />
                            <field name="last_sync_at" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Reglas de distribución">
                            <field name="distribution_rule_ids" context="{'default_setting_id': id, 'default_app_name': app_name}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="destination_bank_account_id" domain="[('status', '=', 'active')]"/>
                                    <field name="user_display_name" string="Usuario"/>
                                    <!-- <field name="destination_cvu_cbu"/> -->
                                    <field name="commission_percentage"/>
                                    <field name="is_active"/>
                                    <!-- <field name="gateway_rule_id" readonly="1"/> -->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pf_gateway_incoming_transfer_commission_settings" model="ir.actions.act_window">
        <field name="name">Comisiones de transferencias entrantes</field>
        <field name="res_model">pf.gateway.incoming.transfer.commission.settings</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False" />
        <field name="res_id" eval="False" />
        <field name="target">current</field>
    </record>

    <menuitem id="menu_pagoflex_wallet_gateway_incoming_transfer_commission_settings" name="Comisión transferencias entrantes" parent="menu_pagoflex_wallet_gateway_config" action="action_pf_gateway_incoming_transfer_commission_settings" sequence="20" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin" />
</odoo>
