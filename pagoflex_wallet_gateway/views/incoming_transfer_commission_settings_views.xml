<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_incoming_transfer_commission_settings_form" model="ir.ui.view">
        <field name="name">pf.gateway.incoming.transfer.commission.settings.form</field>
        <field name="model">pf.gateway.incoming.transfer.commission.settings</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_sync_from_gateway" type="object" string="Sincronizar desde gateway" class="btn-primary"/>
                    <button name="action_push_to_gateway" type="object" string="Actualizar en gateway"/>
                </header>
                <sheet>
                    <group>
                        <group string="Comisión aplicada por defecto">
                            <field name="default_percentage"/>
                            <field name="settlement_cvu"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Datos informativos del gateway">
                            <field name="gateway_setting_id" readonly="1"/>
                            <field name="settlement_bank_account_id" readonly="1"/>
                            <field name="created_at" readonly="1"/>
                            <field name="updated_at" readonly="1"/>
                            <field name="last_sync_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pf_gateway_incoming_transfer_commission_settings" model="ir.actions.act_window">
        <field name="name">Comisión transferencias entrantes</field>
        <field name="res_model">pf.gateway.incoming.transfer.commission.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pf_gateway_incoming_transfer_commission_settings_form"/>
        <field name="res_id" ref="incoming_transfer_commission_settings_default"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_pagoflex_wallet_gateway_incoming_transfer_commission_settings"
              name="Comisión transferencias entrantes"
              parent="menu_pagoflex_wallet_gateway_config"
              action="action_pf_gateway_incoming_transfer_commission_settings"
              sequence="20"
              groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin"/>
</odoo>