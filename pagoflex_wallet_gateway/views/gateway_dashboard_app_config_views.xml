<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_dashboard_app_config_tree" model="ir.ui.view">
        <field name="name">pf.gateway.dashboard.app.config.tree</field>
        <field name="model">pf.gateway.dashboard.app.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="app_name"/>
                <field name="commission_bank_account_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_dashboard_app_config_form" model="ir.ui.view">
        <field name="name">pf.gateway.dashboard.app.config.form</field>
        <field name="model">pf.gateway.dashboard.app.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="app_name"/>
                        <field name="commission_bank_account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pf_gateway_dashboard_app_config_search" model="ir.ui.view">
        <field name="name">pf.gateway.dashboard.app.config.search</field>
        <field name="model">pf.gateway.dashboard.app.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="app_name"/>
                <field name="commission_bank_account_id"/>
                <filter name="filter_active" string="Activas" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_pf_gateway_dashboard_app_config" model="ir.actions.act_window">
        <field name="name">Configuración de billeteras</field>
        <field name="res_model">pf.gateway.dashboard.app.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <menuitem id="menu_pf_gateway_dashboard_app_config"
              name="Billeteras Centro de Control"
              parent="menu_pagoflex_wallet_gateway_config"
              action="action_pf_gateway_dashboard_app_config"
              sequence="15"
              groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin"/>
</odoo>
