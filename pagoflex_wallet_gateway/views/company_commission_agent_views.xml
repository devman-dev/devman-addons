<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_company_commission_agent_tree" model="ir.ui.view">
        <field name="name">pf.gateway.company.commission.agent.tree</field>
        <field name="model">pf.gateway.company.commission.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="company_partner_id"/>
                <field name="company_gateway_user_id"/>
                <field name="agent_partner_id"/>
                <field name="agent_code"/>
                <field name="percentage"/>
                <field name="company_total_percentage"/>
                <field name="max_percentage"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_company_commission_agent_form" model="ir.ui.view">
        <field name="name">pf.gateway.company.commission.agent.form</field>
        <field name="model">pf.gateway.company.commission.agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="company_partner_id"/>
                            <field name="company_gateway_user_id"/>
                            <field name="agent_partner_id"/>
                            <field name="agent_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="percentage"/>
                            <field name="company_total_percentage" readonly="1"/>
                            <field name="max_percentage" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pf_gateway_company_commission_agent_search" model="ir.ui.view">
        <field name="name">pf.gateway.company.commission.agent.search</field>
        <field name="model">pf.gateway.company.commission.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_gateway_user_id"/>
                <field name="company_partner_id"/>
                <field name="agent_partner_id"/>
                <field name="agent_code"/>
                <filter name="filter_active" string="Activos" domain="[('active', '=', True)]"/>
                <separator/>
                <filter name="group_company" string="Empresa" context="{'group_by': 'company_partner_id'}"/>
                <filter name="group_agent" string="Comisionista" context="{'group_by': 'agent_partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_pf_gateway_company_commission_agent" model="ir.actions.act_window">
        <field name="name">Comisionistas por empresa</field>
        <field name="res_model">pf.gateway.company.commission.agent</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

</odoo>
