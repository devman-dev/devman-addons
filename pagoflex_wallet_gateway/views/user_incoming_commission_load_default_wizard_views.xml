<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_user_incoming_commission_load_default_wizard_form" model="ir.ui.view">
        <field name="name">pf.gateway.user.incoming.commission.load.default.wizard.form</field>
        <field name="model">pf.gateway.user.incoming.commission.load.default.wizard</field>
        <field name="arch" type="xml">
            <form string="Cargar comision entrante por defecto">
                <group>
                    <field name="gateway_user_id"/>
                    <field name="app_name"/>
                </group>
                <footer>
                    <button name="action_load_defaults" type="object" string="Cargar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
