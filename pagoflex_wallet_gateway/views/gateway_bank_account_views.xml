<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_bank_account_tree" model="ir.ui.view">
        <field name="name">pf.gateway.bank.account.tree</field>
        <field name="model">pf.gateway.bank.account</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_refresh_balance_async" type="object" string="Actualizar saldo" class="btn-secondary" display="always" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"/>
                    <button name="action_open_bank_movement_sync_wizard" type="object" string="Consultar movimientos" class="btn-secondary" display="always" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"/>
                </header>
                <field name="name"/>
                <field name="gateway_user_id"/>
                <field name="cvu_cbu"/>
                <field name="alias"/>
                <field name="status"/>
                <field name="app"/>
                <field name="currency"/>
                <field name="balance"/>
                <field name="source_updated_at"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_bank_account_form" model="ir.ui.view">
        <field name="name">pf.gateway.bank.account.form</field>
        <field name="model">pf.gateway.bank.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_bank_accounts" type="object" string="Sincronizar cuentas" class="btn-primary" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"/>
                    <button name="action_open_bank_movement_sync_wizard" type="object" string="Consultar movimientos" class="btn-secondary" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_id" readonly="1"/>
                            <field name="origin_id" readonly="1"/>
                            <field name="gateway_user_id" readonly="1"/>
                            <field name="cvu_cbu" readonly="1"/>
                            <field name="alias" readonly="1"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="is_primary" readonly="1"/>
                            <field name="bdc_account_id" readonly="1"/>
                            <field name="app" readonly="1"/>
                            <field name="currency" readonly="1"/>
                            <field name="balance" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Metadatos" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator">
                            <field name="extra_metadata" widget="text"/>
                        </page>
                        <page string="Payload crudo" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator">
                            <field name="raw_payload" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pf_gateway_bank_account_search" model="ir.ui.view">
        <field name="name">pf.gateway.bank.account.search</field>
        <field name="model">pf.gateway.bank.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="cvu_cbu"/>
                <field name="alias"/>
                <field name="origin_id"/>
                <field name="bdc_account_id"/>
                <field name="gateway_user_id"/>
                <field name="app"/>
                <filter name="filter_primary" string="Principal" domain="[('is_primary', '=', True)]"/>
                <filter name="filter_balance_non_negative" string="Balance >= 0" domain="[('balance', '>=', 0)]"/>
                <filter name="filter_balance_negative" string="Balance &lt; 0" domain="[('balance', '&lt;', 0)]"/>
                <separator/>
                <filter name="group_by_app" string="Agrupar por App" context="{'group_by': 'app'}"/>
            </search>
        </field>
    </record>

    <record id="action_pf_gateway_bank_account" model="ir.actions.act_window">
        <field name="name">Cuentas Bancarias</field>
        <field name="res_model">pf.gateway.bank.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_app': 1}</field>
    </record>

    <menuitem id="menu_pf_gateway_bank_account" name="Cuentas bancarias" parent="menu_pagoflex_wallet_gateway_operations" action="action_pf_gateway_bank_account" sequence="20"/>
</odoo>
