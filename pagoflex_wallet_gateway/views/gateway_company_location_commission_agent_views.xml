<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_company_location_commission_agent_tree" model="ir.ui.view">
        <field name="name">pf.gateway.company.location.commission.agent.tree</field>
        <field name="model">pf.gateway.company.location.commission.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="location_id"/>
                <field name="user_id"/>
                <field name="bank_account_id"/>
                <field name="commission_percentage"/>
                <field name="is_active"/>
                <field name="source_updated_at"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_company_location_commission_agent_form" model="ir.ui.view">
        <field name="name">pf.gateway.company.location.commission.agent.form</field>
        <field name="model">pf.gateway.company.location.commission.agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="external_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="location_id"/>
                            <field name="user_id"/>
                            <field name="bank_account_id"/>
                        </group>
                        <group>
                            <field name="commission_percentage"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group string="Sincronización">
                        <field name="source_created_at" readonly="1"/>
                        <field name="source_updated_at" readonly="1"/>
                        <field name="last_sync_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Payload crudo" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator">
                            <field name="raw_payload" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pf_gateway_company_location_commission_agent_search" model="ir.ui.view">
        <field name="name">pf.gateway.company.location.commission.agent.search</field>
        <field name="model">pf.gateway.company.location.commission.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="location_id"/>
                <field name="company_id"/>
                <field name="user_id"/>
                <filter name="filter_active" string="Activo" domain="[('is_active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactivo" domain="[('is_active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pf_gateway_company_location_commission_agent" model="ir.actions.act_window">
        <field name="name">Comisionistas de locales</field>
        <field name="res_model">pf.gateway.company.location.commission.agent</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- <menuitem
        id="menu_pf_gateway_company_location_commission_agent"
        name="Comisionistas de locales"
        parent="menu_pagoflex_wallet_gateway_operations"
        action="action_pf_gateway_company_location_commission_agent"
        sequence="17"
    /> -->
</odoo>
