<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_gateway_company_tree" model="ir.ui.view">
        <field name="name">pf.gateway.company.tree</field>
        <field name="model">pf.gateway.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="cuit"/>
                <field name="contact_name"/>
                <field name="contact_email"/>
                <field name="contact_phone"/>
                <field name="created_by_user_id"/>
                <field name="primary_bank_account_id"/>
                <field name="active"/>
                <field name="source_updated_at"/>
            </list>
        </field>
    </record>

    <record id="view_pf_gateway_company_form" model="ir.ui.view">
        <field name="name">pf.gateway.company.form</field>
        <field name="model">pf.gateway.company</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_companies" type="object" string="Sincronizar empresas" class="btn-primary" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_id" readonly="1"/>
                            <field name="cuit"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="contact_name"/>
                            <field name="contact_email"/>
                            <field name="contact_phone"/>
                        </group>
                    </group>
                    <group string="Relaciones gateway">
                        <field name="created_by_user_id"/>
                        <field name="primary_bank_account_id"/>
                    </group>
                    <group string="Sincronización">
                        <field name="source_created_at" readonly="1"/>
                        <field name="source_updated_at" readonly="1"/>
                        <field name="last_sync_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Membresias">
                            <field name="company_membership_ids" readonly="1">
                                <list>
                                    <field name="user_id"/>
                                    <field name="user_email"/>
                                    <field name="bank_account_id"/>
                                    <field name="bank_account_cvu_cbu"/>
                                    <field name="role"/>
                                    <field name="active"/>
                                    <field name="source_updated_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comisionistas">
                            <button
                                name="action_sync_company_commission_agents"
                                type="object"
                                string="Sincronizar comisionistas"
                                class="btn-secondary"
                                groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator"
                            />
                            <field name="company_commission_gateway_agent_ids">
                                <list editable="bottom">
                                    <field name="external_id" readonly="1"/>
                                    <field name="user_id"/>
                                    <field name="company_app_name" column_invisible="1"/>
                                    <field name="bank_account_id" domain="[('gateway_user_id', '=', user_id)] + ([('app', '=', company_app_name)] if company_app_name else [])"/>
                                    <field name="commission_percentage"/>
                                    <field name="is_active"/>
                                    <field name="source_updated_at" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Usuarios vinculados">
                            <field name="child_gateway_user_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="cuit_cuil"/>
                                    <field name="cuit_owner"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payload crudo" groups="pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin,pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator">
                            <field name="raw_payload" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pf_gateway_company_search" model="ir.ui.view">
        <field name="name">pf.gateway.company.search</field>
        <field name="model">pf.gateway.company</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="cuit"/>
                <field name="contact_name"/>
                <field name="contact_email"/>
                <filter name="filter_active" string="Activo" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactivo" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pf_gateway_company" model="ir.actions.act_window">
        <field name="name">Empresas</field>
        <field name="res_model">pf.gateway.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pf_gateway_company" name="Empresas" parent="menu_pagoflex_wallet_gateway_operations" action="action_pf_gateway_company" sequence="15"/>
</odoo>
