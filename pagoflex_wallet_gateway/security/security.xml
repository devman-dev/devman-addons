<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pagoflex_wallet_gateway_categ" model="ir.module.category">
        <field name="name">PagoFlex Wallet Gateway</field>
        <field name="description">Nivel de acceso para el módulo PagoFlex Wallet Gateway</field>
        <field name="sequence">50</field>
    </record>

    <record id="pagoflex_wallet_gateway_privilege" model="res.groups.privilege">
        <field name="name">PagoFlex Wallet Gateway</field>
        <field name="description">Privilegios de acceso para el módulo PagoFlex Wallet Gateway</field>
        <field name="category_id" ref="pagoflex_wallet_gateway.pagoflex_wallet_gateway_categ"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_pagoflex_wallet_gateway_operator" model="res.groups">
        <field name="name">PagoFlex Wallet Gateway Operador</field>
        <field name="privilege_id" ref="pagoflex_wallet_gateway.pagoflex_wallet_gateway_privilege"/>
    </record>

    <record id="group_pagoflex_wallet_gateway_auditor" model="res.groups">
        <field name="name">PagoFlex Wallet Gateway Auditor</field>
        <field name="privilege_id" ref="pagoflex_wallet_gateway.pagoflex_wallet_gateway_privilege"/>
    </record>

    <record id="group_pagoflex_wallet_gateway_admin" model="res.groups">
        <field name="name">PagoFlex Wallet Gateway Administrador</field>
        <field name="privilege_id" ref="pagoflex_wallet_gateway.pagoflex_wallet_gateway_privilege"/>
        <field name="implied_ids" eval="[(4, ref('pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_operator')), (4, ref('pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_auditor'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('pagoflex_wallet_gateway.group_pagoflex_wallet_gateway_admin'))]"/>
    </record>
</odoo>
