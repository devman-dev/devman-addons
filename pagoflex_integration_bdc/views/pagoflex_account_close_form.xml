<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pagoflex_account_close_form" model="ir.ui.view">
        <field name="name">pagoflex.account.close.form</field>
        <field name="model">pagoflex.account.close</field>
        <field name="arch" type="xml">
            <form string="Solicitud de cierre de cuenta">
                <group>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="app"/>
                    <field name="reason"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_pagoflex_account_close" model="ir.actions.act_window">
        <field name="name">Solicitar cierre de cuenta</field>
        <field name="res_model">pagoflex.account.close</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pagoflex_account_close_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pagoflex_account_close_root" name="Pagoflex/Sivep" sequence="10"/>
    <menuitem id="menu_pagoflex_account_close" name="Solicitar cierre de cuenta" parent="menu_pagoflex_account_close_root" action="action_pagoflex_account_close" sequence="20"/>
</odoo>
