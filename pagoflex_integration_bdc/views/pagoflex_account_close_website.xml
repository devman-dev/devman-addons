<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="account_close_form" name="Formulario Cierre de Cuenta">
        <h2>Solicitud de cierre de cuenta</h2>
        <t t-if="error">
            <div style="color: red;">
                <t t-out="error"/>
            </div>
        </t>
        <form method="post" action="/account_close">
            <label for="name">Nombre:</label>
            <input type="text" name="name" id="name" required="required" maxlength="60"/><br/>
            <label for="email">Email:</label>
            <input type="email" name="email" id="email" required="required" maxlength="80"/><br/>
            <label for="app">App:</label>
            <select name="app" id="app" required="required">
                <option value="sivep">Sivep</option>
                <option value="pagoflex">Pagoflex</option>
            </select><br/>
            <label for="reason">Motivo:</label>
            <textarea name="reason" id="reason" required="required" minlength="10" maxlength="300"></textarea><br/>
            <button type="submit">Enviar solicitud</button>
        </form>
    </template>

    <template id="account_close_success" name="Solicitud enviada">
        <h2>Solicitud enviada</h2>
        <div style="color: green;">¡Solicitud registrada correctamente!</div>
    </template>
</odoo>
