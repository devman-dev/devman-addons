<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario heredada -->
    <record id="view_maintenance_request_form_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <!-- Agregar el campo después del campo Tipo de mantenimiento (Correctivo/Preventivo) -->
            <field name="maintenance_type" position="after">
                <field name="tipo_mant" string="Tipo"/>
            </field>
        </field>
    </record>

    <!-- Vista de lista/tree heredada -->
    <record id="view_maintenance_request_tree_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.tree.inherit</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="tipo_mant" string="Tipo"/>
            </field>
        </field>
    </record>
</odoo>








