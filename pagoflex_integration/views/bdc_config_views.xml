<odoo>
  <data>
    <record id="res_config_settings_view_form_bdc" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.bdc</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="base.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[hasclass('settings')]" position="inside">
          <div class="app_settings_block" data-string="BDC Conecta" string="BDC Conecta">
            <h2>BDC Conecta</h2>
            <div class="row mt16 o_settings_container">
              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="bdc_base_url"/>
                  <div class="text-muted">Base URL for Sandbox/Production (provided by BDC Conecta).</div>
                  <field name="bdc_base_url" placeholder="https://..."/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="bdc_auth_type"/>
                  <div class="text-muted">Authentication strategy used by the API.</div>
                  <field name="bdc_auth_type"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="bdc_token_url"/>
                  <div class="text-muted">Optional: override token URL.</div>
                  <field name="bdc_token_url" placeholder="/auth/token or full URL"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="bdc_client_id"/>
                  <div class="text-muted">Client ID (Sandbox/Prod).</div>
                  <field name="bdc_client_id"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="bdc_client_secret"/>
                  <div class="text-muted">Stored as system parameter (bdc_conecta.client_secret).</div>
                  <field name="bdc_client_secret" password="True"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="bdc_token_param_key"/>
                  <div class="text-muted">System parameter keys for token storage.</div>
                  <field name="bdc_token_param_key"/>
                  <field name="bdc_token_expiry_param_key"/>
                </div>
              </div>
            </div>
          </div>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
