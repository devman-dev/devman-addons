<odoo>
  <data>
    <record id="view_bdc_log_tree" model="ir.ui.view">
      <field name="name">bdc.request.log.tree</field>
      <field name="model">bdc.request.log</field>
      <field name="arch" type="xml">
        <tree>
          <field name="create_date"/>
          <field name="endpoint_code"/>
          <field name="method"/>
          <field name="url"/>
          <field name="status_code"/>
          <field name="duration_ms"/>
          <field name="company_id" groups="base.group_multi_company"/>
        </tree>
      </field>
    </record>

    <record id="view_bdc_log_form" model="ir.ui.view">
      <field name="name">bdc.request.log.form</field>
      <field name="model">bdc.request.log</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="create_date" readonly="1"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                <field name="endpoint_id" readonly="1"/>
                <field name="endpoint_code" readonly="1"/>
              </group>
              <group>
                <field name="method" readonly="1"/>
                <field name="url" readonly="1"/>
                <field name="status_code" readonly="1"/>
                <field name="duration_ms" readonly="1"/>
              </group>
            </group>
            <notebook>
              <page string="Request">
                <group>
                  <field name="request_headers" readonly="1" widget="text"/>
                  <field name="request_params" readonly="1" widget="text"/>
                  <field name="request_body" readonly="1" widget="text"/>
                </group>
              </page>
              <page string="Response">
                <group>
                  <field name="response_headers" readonly="1" widget="text"/>
                  <field name="response_body" readonly="1" widget="text"/>
                </group>
              </page>
              <page string="Error">
                <field name="error" readonly="1" widget="text"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
