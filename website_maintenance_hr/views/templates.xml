<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Página principal del formulario de mantenimiento -->
        <template id="maintenance_page" name="Maintenance Request">
            <t t-call="website.layout">
                <div class="container">
                    <title>Maintenance</title>
                    <form t-attf-action="/submit" method="post"
                        data-success_page="/maintenance_request-thanks"
                        enctype="multipart/form-data">

                        <div class="form-group form-field o_website_form_required_custom">
                            <br />
                            <br />
                            <p>
                                <h2>&amp;nbsp; <b>Maintenance Request</b></h2>
                            </p>
                            <br />
                        </div>

                        <!-- Subject -->
                        <div class="form-group">
                            <label class="col-md-3 col-sm-4 control-label" for="subject">Subject</label>
                            <div class="col-lg-7 col-md-8">
                                <input type="text" class="form-control o_website_form_input"
                                    name="subject" required="" />
                            </div>
                        </div>
                        <br />

                        <!-- Company Selection -->
                        <div class="form-group form-field o_website_form_required_custom">
                            <label class="col-md-3 col-sm-4 control-label" for="company_id">Company</label>
                            <div class="col-lg-7 col-md-8">
                                <t t-if="len(company_list) &lt;= 1">
                                    <input type="hidden" name="company_id"
                                        t-att-value="company_list[0]['id'] if company_list else ''" />
                                    <span class="form-control-plaintext">
                                        <t
                                            t-esc="company_list[0]['name'] if company_list else 'No Company'" />
                                    </span>
                                </t>
                                <t t-else="">
                                    <select class="form-control o_website_form_input"
                                        id="company_id"
                                        name="company_id" required="">
                                        <option value="">Select Company</option>
                                        <t t-foreach="company_list" t-as="company">
                                            <option t-att-value="company['id']">
                                                <t t-esc="company['name']" />
                                            </option>
                                        </t>
                                    </select>
                                </t>
                            </div>
                        </div>
                        <br />

                        <!-- Team Selection -->
                        <div class="form-group form-field o_website_form_required_custom">
                            <label class="col-md-3 col-sm-4 control-label" for="team_id">Team</label>
                            <div class="col-lg-7 col-md-8">
                                <select class="form-control o_website_form_input" id="team_id"
                                    name="teams" required="">
                                    <option value="">Select Team</option>
                                    <t t-foreach="team_selection" t-as="team">
                                        <option t-att-value="team['id']">
                                            <t t-esc="team['name']" />
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>
                        <br />

                        <!-- Equipment Selection -->
                        <div class="form-group form-field o_website_form_required_custom">
                            <label class="col-md-3 col-sm-4 control-label" for="equipment">Equipment</label>
                            <div class="col-lg-7 col-md-8">
                                <select class="form-control o_website_form_input" id="equipment"
                                    name="equipment" required="">
                                    <option value="">Select Equipment</option>
                                    <t t-foreach="equipment_selection" t-as="equipment">
                                        <option t-att-value="equipment['id']">
                                            <t t-esc="equipment['name']" />
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>
                        <br />

                        <!-- Priority Selection -->
                        <div class="form-group form-field o_website_form_required_custom">
                            <label class="col-md-3 col-sm-4 control-label" for="priority_id">
                                Priority</label>
                            <div class="col-lg-7 col-md-8">
                                <select class="form-control o_website_form_input" id="priority_id"
                                    name="stars" required="">
                                    <option value="">Select Priority</option>
                                    <option value="0">Very Low</option>
                                    <option value="1">Low</option>
                                    <option value="2" selected="selected">Normal</option>
                                    <option value="3">High</option>
                                </select>
                            </div>
                        </div>
                        <br />

                        <!-- Details -->
                        <div class="form-group form-field o_website_form_required_custom">
                            <label class="col-md-3 col-sm-4 control-label" for="details">Details</label>
                            <div class="col-md-7 col-sm-8">
                                <textarea class="form-control" rows="5" name="details" required=""></textarea>
                            </div>
                        </div>
                        <br />

                        <!-- File Attachment -->
                        <div class="form-group form-field">
                            <label class="col-md-3 col-sm-4 control-label" for="attached_file">Attach
                                File</label>
                            <div class="col-md-7 col-sm-8">
                                <input type="file" name="attached_file" class="form-control"
                                    multiple="multiple" />
                            </div>
                        </div>
                        <br />

                        <!-- Submit Button -->
                        <div class="form-group form-field">
                            <div class="col-md-offset-3 col-sm-offset-4 col-sm-8 col-md-7">
                                <button type="submit"
                                    class="btn btn-primary btn-lg o_website_form_send">Submit</button>
                                <span id="o_website_form_result"></span>
                            </div>
                        </div>
                        <br />
                        <br />
                        <br />
                    </form>
                </div>
            </t>
        </template>

        <!-- Página de agradecimiento -->
        <record id="thanks" model="website.page">
            <field name="name">Thanks</field>
            <field name="type">qweb</field>
            <field name="url">/maintenance_request-thanks</field>
            <field name="website_published">True</field>
            <field name="arch" type="xml">
                <t name="Thanks" t-name="maintenance_request.thanks">
                    <t t-call="website.layout">
                        <div id="wrap">
                            <div class="oe_structure" />
                            <div class="container">
                                <h1>Thank You</h1>
                                <div class="row">
                                    <div class="col-lg-8">
                                        <div class="alert alert-success" role="status"> Your
                                            maintenance request has been submitted successfully. <button
                                                type="button" class="close" data-dismiss="alert">
                                            &amp;times;
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <!-- <t t-call="website.company_description" /> -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </field>
        </record>

        <!-- Página de usuario no encontrado -->
        <record id="nouser" model="website.page">
            <field name="name">No User</field>
            <field name="type">qweb</field>
            <field name="url">/maintenance_request-nouser</field>
            <field name="website_published">True</field>
            <field name="arch" type="xml">
                <t name="No User Found" t-name="maintenance_request.nouser">
                    <t t-call="website.layout">
                        <div id="wrap">
                            <div class="oe_structure" />
                            <div class="container">
                                <h1>We're Sorry.!</h1>
                                <div class="row">
                                    <div class="col-lg-8">
                                        <div class="alert alert-warning" role="status"> You cannot
                                            send maintenance request to us since you are not a
                                            registered employee. <button type="button" class="close"
                                                data-dismiss="alert">
                                                &amp;times;
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <!-- <t t-call="website.company_description" /> -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </field>
        </record>
    </data>
</odoo>