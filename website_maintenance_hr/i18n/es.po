#. module: website_maintenance_hr
#: model:mail.template,subject:website_maintenance_hr.mail_template_maintenance_request
msgid ""
"\n"
"                Maintenance of ${object.equipment_id.name if object.equipment_id and\n"
"                object.equipment_id.name else 'equipment (unspecified)'}\n"
"            "
msgstr ""
"\n"
"                Mantenimiento de ${object.equipment_id.name if object.equipment_id and\n"
"                object.equipment_id.name else 'equipo (sin especificar)'}\n"
"            "

#. module: website_maintenance_hr
#: model_terms:ir.ui.view,arch_db:website_maintenance_hr.maintenance_page
