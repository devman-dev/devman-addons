<odoo>
    <data noupdate="1">
        <!-- Define the Scheduled Action (Cron Job) -->
        <record id="cron_deadline_mail" model="ir.cron">
            <field name="name">Task Deadline Notification</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">model.send_deadline_notifications()</field>
            <field name="interval_number">1</field>  <!-- Run every 1 day -->
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
