<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- Categorías de Juego -->
        <!-- ============================================================ -->
        <record id="cat_apostas_esportivas" model="club.support.game.category">
            <field name="name">Apostas Esportivas</field>
            <field name="code">SPORTS</field>
            <field name="description">Aposte nos seus times e ligas favoritas. Futebol, basquete, vôlei e muito mais.</field>
            <field name="icon">fa-futbol-o</field>
            <field name="color">#1B5E20</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
            <field name="commission_description">Parte do valor apostado é destinado ao clube que você escolher apoiar.</field>
            <field name="require_selection" eval="True"/>
        </record>

        <record id="cat_cassino_online" model="club.support.game.category">
            <field name="name">Cassino Online</field>
            <field name="code">CASINO</field>
            <field name="description">Roleta, blackjack, poker e centenas de jogos de cassino ao vivo.</field>
            <field name="icon">fa-diamond</field>
            <field name="color">#B71C1C</field>
            <field name="sequence">20</field>
            <field name="active" eval="True"/>
            <field name="commission_description">Uma porcentagem das apostas no cassino é revertida ao clube apoiado.</field>
            <field name="require_selection" eval="True"/>
        </record>

        <record id="cat_bingo_instantaneos" model="club.support.game.category">
            <field name="name">Bingo &amp; Instantâneos</field>
            <field name="code">BINGO</field>
            <field name="description">Bingo online, raspadinhas virtuais e jogos instantâneos.</field>
            <field name="icon">fa-star</field>
            <field name="color">#E65100</field>
            <field name="sequence">30</field>
            <field name="active" eval="True"/>
            <field name="commission_description">Nos jogos instantâneos, o clube recebe uma comissão por cada rodada.</field>
            <field name="require_selection" eval="False"/>
        </record>


    </data>
</odoo>
