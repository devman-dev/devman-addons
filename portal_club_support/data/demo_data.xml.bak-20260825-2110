            <field name="primary_color">#004F9F</field>
            <field name="secondary_color">#E50B17</field>
            <field name="sequence">120</field>
            <field name="active" eval="True"/>
                    </record>

        <!-- ============================================================ -->
        <!-- Relacionar clubes con categorías -->
        <!-- ============================================================ -->
        <function model="club.support.game.category" name="write">
            <value eval="[ref('cat_apostas_esportivas')]"/>
            <value eval="{
                'club_ids': [(6, 0, [
                    ref('club_flamengo'), ref('club_palmeiras'),
                    ref('club_corinthians'), ref('club_sao_paulo')
                ])]
            }"/>
        </function>

        <function model="club.support.game.category" name="write">
            <value eval="[ref('cat_cassino_online')]"/>
            <value eval="{
                'club_ids': [(6, 0, [
                    ref('club_vasco'), ref('club_gremio'),
                    ref('club_internacional'), ref('club_cruzeiro')
                ])]
            }"/>
        </function>

        <function model="club.support.game.category" name="write">
            <value eval="[ref('cat_bingo_instantaneos')]"/>
            <value eval="{
                'club_ids': [(6, 0, [
                    ref('club_atletico_mineiro'), ref('club_botafogo'),
                    ref('club_bahia'), ref('club_fortaleza')
                ])]
            }"/>
        </function>

    </data>
</odoo>
