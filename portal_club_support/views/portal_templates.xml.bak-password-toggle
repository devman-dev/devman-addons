<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- ============================================================
         LOGIN OVERRIDE — cambiar link "Não tem uma conta?"
         ============================================================ -->
    <template id="jj_login_override"
              inherit_id="auth_signup.login"
              name="JogaJunto Login">
        <!-- ODOO18_PORTAL_FIX: Odoo 18 uses t-attf-href on this link. -->
        <xpath expr="//a[@t-if='signup_enabled']" position="attributes">
            <attribute name="t-attf-href">/club-support/register</attribute>
        </xpath>
    </template>

    <!-- ============================================================
         REGISTER PAGE — público, Step 1 "Seus dados"
         ============================================================ -->
    <template id="jj_register_page"
              name="JogaJunto — Cadastro">
        <t t-call="portal_club_support.jj_register_layout">
            <t t-set="step" t-value="1"/>

            <div class="jj-step-label-top">PASSO 1 DE 3</div>
            <h1 class="jj-heading">Vamos começar</h1>
            <p class="jj-subheading">Crie seu perfil para personalizar sua experiência.</p>

            <form method="POST" action="/club-support/register" id="jj_register_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="jj-form-row">
                    <div class="jj-field">
                        <label for="jj_name">Nome completo</label>
                        <input type="text" id="jj_name" name="name"
                               placeholder="Seu nome completo"
                               required="required"
                               t-att-value="name or ''"/>
                    </div>
                    <div class="jj-field">
                        <label for="jj_cpf">CPF</label>
                        <input type="text" id="jj_cpf" name="cpf"
                               placeholder="000.000.000-00"
                               t-att-value="cpf or ''"/>
                    </div>
                </div>

                <div class="jj-form-row">
                    <div class="jj-field">
                        <label for="jj_birth_date">Data de nascimento</label>
                        <div class="jj-input-icon">
                            <input type="date" id="jj_birth_date" name="birth_date"
                                   placeholder="dd/mm/aaaa"
                                   t-att-value="birth_date or ''"/>
                            <svg class="jj-icon-cal" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </div>
                    </div>
                    <div class="jj-field">
                        <label for="jj_address" class="jj-label-row">Endereço <span class="jj-info-btn" onclick="event.stopPropagation();var t=this.querySelector('.jj-info-tip');t.classList.toggle('show')"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="#20B967" stroke-width="1.3"/><path d="M7 6.2v3.8M7 4.5v.01" stroke="#20B967" stroke-width="1.3" stroke-linecap="round"/></svg><span class="jj-info-tip">Preencha no formato: <strong>Rua, número, cidade, país</strong></span></span></label>
                        <input type="text" id="jj_address" name="address"
                               placeholder="Digite seu endereço"
                               t-att-value="address or ''" autocomplete="off"/>
                    </div>
                </div>

                <div class="jj-cin-row">
                    <div class="jj-field">
                        <label>Frente do CIN</label>
                        <div class="jj-file-upload-wrap">
                            <input type="file" id="jj_frente_cartao" name="frente_cartao" accept="image/*,.pdf" class="jj-file-input"/>
                            <label for="jj_frente_cartao" class="jj-file-label">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                <span class="jj-file-placeholder">Selecionar arquivo</span>
                            </label>
                        </div>
                    </div>
                    <div class="jj-field">
                        <label>Verso do CIN</label>
                        <div class="jj-file-upload-wrap">
                            <input type="file" id="jj_verso_cartao" name="verso_cartao" accept="image/*,.pdf" class="jj-file-input"/>
                            <label for="jj_verso_cartao" class="jj-file-label">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                <span class="jj-file-placeholder">Selecionar arquivo</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="jj-form-row">
                    <div class="jj-field">
                        <label for="jj_email">E-mail</label>
                        <input type="email" id="jj_email" name="email"
                               placeholder="voce@email.com"
                               required="required"
                               t-att-value="email or ''"/>
                    </div>
                    <div class="jj-field">
                        <label for="jj_confirm_email">Confirme seu E-mail</label>
                        <input type="email" id="jj_confirm_email" name="confirm_email"
                               placeholder="voce@email.com"
                               required="required"/>
                    </div>
                </div>

                <div class="jj-form-row">
                    <div class="jj-field">
                        <label for="jj_password">Senha</label>
                        <input type="password" id="jj_password" name="password"
                               placeholder="Minimo 6 caracteres"
                               required="required"
                               minlength="6"/>
                    </div>
                    <div class="jj-field">
                        <label for="jj_confirm_password">Confirme sua senha</label>
                        <input type="password" id="jj_confirm_password" name="confirm_password"
                               placeholder="Repita a senha"
                               required="required"
                               minlength="6"/>
                    </div>
                </div>

                <div class="jj-checkbox-wrap">
                    <input type="checkbox" id="jj_age_terms" name="age_confirmed"
                           required="required"/>
                    <label for="jj_age_terms">
                        Confirmo que tenho mais de 18 anos e aceito os
                        <a href="/terms" target="_blank">Termos de Uso</a> e a
                        <a href="/privacy" target="_blank">Politica de Privacidade</a>.
                    </label>
                </div>

                <t t-if="error">
                    <div style="color: #ef4444; font-size: 13px; margin-bottom: 16px; padding: 8px 12px; background: #fef2f2; border-radius: 8px;">
                        <t t-esc="error"/>
                    </div>
                </t>

                <div class="jj-form-actions end">
                    <button type="submit" class="jj-btn jj-btn-primary">
                        Continuar
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                </div>
            </form>

            <p class="jj-login-link">
                Ja tem uma conta? <a href="/web/login">Fazer login</a>
            </p>
        </t>
    </template>

    <!-- ============================================================
         CLUBS PAGE — auth="user", Step 2 "Seus clubes"
         ============================================================ -->
    <template id="jj_clubs_page"
              name="JogaJunto — Seus Clubes">
        <t t-call="portal_club_support.jj_register_layout">
            <t t-set="step" t-value="2"/>

            <div class="jj-step-label-top">PASSO 2 DE 3</div>
            <h1 class="jj-heading">Escolha sua torcida</h1>
            <p class="jj-subheading">Selecione um clube em cada modalidade. Você pode mudar quando quiser.</p>

            <form method="POST" action="/my/club-support/save" id="jj_clubs_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="redirect_to" value="done"/>

                <t t-foreach="categories" t-as="cat">
                    <div class="jj-modality-card"
                         t-att-data-required="'1' if cat.require_selection else '0'">
                        <div class="jj-modality-header">
                            <div class="jj-modality-icon" t-attf-style="background: {{cat.color or '#0f3d2a'}}1a; color: {{cat.color or '#0f3d2a'}}">
                                <!-- PROTOTYPE_UI_MATCH: render the configured
                                     FontAwesome class instead of its text. -->
                                <i t-att-class="'fa ' + (cat.icon or 'fa-star')"/>
                            </div>
                            <div class="jj-modality-info">
                                <h4 t-esc="cat.name"/>
                                <p t-esc="cat.description or ''"/>
                            </div>
                        </div>
                        <div class="jj-modality-body">
                            <!-- FEDERATION_CLUB_PICKER: searchable catalogue
                                 grouped by Brazilian football federation. -->
                            <t t-set="current_pref" t-value="prefs_by_category.get(cat.id)"/>
                            <t t-set="current_club" t-value="current_pref.casino_club_id if current_pref else False"/>
                            <div class="jj-club-picker">
                                <input type="hidden" class="jj-club-value"
                                       t-att-name="'club_' + str(cat.id)"
                                       t-att-value="current_club.id if current_club else ''"/>
                                <div class="jj-club-search-wrap">
                                    <i class="fa fa-search jj-club-search-icon"/>
                                    <input type="text" class="jj-club-search"
                                           autocomplete="off"
                                           placeholder="Buscar seu clube..."
                                           t-att-value="current_club.name if current_club else ''"/>
                                    <button type="button" class="jj-club-clear"
                                            aria-label="Limpar seleção">×</button>
                                </div>
                                <div class="jj-club-dropdown">
                                    <t t-foreach="federations" t-as="fed">
                                        <t t-set="active_clubs" t-value="fed.club_ids.filtered(lambda c: c.active).sorted(key=lambda c: (c.sequence, c.name))"/>
                                        <div class="jj-club-group" t-if="active_clubs">
                                            <div class="jj-club-group-title" t-esc="fed.name"/>
                                            <t t-foreach="active_clubs" t-as="club">
                                                <button type="button" class="jj-club-option"
                                                        t-att-data-id="club.id"
                                                        t-att-data-name="club.name"
                                                        t-att-data-search="(club.name + ' ' + (club.short_name or '') + ' ' + fed.name).lower()">
                                                    <span class="jj-club-option-badge"
                                                          t-attf-style="background: {{club.primary_color or '#073b2a'}}">
                                                        <img t-if="club.logo"
                                                             t-att-src="'data:image/png;base64,' + club.logo.decode()"
                                                             style="width:100%;height:100%;object-fit:cover;border-radius:50%"/>
                                                        <t t-else="" t-esc="club.short_name or club.name[:2].upper()"/>
                                                    </span>
                                                    <span class="jj-club-option-copy">
                                                        <strong t-esc="club.name"/>
                                                        <small t-esc="club.short_name or fed.name"/>
                                                    </span>
                                                    <i class="fa fa-check jj-club-option-check"/>
                                                </button>
                                            </t>
                                        </div>
                                    </t>
                                    <div class="jj-club-empty">Nenhum clube encontrado.</div>
                                </div>
                            </div>
                            <t t-if="cat.require_selection">
                                <p style="font-size: 11px; color: #6b7280; margin: 8px 0 0;">
                                    ⚠ Seleção obrigatória nesta categoria.
                                </p>
                            </t>
                        </div>
                    </div>
                </t>

                <t t-if="not categories">
                    <div style="text-align: center; padding: 40px; color: #6b7280;">
                        <p>Nenhuma categoria disponível no momento.</p>
                        <a href="/my/club-support" class="jj-btn jj-btn-outline" style="margin-top: 12px; display: inline-flex;">
                            Ir para minha conta
                        </a>
                    </div>
                </t>

                <t t-if="error">
                    <div style="color: #ef4444; font-size: 13px; margin: 16px 0; padding: 8px 12px; background: #fef2f2; border-radius: 8px;">
                        <t t-esc="error"/>
                    </div>
                </t>

                <div class="jj-form-actions" t-if="categories">
                    <a href="/my/club-support" class="jj-btn jj-btn-outline">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
                        Voltar
                    </a>
                    <button type="submit" class="jj-btn jj-btn-primary" id="jj_clubs_submit">
                        Confirmar escolhas
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                </div>
            </form>
        </t>
    </template>

    <!-- ============================================================
         CONFIRMATION PAGE — Step 3 "Pronto"
         ============================================================ -->
    <template id="jj_done_page"
              name="JogaJunto — Pronto">
        <t t-call="portal_club_support.jj_register_layout">
            <t t-set="step" t-value="3"/>

            <div class="jj-confirmation">
                <div class="jj-confirmation-icon">
                    <div class="jj-confirmation-icon-inner">✓</div>
                </div>
                <h3>Cadastro concluído!</h3>
                <p>Seus clubes foram registrados com sucesso. Suas apostas agora apoiam quem você escolheu.</p>

                <div class="jj-confirmation-summary" t-if="selected_clubs">
                    <h4>Seus clubes</h4>
                    <t t-foreach="selected_clubs" t-as="item">
                        <div class="jj-confirmation-club">
                            <div class="jj-confirmation-club-dot" t-attf-style="background: {{item.get('color', '#0f3d2a')}}"/>
                            <div class="jj-confirmation-club-info">
                                <span class="jj-confirmation-club-cat" t-esc="item.get('category', '')"/>
                                <span class="jj-confirmation-club-name" t-esc="item.get('club', '')"/>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="jj-form-actions end" style="justify-content: center;">
                    <a href="/my/club-support" class="jj-btn jj-btn-primary">
                        Ir para minha conta
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
            </div>

            <div class="jj-responsible">
                <strong>Jogue com responsabilidade.</strong> Proibido para menores de 18 anos.
            </div>
        </t>
    </template>

    <!-- ============================================================
         DASHBOARD — /my/club-support
         ============================================================ -->
    <template id="jj_dashboard_page"
              name="JogaJunto — Minha Conta">
        <t t-call="portal_club_support.jj_dashboard_layout">
            <div class="jj-dash-eyebrow">MINHA CONTA</div>
            <h1 class="jj-dash-heading">Olá, <t t-esc="partner.name or 'Torcedor'"/>! 👋</h1>
            <p class="jj-dash-sub">Confira os clubes que recebem seu apoio e escolha onde jogar.</p>

            <!-- Impact Banner -->
            <div class="jj-impact-banner">
                <div class="jj-impact-icon">♥</div>
                <div>
                    <div class="jj-impact-eyebrow">SEU IMPACTO</div>
                    <div class="jj-impact-title">Cada jogo seu fortalece uma paixão.</div>
                    <div class="jj-impact-text">As comissões são direcionadas automaticamente aos clubes que você escolheu.</div>
                </div>
            </div>

            <!-- FEATURED_GAMES: configured catalogue, always preserving three slots. -->
            <section class="jj-featured-games-section">
                <div class="jj-section-header">
                    <div>
                        <div class="jj-section-eyebrow">AGORA É HORA DE JOGAR</div>
                        <div class="jj-section-title">Jogos para você</div>
                    </div>
                    <a t-if="featured_games" href="/shop" class="jj-section-action">Ver todos</a>
                </div>

                <div class="jj-featured-games-grid">
                    <t t-foreach="featured_games" t-as="game">
                        <article class="jj-game-card">
                            <a t-att-href="game.website_url or '/shop'" class="jj-game-card-cover">
                                <img t-att-src="'/web/image/product.template/%s/image_512' % game.id"
                                     t-att-alt="game.name" loading="lazy"/>
                            </a>
                            <div class="jj-game-card-content">
                                <div class="jj-game-card-kicker">JOGO EM DESTAQUE</div>
                                <h3 class="jj-game-card-name" t-esc="game.name"/>
                                <p class="jj-game-card-description"
                                   t-esc="game.description_sale or 'Jogue agora e fortaleça os clubes que você escolheu.'"/>
                                <a t-att-href="game.website_url or '/shop'" class="jj-game-card-button">
                                    Jogar agora <span aria-hidden="true">›</span>
                                </a>
                            </div>
                        </article>
                    </t>
                    <t t-foreach="range(featured_game_empty_slots or 0)" t-as="slot">
                        <article class="jj-game-card jj-game-card-placeholder">
                            <div class="jj-game-placeholder-icon">+</div>
                            <div class="jj-game-card-kicker">EM BREVE</div>
                            <div class="jj-game-placeholder-title">Novo jogo</div>
                            <p>Este espaço está reservado para o próximo lançamento.</p>
                        </article>
                    </t>
                </div>
                <p class="jj-games-priority-note">
                    Damos prioridade aos jogos selecionados, sem interromper suas escolhas de apoio.
                </p>
            </section>

            <!-- Clubes Section -->
            <div class="jj-section-header" t-if="clubs_data">
                <div>
                    <div class="jj-section-eyebrow">SUAS ESCOLHAS</div>
                    <div class="jj-section-title">Clubes apoiados</div>
                </div>
                <a href="/my/club-support/clubs" class="jj-section-action">
                    ✎ Editar escolhas
                </a>
            </div>

            <div class="jj-club-cards" t-if="clubs_data">
                <t t-foreach="clubs_data" t-as="item">
                    <div class="jj-club-card">
                        <div class="jj-club-card-category">
                            <t t-esc="item.get('category_name', '')"/>
                        </div>
                        <div class="jj-club-card-body">
                            <div class="jj-club-card-logo"
                                 t-attf-style="background: {{item.get('club_color', '#0f3d2a')}}">
                                <t t-if="item.get('club_logo')">
                                    <img t-att-src="'data:image/png;base64,' + item['club_logo'].decode() if isinstance(item['club_logo'], bytes) else 'data:image/png;base64,' + str(item['club_logo'])"
                                         t-att-alt="item.get('club_name', '')"/>
                                </t>
                                <t t-else="">
                                    <t t-esc="(item.get('club_name', '') or '?')[:2].upper()"/>
                                </t>
                            </div>
                            <div>
                                <div class="jj-club-card-name" t-esc="item.get('club_name', '')"/>
                                <div class="jj-club-card-status">Clube selecionado</div>
                            </div>
                        </div>
                        <div class="jj-club-card-footer">
                            <t t-if="item.get('commission_description')">
                                <t t-esc="item.get('commission_description', '')"/>
                            </t>
                            <t t-else="">Comissão direcionada ao clube.</t>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Empty state -->
            <div t-if="not clubs_data" class="jj-impact-banner" style="text-align: center; flex-direction: column;">
                <div class="jj-impact-icon">⚽</div>
                <div>
                    <div class="jj-impact-title">Você ainda não escolheu seus clubes</div>
                    <div class="jj-impact-text" style="margin-top: 4px;">Escolha quem apoiar em cada modalidade e comece a fazer a diferença.</div>
                    <a href="/my/club-support/clubs" class="jj-btn jj-btn-lime" style="margin-top: 16px; display: inline-flex;">
                        Escolher clubes
                    </a>
                </div>
            </div>

            <!-- Dados Pessoais -->
            <div class="jj-section-header" style="margin-top: 40px;">
                <div>
                    <div class="jj-section-eyebrow">DADOS PESSOAIS</div>
                    <div class="jj-section-title">Seu cadastro</div>
                </div>
                <a href="/my/club-support/register" class="jj-section-action">Editar dados</a>
            </div>

            <div class="jj-data-card">
                <div class="jj-data-grid">
                    <div>
                        <div class="jj-data-item-label">Nome</div>
                        <div class="jj-data-item-value" t-esc="partner.name or '—'"/>
                    </div>
                    <div>
                        <div class="jj-data-item-label">E-mail</div>
                        <div class="jj-data-item-value" t-esc="partner.email or '—'"/>
                    </div>
                    <div>
                        <div class="jj-data-item-label">CPF</div>
                        <div class="jj-data-item-value">
                            <t t-if="partner.l10n_br_cpf">
                                <t t-esc="partner.l10n_br_cpf[:3] + '.***.***-**' if len(partner.l10n_br_cpf) >= 3 else partner.l10n_br_cpf"/>
                            </t>
                            <t t-else="">—</t>
                        </div>
                    </div>
                    <div>
                        <div class="jj-data-item-label">Nascimento</div>
                        <div class="jj-data-item-value">
                            <t t-if="partner.birth_date">
                                <t t-esc="partner.birth_date.strftime('%d/%m/%Y')"/>
                            </t>
                            <t t-else="">—</t>
                        </div>
                    </div>
                </div>
            </div>

            <div class="jj-responsible">
                <strong>Jogue com responsabilidade.</strong> Proibido para menores de 18 anos.
            </div>

            <!-- Toast -->
            <div id="jj_toast" class="jj-toast" t-if="success">
                <div class="jj-toast-icon">✓</div>
                <t t-esc="success_message or 'Cadastro concluído com sucesso!'"/>
            </div>
        </t>
    </template>

    <!-- ============================================================
         LAYOUT TEMPLATES
         ============================================================ -->

    <!-- Split-screen layout (register + clubs) -->
    <template id="jj_register_layout" name="JogaJunto Register Layout">
        <t t-set="brand_slogan_line1" t-value="'Sua aposta.'"/>
        <t t-set="brand_slogan_line2" t-value="'Seu clube.'"/>
        <t t-set="brand_slogan_line3" t-value="'Todo mundo ganha.'"/>

        <t t-call="website.layout">
            <!-- PROTOTYPE_UI_MATCH: these pages provide their own branded
                 header and full-page shell. -->
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="additional_title" t-value="''"/>
            <div class="jj-wrapper">
                <div class="jj-split">
                    <!-- Brand Panel -->
                    <div class="jj-brand">
                        <div class="jj-brand-header">
                            <div class="jj-brand-logo">JJ</div>
                            <span class="jj-brand-name">JogaJunto</span>
                        </div>
                        <div class="jj-brand-secure">
                            <div class="jj-brand-secure-dot"/>
                            Ambiente seguro
                        </div>

                        <div class="jj-brand-eyebrow">JOGUE POR UMA PAIXÃO</div>
                        <div class="jj-brand-slogan">
                            <t t-esc="brand_slogan_line1"/><br/>
                            <span><t t-esc="brand_slogan_line2"/></span><br/>
                            <t t-if="brand_slogan_line3"><t t-esc="brand_slogan_line3"/></t>
                        </div>
                        <p class="jj-brand-desc">
                            Escolha quem você quer apoiar em cada modalidade.
                            Uma parte da receita gerada pelas suas apostas vai para o clube selecionado.
                        </p>

                        <div class="jj-brand-card">
                            <div class="jj-brand-card-icon">♥</div>
                            <div>
                                <div class="jj-brand-card-title">Torcida que transforma</div>
                                <div class="jj-brand-card-sub">Você joga, seu clube cresce.</div>
                            </div>
                        </div>

                        <div class="jj-brand-arcs"/>
                    </div>

                    <!-- Form Panel -->
                    <div class="jj-form-panel">
                        <div class="jj-form-inner">
                            <!-- Step Indicator -->
                            <div class="jj-steps">
                                <t t-set="steps" t-value="[
                                    ('Seus dados', 1),
                                    ('Seus clubes', 2),
                                    ('Pronto', 3),
                                ]"/>
                                <t t-foreach="steps" t-as="s">
                                    <t t-if="s_index > 0">
                                        <div t-att-class="'jj-step-connector' + (' active' if step > s[1] - 1 else '')"/>
                                    </t>
                                    <div t-att-class="'jj-step' + (' active' if step == s[1] else '') + (' done' if step > s[1] else '')">
                                        <div class="jj-step-node">
                                            <t t-if="step > s[1]">✓</t>
                                            <t t-else=""><t t-esc="s[1]"/></t>
                                        </div>
                                        <div class="jj-step-label" t-esc="s[0]"/>
                                    </div>
                                </t>
                            </div>

                            <!-- Content slot -->
                            <t t-out="0"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Dashboard layout -->
    <template id="jj_dashboard_layout" name="JogaJunto Dashboard Layout">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="jj-wrapper">
                <!-- DARK_DASHBOARD_THEME: visual theme scoped to this dashboard only. -->
                <div class="jj-dashboard jj-dashboard-dark">
                    <!-- Header -->
                    <div class="jj-dash-header">
                        <div class="jj-dash-header-left">
                            <div class="jj-dash-logo">JJ</div>
                            <span class="jj-dash-brand">JogaJunto</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 24px;">
                            <div class="jj-dash-secure">
                                <div class="jj-dash-secure-dot"/>
                                Ambiente seguro
                            </div>
                            <a href="/web/session/logout" class="jj-dash-logout">Sair</a>
                        </div>
                    </div>

                    <div class="jj-dash-content">
                        <t t-out="0"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================
         /MY PORTAL ENTRY OVERRIDE
         ============================================================ -->
    <template id="jj_my_entry"
              inherit_id="portal.portal_my_home"
              name="JogaJunto /my entry">
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="inside">
            <t t-set="pref_count" t-value="0"/>
            <t t-if="request.env.user.partner_id">
                <t t-set="pref_count"
                   t-value="request.env['club.support.preference'].sudo().search_count([
                       ('partner_id', '=', request.env.user.partner_id.id),
                       ('active', '=', True)
                   ])"/>
            </t>
            <div class="o_portal_my_home_item"
                 style="border-left-color: #0a2e1f;">
                <a href="/my/club-support">
                    <span class="o_portal_my_home_item_badge" t-esc="pref_count"/>
                    <span class="o_portal_my_home_item_text">
                        <strong>Clubes Apoiados</strong><br/>
                        <small>Gerencie os clubes que recebem seu apoio.</small>
                    </span>
                </a>
            </div>
        </xpath>
    </template>

</data>
</odoo>
