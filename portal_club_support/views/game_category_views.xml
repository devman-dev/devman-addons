<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree (lista) de categorías -->
    <record id="view_game_category_tree" model="ir.ui.view">
        <field name="name">club.support.game.category.tree</field>
        <field name="model">club.support.game.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="icon"/>
                <field name="color" widget="color_picker"/>
                <field name="club_ids" widget="many2many_tags"/>
                <field name="require_selection"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form de categoría -->
    <record id="view_game_category_form" model="ir.ui.view">
        <field name="name">club.support.game.category.form</field>
        <field name="model">club.support.game.category</field>
        <field name="arch" type="xml">
            <form string="Categoría de Juego">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="active">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivada"
                            bg_color="bg-danger" text_color="text-white"
                            invisible="active"/>

                    <group>
                        <group string="Identificación">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Visual">
                            <field name="icon"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Descripción">
                        <field name="description"/>
                    </group>

                    <group string="Comisión">
                        <field name="commission_description"/>
                        <field name="require_selection"/>
                    </group>

                    <group string="Clubes en esta categoría">
                        <field name="club_ids" widget="many2many_tags"
                               domain="[('active', '=', True)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_game_category_search" model="ir.ui.view">
        <field name="name">club.support.game.category.search</field>
        <field name="model">club.support.game.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Activas"
                        domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archivadas"
                        domain="[('active', '=', False)]"/>
                <filter name="require_selection" string="Obligatorias"
                        domain="[('require_selection', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_game_category" model="ir.actions.act_window">
        <field name="name">Categorías de Juego</field>
        <field name="res_model">club.support.game.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

</odoo>
