<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for casino.club with logo field -->
    <record id="view_casino_club_form_logo" model="ir.ui.view">
        <field name="name">casino.club.form.logo</field>
        <field name="model">casino.club</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="logo" widget="image"
                                   options="{preview_image: logo}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

