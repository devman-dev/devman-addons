        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_casino_federation_public" model="ir.model.access">
        <field name="name">Casino Federation Public Access</field>
        <field name="model_id" ref="model_casino_federation"/>
        <field name="group_id" ref="base.group_public"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>