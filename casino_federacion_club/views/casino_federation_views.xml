<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="casino_federation_tree" model="ir.ui.view">
        <field name="name">casino.federation.tree</field>
        <field name="model">casino.federation</field>
        <field name="arch" type="xml">
            <list decoration-bf="club_count > 0">
                <field name="name"/>
                <field name="commission" string="Comision %"/>
                <field name="club_count" string="Clubes"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="casino_federation_form" model="ir.ui.view">
        <field name="name">casino.federation.form</field>
        <field name="model">casino.federation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Nombre de la Federacion"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <label for="commission"/>
                            <div class="o_row">
                                <field name="commission" class="o_input" style="width:80px"/>
                                <span>%</span>
                            </div>
                        </group>
                        <group>
                            <field name="logo" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clubes">
                            <field name="club_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="commission" string="Comision %"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="casino_federation_kanban" model="ir.ui.view">
        <field name="name">casino.federation.kanban</field>
        <field name="model">casino.federation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="logo"/>
                <field name="club_count"/>
                <field name="commission"/>
                <templates>
                    <!-- CASINO_FEDERATION_ODOO18: native card template. -->
                    <t t-name="card">
                        <div>
                            <div class="oe_kanban_content">
                                <div class="row">
                                    <div class="col-9">
                                        <strong><field name="name"/></strong>
                                        <div class="text-muted">Clubes: <field name="club_count"/></div>
                                        <div>Comision: <field name="commission"/>%</div>
                                    </div>
                                    <div class="col-3">
                                        <img t-if="record.logo.raw_value" 
                                            t-att-src="kanban_image('casino.federation', 'logo', record.id.raw_value)"
                                            t-att-alt="record.name.value"
                                            style="max-width:48px;max-height:48px;border-radius:8px;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="casino_federation_search" model="ir.ui.view">
        <field name="name">casino.federation.search</field>
        <field name="model">casino.federation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="commission"/>
                <separator/>
                <filter string="Activos" name="active" domain="[('active','=',True)]" help="Mostrar federaciones activas"/>
            </search>
        </field>
    </record>

    <record id="casino_federation_action" model="ir.actions.act_window">
        <field name="name">Federaciones</field>
        <field name="res_model">casino.federation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
