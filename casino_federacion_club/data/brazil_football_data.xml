    <record id="federation_ferj" model="casino.federation">
        <field name="name">FERJ - Federação de Futebol do Estado do Rio de Janeiro</field>
        <field name="commission">2.5</field>
    </record>
    <record id="federation_fpf" model="casino.federation">
