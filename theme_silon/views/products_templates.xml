<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Casino Premium Lobby — Nossos Jogos -->
    <template id="product_page" inherit_id="website_sale.products" active="True" name="Casino Lobby">
        <!-- Banner Casino -->
        <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="before">
            <section class="banner product_banner">
                <div class="container">
                    <div class="row">
                        <h1 class="product_heading">NOSSOS JOGOS</h1>
                    </div>
                </div>
            </section>
        </xpath>
        <!-- Ocultar sección FOLLOW US -->
        <xpath expr="//section[hasclass('follow-us')]" position="replace"/>
    </template>
</odoo>