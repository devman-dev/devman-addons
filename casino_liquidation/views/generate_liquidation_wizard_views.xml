<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista form del wizard -->
    <record id="view_generate_liquidation_wizard_form" model="ir.ui.view">
        <field name="name">casino.liquidation.wizard.form</field>
        <field name="model">casino.liquidation.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Liquidación">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from" required="1" />
                            <field name="date_to" required="1" />
                        </group>
                        <group>
                            <field name="provider_id" required="1" />
                            <field name="category_id" required="1" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_liquidation" string="Generar Liquidación"
                            type="object" class="oe_highlight" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action para abrir el wizard -->
    <record id="action_generate_liquidation_wizard" model="ir.actions.act_window">
        <field name="name">Generar Liquidación</field>
        <field name="res_model">casino.liquidation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>