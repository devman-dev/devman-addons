<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista list de líneas de liquidación -->
    <record id="view_liquidation_line_list" model="ir.ui.view">
        <field name="name">casino.liquidation.line.list</field>
        <field name="model">casino.liquidation.line</field>
        <field name="arch" type="xml">
            <list string="Líneas de Liquidación">
                <field name="session_date" />
                <field name="game_id" />
                <field name="category_id" />
                <field name="session_amount" sum="Total" />
                <field name="commission_percentage" />
                <field name="commission_amount" sum="Total" />
                <field name="net_amount" sum="Total" />
            </list>
        </field>
    </record>

    <!-- Vista form de líneas de liquidación -->
    <record id="view_liquidation_line_form" model="ir.ui.view">
        <field name="name">casino.liquidation.line.form</field>
        <field name="model">casino.liquidation.line</field>
        <field name="arch" type="xml">
            <form string="Línea de Liquidación">
                <sheet>
                    <group>
                        <group>
                            <field name="liquidation_id" readonly="1" />
                            <field name="session_id" readonly="1" />
                        </group>
                        <group>
                            <field name="session_date" readonly="1" />
                            <field name="game_id" readonly="1" />
                            <field name="category_id" readonly="1" />
                        </group>
                    </group>
                    <group string="Cálculos">
                        <group>
                            <field name="session_amount" readonly="1" />
                            <field name="commission_percentage" readonly="1" />
                        </group>
                        <group>
                            <field name="commission_amount" readonly="1" />
                            <field name="net_amount" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista search de líneas de liquidación -->
    <record id="view_liquidation_line_search" model="ir.ui.view">
        <field name="name">casino.liquidation.line.search</field>
        <field name="model">casino.liquidation.line</field>
        <field name="arch" type="xml">
            <search string="Líneas de Liquidación">
                <field name="liquidation_id" />
                <field name="game_id" />
                <field name="category_id" />
                <field name="session_date" />
                <separator />
                <group expand="1" string="Agrupar por">
                    <filter string="Liquidación" name="liquidation_groupby" context="{'group_by': 'liquidation_id'}" />
                    <filter string="Juego" name="game_groupby" context="{'group_by': 'game_id'}" />
                    <filter string="Categoría" name="category_groupby" context="{'group_by': 'category_id'}" />
                    <filter string="Fecha" name="date_groupby" context="{'group_by': 'session_date'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action para listar líneas de liquidación -->
    <record id="action_liquidation_line" model="ir.actions.act_window">
        <field name="name">Líneas de Liquidación</field>
        <field name="res_model">casino.liquidation.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>