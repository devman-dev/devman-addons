<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista list de liquidaciones -->
    <record id="view_liquidation_list" model="ir.ui.view">
        <field name="name">casino.liquidation.list</field>
        <field name="model">casino.liquidation</field>
        <field name="arch" type="xml">
            <list string="Liquidaciones" decoration-info="state == 'draft'"
                decoration-success="state == 'confirmed'" decoration-danger="state == 'cancelled'">
                <field name="name" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="provider_id" />
                <field name="category_id" />
                <field name="total_sessions" />
                <field name="total_net" sum="Total Neto" />
                <field name="state" />
            </list>
        </field>
    </record>

    <!-- Vista form de liquidación -->
    <record id="view_liquidation_form" model="ir.ui.view">
        <field name="name">casino.liquidation.form</field>
        <field name="model">casino.liquidation</field>
        <field name="arch" type="xml">
            <form string="Liquidación">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'" />
                    <button name="action_draft" string="Volver a Borrador" type="object"
                        invisible="state != 'confirmed'" />
                    <button name="action_cancel" string="Cancelar" type="object"
                        invisible="state not in ('draft', 'confirmed')" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,cancelled" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" required="1" readonly="state != 'draft'" />
                            <field name="date_to" required="1" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="provider_id" required="1" readonly="state != 'draft'" />
                            <field name="category_id" required="1" readonly="state != 'draft'" />
                        </group>
                    </group>

                    <group string="Información de Confirmación">
                        <group>
                            <field name="created_by" readonly="1" />
                            <field name="confirmed_by" readonly="1" />
                        </group>
                        <group>
                            <field name="confirmed_date" readonly="1" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Detalles de Liquidación" name="details">
                            <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                                <list string="Líneas" editable="bottom">
                                    <field name="session_date" readonly="1" />
                                    <field name="game_id" readonly="1" />
                                    <field name="category_id" readonly="1" />
                                    <field name="session_amount" readonly="1" sum="Total" />
                                    <field name="commission_percentage" readonly="1" />
                                    <field name="commission_amount" readonly="1" sum="Total" />
                                    <field name="net_amount" readonly="1" sum="Total" />
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" nolabel="1"
                                placeholder="Agregar notas sobre esta liquidación..."
                                readonly="state != 'draft'" />
                        </page>
                    </notebook>

                    <group string="Totales">
                        <group>
                            <field name="total_sessions" readonly="1" />
                            <field name="total_session_amount" readonly="1" />
                        </group>
                        <group>
                            <field name="total_commission" readonly="1" />
                            <field name="total_net" readonly="1" widget="monetary" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista search de liquidación -->
    <record id="view_liquidation_search" model="ir.ui.view">
        <field name="name">casino.liquidation.search</field>
        <field name="model">casino.liquidation</field>
        <field name="arch" type="xml">
            <search string="Liquidaciones">
                <field name="name" />
                <field name="provider_id" />
                <field name="category_id" />
                <field name="date_from" />
                <separator />
                <filter name="draft_filter" string="Borrador" domain="[('state', '=', 'draft')]" />
                <filter name="confirmed_filter" string="Confirmadas"
                    domain="[('state', '=', 'confirmed')]" />
                <filter name="cancelled_filter" string="Canceladas"
                    domain="[('state', '=', 'cancelled')]" />
                <separator />
                <group expand="1" string="Agrupar por">
                    <filter string="Proveedor" name="provider_groupby"
                        context="{'group_by': 'provider_id'}" />
                    <filter string="Categoría" name="category_groupby"
                        context="{'group_by': 'category_id'}" />
                    <filter string="Estado" name="state_groupby" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action para listar liquidaciones -->
    <record id="action_liquidation" model="ir.actions.act_window">
        <field name="name">Liquidaciones</field>
        <field name="res_model">casino.liquidation</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_liquidation_list"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay liquidaciones. Usa el asistente para generar una nueva.
            </p>
        </field>
    </record>
</odoo>