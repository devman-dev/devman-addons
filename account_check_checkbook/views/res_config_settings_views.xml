<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">account.check.checkbook.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='print_vendor_checks_setting_container']" position="after">
                <block title="Cheques propios" id="checks_setting_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="ignore_journal_checks" groups="account.group_account_user">
                        <div class="o_setting_left_pane">
                            <field name="ignore_journal_checkbook_sequence"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="ignore_journal_checkbook_sequence"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                            <div class="text-muted" id="print_bills_payment">
                                Ignores the Journal Sequence created for checks to instead, use sequence per check.
                            </div>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
