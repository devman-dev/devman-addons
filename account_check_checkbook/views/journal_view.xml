<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>

        <record id="checkbook_journal_form" model="ir.ui.view">
            <field name="name">view.checkbook.journal.form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"></field>
	    	<field name="arch" type="xml">
				<xpath expr="//notebook" position="inside">
					<page string="Chequeras" invisible="type != 'bank'">
						<br />
						<group>
							<field name="checkbook_ids" >
								<tree editable="bottom">
									<field name="name" />
									<field name="sequence_id" invisible="True"/>
									<field name="next_number" string="Ultimo nro."/>
									<field name="end_number" readonly="checkbook_type != 'physical'"/>
									<field name="checkbook_type" />
									<field name="state" />
									<field name="checks_cancelled" readonly="True"/>
								</tree>
							</field>
						</group>
					</page>
				</xpath>

				<xpath expr="//field[@name='check_manual_sequencing']" position="attributes">
					<attribute name="invisible">True</attribute>
				</xpath>
            </field>
        </record>
		
        <record id="check_printing_checkbook_journal_form" model="ir.ui.view">
            <field name="name">view.check.printing.checkbook.journal.form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account_check_printing.view_account_journal_form_inherited"></field>
	    <field name="arch" type="xml">
		    <field name="check_next_number" position="attributes">
			    <attribute name="invisible">True</attribute>
		</field>
            </field>
        </record>


    </data>
</odoo>
