<?xml version="1.0" encoding="utf-8"?>
<!-- views/agent_settings_views.xml -->
<odoo>
  <record id="view_casino_agent_settings_inherit" model="ir.ui.view">
    <field name="name">casino.agent.settings.inherit</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="auth_signup.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <div class="app_settings_block" data-string="Agentes" data-key="casino_agentes">
          <h2>Agentes</h2>
          <div class="row mt16 o_settings_container">

            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <label for="commission_mode" class="o_form_label" />
                <div class="text-muted o_form_label_help">
                  Modo de comisionamientos
                </div>
              </div>
              <div class="o_setting_right_pane">
                <field name="commission_mode" class="w-100" />
              </div>
            </div>

            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <label for="agent_commission_percent_default" class="o_form_label" />
                <div class="text-muted o_form_label_help">
                  Porcentaje de comisión por defecto
                </div>
              </div>
              <div class="o_setting_right_pane">
                <field name="agent_commission_percent_default"
                  widget="percentage"
                  class="w-100"
                  placeholder="0,00" />
              </div>
            </div>

          </div>
        </div>
        <!-- <div class="app_settings_block" data-string="Agentes" data-key="casino_agentes">
          <h2>Agentes</h2>
