<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Vista list personalizada para categorías públicas -->
  <record id="public_category_commission_list_view" model="ir.ui.view">
    <field name="name">product.public.category.commission.list</field>
    <field name="model">product.public.category</field>
    <field name="arch" type="xml">
      <list string="Public Categories">
        <field name="name" />
        <field name="commission" widget="percentage" />
        <field name="product_count" />
        <field name="parent_id" optional="hide" />
      </list>
    </field>
  </record>

  <!-- Vista form personalizada para categorías públicas con botón -->
  <record id="public_category_commission_form_view" model="ir.ui.view">
    <field name="name">product.public.category.commission.form</field>
    <field name="model">product.public.category</field>
    <field name="arch" type="xml">
      <form string="Public Category">
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="parent_id" />
            </group>
            <group>
              <field name="commission" widget="percentage" />
              <field name="product_count" readonly="1" />
              <button name="action_update_products_commission"
                string="Propagar comisión"
                type="object"
                class="oe_highlight"
                invisible="not commission" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción para el menú -->
  <record id="public_category_commission_action" model="ir.actions.act_window">
    <field name="name">Categorías</field>
    <field name="res_model">product.public.category</field>
    <field name="view_mode">list,form</field>
    <field name="view_ids"
      eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('public_category_commission_list_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('public_category_commission_form_view')})]" />
  </record>

</odoo>