<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista kanban para organigrama jerárquico -->
    <record id="view_agent_hierarchy_kanban" model="ir.ui.view">
        <field name="name">agent.hierarchy.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban default_group_by="parent_agent_id" class="o_agent_hierarchy_kanban">
                <field name="name" />
                <field name="is_agent" />
                <field name="is_player" />
                <field name="parent_agent_id" />
                <field name="agent_depth" />
                <field name="child_agent_ids" />
                <field name="managed_player_ids" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click agent-hierarchy-card"
                            t-att-data-level="record.agent_depth.raw_value">
                            <div class="agent-card-header">
                                <div class="agent-info">
                                    <h4 class="agent-name">
                                        <i class="fa fa-user-circle text-primary me-2" />
                                        <field name="name" />
                                    </h4>
                                    <div class="agent-badges">
                                        <span t-if="record.is_agent.raw_value"
                                            class="badge badge-primary me-1">
                                            <i class="fa fa-user" /> Agente </span>
                                        <span t-if="record.is_player.raw_value"
                                            class="badge badge-success me-1">
                                            <i class="fa fa-gamepad" /> Jugador </span>
                                        <span class="badge badge-info"> Nivel <t
                                                t-esc="record.agent_depth.raw_value || 0" />
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="agent-card-body">
                                <!-- Información de subagentes -->
                                <div
                                    t-if="record.child_agent_ids.raw_value and record.child_agent_ids.raw_value.length"
                                    class="hierarchy-info">
                                    <div class="stat-item">
                                        <i class="fa fa-users text-primary" title="Subagentes" />
                                        <span><t t-esc="record.child_agent_ids.raw_value.length" />
                                            Subagente(s)</span>
                                    </div>
                                </div>

                                <!-- Información de jugadores -->
                                <div
                                    t-if="record.managed_player_ids.raw_value and record.managed_player_ids.raw_value.length"
                                    class="hierarchy-info">
                                    <div class="stat-item">
                                        <i class="fa fa-gamepad text-success" title="Jugadores" />
                                        <span><t t-esc="record.managed_player_ids.raw_value.length" />
                                            Jugador(es)</span>
                                    </div>
                                </div>

                                <!-- Si no tiene ni subagentes ni jugadores -->
                                <div
                                    t-if="!record.child_agent_ids.raw_value.length and !record.managed_player_ids.raw_value.length"
                                    class="hierarchy-info">
                                    <small class="text-muted">
                                        <i class="fa fa-info-circle" /> Sin asignaciones </small>
                                </div>
                            </div>

                            <!-- Línea de conexión visual -->
                            <div class="hierarchy-connector" t-if="record.parent_agent_id.raw_value">
                                <div class="connector-line"></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista list mejorada para agentes -->
    <record id="view_agent_hierarchy_list" model="ir.ui.view">
        <field name="name">agent.hierarchy.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Jerarquía de Agentes" expand="1" editable="bottom">
                <field name="name" />
                <field name="is_agent" />
                <field name="is_player" />
                <field name="parent_agent_id" domain="[('is_agent','=',True), ('id','!=', id)]" />
                <field name="agent_depth" readonly="1" />
                <field name="child_agent_ids" widget="many2many_tags" readonly="1" />
                <field name="managed_player_ids" widget="many2many_tags" readonly="1" />
            </list>
        </field>
    </record>

    <!-- Acción de ventana para vista kanban organigrama -->
    <record id="action_agent_hierarchy_kanban" model="ir.actions.act_window">
        <field name="name">Organigrama de Agentes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_agent_hierarchy_kanban" />
        <field name="domain">[('is_agent', '=', True)]</field>
        <field name="context">{'default_is_agent': True, 'group_by': 'parent_agent_id'}</field>
        <field name="help">Vista en organigrama de la estructura jerárquica de agentes y jugadores.</field>
    </record>

    <!-- Acción de ventana para gestión estándar -->
    <record id="action_agent_hierarchy" model="ir.actions.act_window">
        <field name="name">Gestión de Agentes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_agent_hierarchy_list" />
        <field name="domain">[('is_agent', '=', True)]</field>
        <field name="context">{'default_is_agent': True}</field>
        <field name="help">Vista de gestión tabular de agentes y su información jerárquica.</field>
    </record>

    <!-- Acción cliente para widget personalizado -->
    <record id="action_agent_hierarchy_widget" model="ir.actions.client">
        <field name="name">Organigrama Interactivo</field>
        <field name="tag">agent_hierarchy_widget</field>
    </record>

</odoo>