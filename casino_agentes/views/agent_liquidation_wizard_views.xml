<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_agent_liquidation_wizard_form" model="ir.ui.view">
    <field name="name">agent.liquidation.wizard.form</field>
    <field name="model">agent.liquidation.wizard</field>
    <field name="arch" type="xml">
      <form string="Liquidación de agentes">
        <group>
          <field name="date_from" />
          <field name="date_to" />
          <field name="agent_id" />
          <!-- <field name="view_type" /> -->
        </group>
        <footer>
          <button name="action_liquidate" type="object" string="Liquidar" class="btn-primary" />
          <button string="Cancelar" class="btn-secondary" special="cancel" />
        </footer>
      </form>
    </field>
  </record>

  <!-- Acción y menú solo para administradores -->
  <record id="action_agent_liquidation_wizard" model="ir.actions.act_window">
    <field name="name">Liquidación de agentes</field>
    <field name="res_model">agent.liquidation.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{}</field>
  </record>

</odoo>