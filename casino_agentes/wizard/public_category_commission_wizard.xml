<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_public_category_commission_wizard" model="ir.ui.view">
    <field name="name">public.category.commission.wizard.form</field>
    <field name="model">casino_agentes.public.category.commission.wizard</field>
    <field name="arch" type="xml">
      <form string="Propagar comisión" create="false" edit="false">
        <sheet>
          <group>
            <field name="category_id" readonly="1" />
            <field name="commission" widget="percentage" />
            <!-- <field name="apply_to_children" />
            <field name="only_games" />
            <field name="overwrite_existing" /> -->
          </group>
        </sheet>
        <footer>
          <button string="Cancelar" class="btn-secondary" special="cancel" />
          <button name="action_apply" type="object" string="Aplicar" class="btn-primary" />
        </footer>
      </form>
    </field>
  </record>
</odoo>