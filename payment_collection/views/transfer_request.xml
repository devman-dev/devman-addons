<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="transfer_request_action" model="ir.actions.act_window">
        <field name="name">Pedidos de Transferencias / Retiros</field>
        <field name="res_model">transfer.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="transfer_request_view_tree" model="ir.ui.view">
        <field name="name">transfer.request.view.tree</field>
        <field name="model">transfer.request</field>
        <field name="arch" type="xml">
            <tree string="Pedidos de Transferencias" create="0">
                <header>
                    <button groups="payment_collection.groups_payment_collection_admin" type="object" name="transfer_movements_to_collection" class="btn btn-primary" string="Pasar Movimientos"/>
                </header>
                <field name="date" />
                <field name="customer" force_save="1" readonly="1"/>
                <field name="service" />
                <field name="commission" />
                <field name="withdrawal_operations" column_invisible="True"/>
                <field name="operation" domain="[('id', 'in', withdrawal_operations)]" options="{'no_create': True, 'no_create_edit': True,'no_quick_create': True}"/>
                <field name="description" />
                <field name="amount" force_save="1" readonly="1"/>
                <field name="account_bank"/>
                <field name="origin_account_table" column_invisible="True"/>
                <field name="origin_account" domain="[('id','in',origin_account_table)]" context="{'show_account_name': True}" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                <field name="name_destination_account" />
                <field name="alias_destination_account" />
                <field name="cbu_destination_account" />
                <field name="cvu_destination_account" />
                <field name="transfer_type"/>
                <field name="transfer_request_state" force_save="1" readonly="1" widget="badge" decoration-muted="transfer_request_state == 'nuevo'" decoration-warning="transfer_request_state == 'revisar'" decoration-success="transfer_request_state == 'pasado'" decoration-danger="transfer_request_state == 'cancelado'"/>
            </tree>
        </field>
    </record>

    <record id="transfer_request_view_form" model="ir.ui.view">
        <field name="name">transfer.request.view.form</field>
        <field name="model">transfer.request</field>
        <field name="arch" type="xml">
            <form string="Pedidos de Transferecias">
                <header>
                    <button groups="payment_collection.groups_payment_collection_admin" type="object" name="transfer_movements_to_collection" class="btn btn-primary" string="Pasar Movimientos" invisible="transfer_request_state == 'pasado'" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date" />
                            <field name="customer" force_save="1" readonly="1"/>
                            <field name="service" domain="[('services.collection_type', '=', 'service'), ('customer', '=', customer)]" context="{'show_servicio_name': True}" options="{'no_create': True, 'no_create_edit': True,'no_quick_create': True}" />
                            <field name="commission" />
                            <field name="withdrawal_operations" invisible="1"/>
                            <field name="operation" domain="[('id', 'in', withdrawal_operations)]" options="{'no_create': True, 'no_create_edit': True,'no_quick_create': True}"/>
                            <field name="description" />
                            <field name="amount" force_save="1" readonly="1"/>
                        </group>
                        <group>
                            <field name="account_bank"/>
                            <field name="origin_account_table" invisible="1"/>
                            <field name="origin_account" domain="[('id','in',origin_account_table)]" context="{'show_account_name': True}" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="name_destination_account" />
                            <field name="alias_destination_account" />
                            <field name="cbu_destination_account" />
                            <field name="cvu_destination_account" />
                            <field name="transfer_type" readonly="1"/>
                            <field name="transfer_request_state" force_save="1" readonly="1" widget="badge" decoration-muted="transfer_request_state == 'nuevo'" decoration-warning="transfer_request_state == 'revisar'" decoration-success="transfer_request_state == 'pasado'" decoration-danger="transfer_request_state == 'cancelado'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="transfer_request_view_search" model="ir.ui.view">
        <field name="name">transfer.request.view.search</field>
        <field name="model">transfer.request</field>
        <field name="arch" type="xml">
            <search string="">
                <group>
                    <filter name="transfer_type" string="Tipo de transacción" context="{'group_by': 'transfer_type'}" />
                    <filter string="Retiros" name="transfer_type" domain="[('transfer_type', '=', 'retiro')]"/>
                    <filter string="Transferencias" name="transfer_type" domain="[('transfer_type', '=', 'transferencia')]"/>
                </group>
            </search>
        </field>
    </record>

</odoo>