<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="filter_collection_movement_wiz_view_form" model="ir.ui.view">
        <field name="name">filter.collection.movement.wiz.view.form</field>
        <field name="model">filter.collection.movement</field>
        <field name="arch" type="xml">
            <form string="Filtar Movimientos">
                <sheet>
                    <group>

                        <field name="customer_code"/>
                        <field name="customer" options="{'no_create': True, 'no_create_edit': True,'no_quick_create': True}"/>
                        <field name="service" domain="[('id','in', service_ids)]" options="{'no_create': True, 'no_create_edit': True,'no_quick_create': True}"/>
                        <field name="operation" domain="[('collection_type','=','operation')]" options="{'no_create': True, 'no_create_edit': True,'no_quick_create': True}"/>
                        <field name="bank" options="{'no_create': True, 'no_create_edit': True,'no_quick_create': True}"/>
                        <field name="service_ids" invisible="1"/>
                    </group>
                    <footer>
                        <button name="show_collection" string="Filtrar" class="btn btn-primary" type="object"/>
                        <button special="cancel" string="Descartar" class="btn btn-secondary" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
