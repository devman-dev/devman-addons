<odoo>
  <report id="action_report_project_summary" model="project.quotation.summary" string="Resumen de Cotización"
          report_type="qweb-pdf" name="project_quotation_financing.report_project_summary_document"
          file="project_quotation_financing.report_project_summary_document"
          print_report_name="'Resumen - %s' % (object.quotation_id.sequence)"/>
  <template id="report_project_summary_document">
    <t t-call="web.external_layout">
      <t t-foreach="docs" t-as="o">
        <div class="page">
          <h2>Resumen de Cotización</h2>
          <p><strong>Empresa:</strong> <t t-esc="o.env.company.name"/></p>
          <p><strong>Cliente:</strong> <t t-esc="o.partner_id.display_name"/></p>
          <p><strong>Oportunidad:</strong> <t t-esc="o.lead_id.name"/></p>
          <p><strong>Proyecto:</strong> <t t-esc="o.quotation_id.name"/></p>
          <hr/>
          <h3>Consolidado de Horas</h3>
          <p>Total de horas: <t t-esc="o.total_hours"/></p>
          <h3>Totales</h3>
          <table class="table table-sm">
            <tr><th>Valor Bruto</th><td><t t-esc="o.revenue"/></td></tr>
            <tr><th>Valor Cliente</th><td><t t-esc="o.revenue_after_discount"/></td></tr>
            <tr><th>Gastos</th><td><t t-esc="o.expenses_total"/></td></tr>
            <tr><th>Costo Equipo</th><td><t t-esc="o.team_cost_total"/></td></tr>
            <tr><th>Ganancia Neta</th><td><t t-esc="o.profit"/></td></tr>
            <tr><th>Margen Neto (%)</th><td><t t-esc="o.margin_net"/></td></tr>
          </table>
          <h3>Observaciones</h3>
          <t t-raw="o.observations or ''"/>
        </div>
      </t>
    </t>
  </template>
</odoo>