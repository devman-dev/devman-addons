<odoo>
  <record id="view_project_quotation_tree" model="ir.ui.view">
    <field name="name">project.quotation.tree</field>
    <field name="model">project.quotation</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence"/>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="lead_id"/>
        <field name="total_hours"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="view_project_quotation_kanban" model="ir.ui.view">
    <field name="name">project.quotation.kanban</field>
    <field name="model">project.quotation</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state">
        <field name="name"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
              <div><strong><t t-esc="record.name.value"/></strong></div>
              <div><t t-esc="record.partner_id.value"/></div>
              <div>Horas: <t t-esc="record.total_hours.value"/></div>
              <div>Estado: <t t-esc="record.state.value"/></div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_project_quotation_form" model="ir.ui.view">
    <field name="name">project.quotation.form</field>
    <field name="model">project.quotation</field>
    <field name="arch" type="xml">
      <form string="Cotización de Proyecto">
        <header>
          <button name="action_to_financing" type="object" string="Pasar a Financiamiento" class="oe_highlight" attrs="{'invisible':[('state','!=','draft')]}"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field name="sequence" readonly="1"/>
            <field name="name"/>
            <field name="partner_id"/>
            <field name="lead_id" readonly="1"/>
          </group>
          <notebook>
            <page string="Módulos y Servicios">
              <field name="line_ids">
                <tree editable="bottom">
                  <field name="product_id"/>
                  <field name="complexity_id"/>
                  <field name="computed_hours"/>
                  <field name="total_hours" readonly="1"/>
                </tree>
                <form>
                  <group>
                    <field name="product_id"/>
                    <field name="complexity_id"/>
                    <field name="computed_hours"/>
                    <group string="Distribución de Roles">
                      <field name="role_distribution_ids">
                        <tree editable="bottom">
                          <field name="role_id"/>
                          <field name="percent"/>
                        </tree>
                      </field>
                    </group>
                  </group>
                </form>
              </field>
            </page>
            <page string="Totales">
              <group>
                <field name="total_hours" readonly="1"/>
                <field name="note"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_project_quotation" model="ir.actions.act_window">
    <field name="name">Cotizaciones</field>
    <field name="res_model">project.quotation</field>
    <field name="view_mode">tree,kanban,form</field>
  </record>
</odoo>