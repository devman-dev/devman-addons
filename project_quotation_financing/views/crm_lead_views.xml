<odoo>
  <record id="view_crm_lead_form_inherit_pqf" model="ir.ui.view">
    <field name="name">crm.lead.form.inherit.pqf</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_form_view_oppor"/>
    <field name="arch" type="xml">
      <header position="inside">
        <button name="action_create_project_quotation" type="object" string="Crear Cotización de Proyecto" class="oe_highlight" attrs="{'invisible': [('pqf_quotation_id','!=',False)]}"/>
      </header>
      <sheet position="inside">
        <group>
          <field name="pqf_quotation_id" readonly="1"/>
        </group>
      </sheet>
    </field>
  </record>
</odoo>