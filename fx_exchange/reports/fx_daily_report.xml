<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <report
    id="fx_daily_report_pdf"
    model="fx.operation"
    string="Reporte de Caja Diaria FX"
    report_type="qweb-pdf"
    name="fx_exchange.fx_daily_report_template"
    file="fx_exchange.fx_daily_report_template"
    print_report_name="'FX Caja %s' % (object.date)"
  />
  <template id="fx_daily_report_template">
    <t t-call="web.external_layout">
      <t t-set="doc" t-value="docs"/>
      <div class="page">
        <h2>Reporte de Caja Diaria FX</h2>
        <p><strong>Fecha:</strong> <t t-esc="docs[0].date"/></p>
        <table class="table table-sm o_main_table">
          <thead>
            <tr>
              <th>Ref</th><th>Tipo</th><th>Moneda</th><th>Cant</th>
              <th>Base</th><th>Comisión</th><th>Total</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="docs" t-as="op">
              <tr>
                <td><t t-esc="op.name"/></td>
                <td><t t-esc="dict(op._fields['operation_type'].selection).get(op.operation_type)"/></td>
                <td><t t-esc="op.currency_id.name"/></td>
                <td class="text-end"><t t-esc="op.amount_currency"/></td>
                <td class="text-end"><t t-esc="op.base_amount_company"/></td>
                <td class="text-end"><t t-esc="op.commission_amount"/></td>
                <td class="text-end"><t t-esc="op.total_amount_company"/></td>
              </tr>
            </t>
          </tbody>
        </table>
        <t t-set="tot_base" t-value="sum(d.base_amount_company for d in docs)"/>
        <t t-set="tot_comm" t-value="sum(d.commission_amount for d in docs)"/>
        <t t-set="tot_total" t-value="sum(d.total_amount_company for d in docs)"/>
        <p><strong>Totales del día:</strong>
          Base: <t t-esc="tot_base"/> —
          Comisión: <t t-esc="tot_comm"/> —
          Total: <t t-esc="tot_total"/>
        </p>
      </div>
    </t>
  </template>
</odoo>
