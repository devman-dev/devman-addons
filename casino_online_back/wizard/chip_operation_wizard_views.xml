<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_chip_operation_wizard_form" model="ir.ui.view">
    <field name="name">chip.operation.wizard.form</field>
    <field name="model">chip.operation.wizard</field>
    <field name="arch" type="xml">
      <form string="Carga / Retiro de Fichas">
        <sheet class="o_casino_chip_wizard">
          <div class="oe_title mb-3">
            <h1>
              <i class="fa fa-coins text-primary me-2" />
              <span>Carga / Retiro de Fichas</span>
            </h1>
          </div>

          <group class="mt-3" col="1">
            <group string="📅 Información General" class="border rounded p-3 mb-3"
              style="background-color: #f8f9fa;">
              <field name="date" readonly="1" widget="datetime"
                string="Fecha y Hora"
                class="fw-bold" />
              <field name="operation_type"
                widget="radio"
                options="{'horizontal': true}"
                class="o_operation_type_field" />
            </group>

            <group string="💰 Detalles de la Operación" class="border rounded p-3 mb-3"
              style="background-color: #f8f9fa;">
              <field name="partner_id"
                string="Cliente / Proveedor"
                options="{'no_create': True, 'no_create_edit': True}"
                placeholder="Seleccione un cliente..."
                class="fw-bold" />
              <field name="amount"
                string="Importe"
                class="text-success fw-bold fs-5"
                decoration-danger="operation_type == 'withdrawal'"
              />
            </group>
          </group>

          <group class="mt-2">
            <field name="description"
              string="📝 Observaciones"
              placeholder="Agregue una descripción o comentario opcional..."
              class="o_description_field"
              nolabel="1" />
          </group>
        </sheet>
        <footer>
          <button string="✓ Confirmar Operación"
            type="object"
            name="action_confirm"
            class="btn-primary oe_highlight"
            data-hotkey="q" />
          <button string="✗ Cancelar"
            type="object"
            name="action_cancel"
            class="btn-secondary"
            data-hotkey="z" />
        </footer>
      </form>
    </field>
  </record>
</odoo>