<odoo>
    <record id="view_casino_game_session_form" model="ir.ui.view">
        <field name="name">casino.game.session.form</field>
        <field name="model">casino.game.session</field>
        <field name="arch" type="xml">
            <form string="Sesión de Juego" class="o_casino_session_form">
                <sheet>
                    <group>
                        <group string="Información de Transacción">
                            <field name="transaction_id" />
                            <field name="internal_transaction_id" string="ID Transacción Interna" />
                            <field name="round_id" />
                            <field name="token" />
                        </group>
                        <group string="Detalles del Juego">
                            <field name="provider_id" readonly="1" optional="hide" />
                            <field name="game_id" />
                            <field name="user_id" />
                            <field name="agent_id" />
                            <field name="state" />
                            <field name="result" />
                        </group>
                    </group>

                    <group>
                        <group string="Periodo">
                            <field name="start_datetime" />
                            <field name="end_datetime" />
                        </group>
                        <group string="Financiero">
                            <field name="initial_balance" />
                            <field name="amount" />
                            <field name="to_win" />
                            <field name="final_balance" />
                            <field name="currency_id" />
                            <field name="agent_commission" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Eventos" name="events_page">
                            <div class="o_casino_events_container">
                                <field name="events_html" nolabel="1" readonly="1" />
                            </div>
                        </page>
                        <page string="Sesiones relacionadas" name="related_sessions_page">
                            <field name="related_session_ids" nolabel="1">
                                <list string="Sesiones" default_order="id asc">
                                    <field name="start_datetime" />
                                    <field name="result" />
                                    <field name="amount" string="Importe" widget="monetary" />
                                    <field name="to_win" widget="monetary" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="description" />
                    <field name="json_data" string="JSON Recibido" />
                    <field name="events" nolabel="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_casino_game_session_tree" model="ir.ui.view">
        <field name="name">casino.game.session.tree</field>
        <field name="model">casino.game.session</field>
        <field name="arch" type="xml">
            <list string="Sesiones de Juego"
                decoration-success="state=='finished'"
                decoration-warning="state=='in_progress'"
                decoration-muted="state=='pending'"
                default_order="id desc, round_id desc">

                <field name="id" string="ID" />
                <field name="transaction_id" string="ID Apuesta" />
                <field name="game_id" string="Juego" />
                <field name="provider_id" string="Proveedor" optional="hide" />
                <field name="round_id" string="ID Round" />
                <field name="start_datetime" string="Inicio" optional="show" />
                <field name="user_id" string="Usuario" />
                <field name="result" string="Operación" />
                <field name="amount" string="Monto" widget="monetary" sum="Total" />
                <field name="final_balance" string="S.Final" widget="monetary" sum="Total"
                    optional="show" />
                <field name="to_win" string="A Ganar" widget="monetary" sum="Total" />
                <!-- <field name="end_datetime" string="Fin" optional="show" /> -->
                <!-- <field name="initial_balance" string="S.Inicial" optional="show" /> -->
                <!-- <field name="currency_id" string="Moneda" optional="show" /> -->

                <!-- <field name="agent_id" string="Agente" optional="show" />
                <field name="agent_commission" string="Comisión Agente" optional="show" />
                <field name="result" string="Resultado" /> -->
                <field name="token" string="Token" optional="hide" />
                <field name="internal_transaction_id" string="ID Transacción Interna"
                    optional="hide" />
                <!-- Necesario para formatear correctamente campos monetarios y sus totales -->
                <field name="currency_id" optional="show" />
            </list>
        </field>
    </record>

    <!-- Vista de búsqueda con agrupación por transaction_id -->
    <record id="view_casino_game_session_search" model="ir.ui.view">
        <field name="name">casino.game.session.search</field>
        <field name="model">casino.game.session</field>
        <field name="arch" type="xml">
            <search string="Buscar Sesiones de Juego">
                <field name="transaction_id" />
                <field name="game_id" />
                <field name="provider_id" />
                <field name="user_id" />
                <field name="start_datetime" />
                <field name="internal_transaction_id" />
                <!-- <filter string="Agrupar por Transacción"
                    name="group_by_group_display_name"
                    context="{'group_by':'group_display_name'}" /> -->
                <group expand="0" string="Filtros">
                    <filter name="op_running" string="Running"
                        domain="[('result', '=', 'in_progress')]" />
                    <filter name="op_win" string="Win" domain="[('result', '=', 'win')]" />
                    <filter name="op_loss" string="Loss" domain="[('result', '=', 'loss')]" />
                </group>
                <group expand="1" string="Agrupar por">
                    <filter string="Proveedor" name="group_by_provider"
                        context="{'group_by':'provider_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Acción con agrupamiento por defecto en transaction_id -->
    <record id="action_casino_game_session" model="ir.actions.act_window">
        <field name="name">Sesiones de Juego</field>
        <field name="res_model">casino.game.session</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_casino_game_session_tree" />
        <field name="search_view_id" ref="view_casino_game_session_search" />
        <!-- <field name="context">{'search_default_group_by_group_display_name': 1}</field> -->
    </record>
</odoo>