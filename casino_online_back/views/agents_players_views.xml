<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Vista Tree: Agentes y Jugadores -->
  <record id="view_casino_agents_players_tree" model="ir.ui.view">
    <field name="name">res.partner.agents.players.list</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <list string="Usuarios" create="0">
        <field name="name" string="Nombre" />
        <field name="nickname" string="Nickname" optional="show" />
        <field name="supervisor_agent_id" string="Padre" />
        <field name="role" string="Rol"
          widget="badge"
          decoration-bf="True" />
        <field name="create_date" string="Fecha de Alta" />
        <!-- <button name="action_open_load_chips_wizard"
          type="object" groups="base.group_system"
          title="Cargar Fichas"
          icon="fa-coins"
          class="btn-primary" /> -->
        <button name="action_open_load_chips_wizard"
          type="object"
          groups="base.group_system"
          icon="fa-money"
          class="btn btn-link o_icon_button"
          string=""
          help="Cargar/Retirar fichas" />
      </list>
    </field>
  </record>

  <!-- Vista Kanban: Agentes y Jugadores -->
  <record id="view_casino_agents_players_kanban" model="ir.ui.view">
    <field name="name">res.partner.agents.players.kanban</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_small_column">
        <!-- Campos necesarios para el template -->
        <field name="name" />
        <field name="nickname" />
        <field name="role" />
        <field name="create_date" />
        <templates>
          <t t-name="kanban-box">
            <div class="o_kanban_record o_casino_user_card">
              <div class="o_casino_user_header">
                <div class="o_casino_avatar">
                  <t t-set="initials"
                    t-value="(record.name.value || '??')[0].toUpperCase() + ((record.name.value || '??').split(' ')[1] || ' ')[0].toUpperCase()" />
                  <div class="o_casino_avatar_circle"
                    t-att-class="'avatar-' + (record.role.raw_value || 'default')">
                    <span class="o_casino_initials" t-esc="initials" />
                  </div>
                </div>
                <div class="o_casino_user_info">
                  <div class="o_casino_name_row">
                    <strong class="o_casino_name" t-esc="record.name.value" />
                    <span class="o_casino_badge"
                      t-att-class="'badge-' + (record.role.raw_value or 'default')"
                      t-if="record.role.raw_value == 'agent'">
                      <i class="fa fa-user-tie me-1" />Agente </span>
                    <span class="o_casino_badge badge-player"
                      t-if="record.role.raw_value == 'player'">
                      <i class="fa fa-gamepad me-1" />Jugador </span>
                  </div>
                  <div class="o_casino_nickname" t-if="record.nickname.value">
                    <i class="fa fa-at me-1 text-muted" />
                    <span t-esc="record.nickname.value" />
                  </div>
                </div>
              </div>

              <!-- <div class="o_casino_user_details">
                <div class="o_casino_detail_item" t-if="record.supervisor_agent_id.value">
                  <i class="fa fa-user-shield text-primary me-2" />
                  <div class="o_casino_detail_content">
                    <small class="o_casino_label">Agente superior</small>
                    <span class="o_casino_value" t-esc="record.supervisor_agent_id.value" />
                  </div>
                </div>
                <div class="o_casino_detail_item"
                  t-if="record.create_date and record.create_date.value">
                  <i class="fa fa-calendar-plus text-success me-2" />
                  <div class="o_casino_detail_content">
                    <small class="o_casino_label">Fecha de alta</small>
                    <span class="o_casino_value" t-esc="record.create_date.value" />
                  </div>
                </div>
              </div> -->

              <div class="o_casino_user_footer">
                <button type="object" class="btn btn-sm btn-primary o_casino_action_btn"
                  groups="base.group_system"
                  name="action_open_load_chips_wizard">
                  <i class="fa fa-coins me-1" />Cargar Fichas </button>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Vista Search: Filtros para Agentes y Jugadores -->
  <record id="view_casino_agents_players_search" model="ir.ui.view">
    <field name="name">res.partner.agents.players.search</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <search string="Buscar Usuarios">
        <!-- Barra de búsqueda -->
        <field name="name" string="Nombre" filter_domain="[('name', 'ilike', self)]" />
        <field name="nickname" string="Nickname" filter_domain="[('nickname', 'ilike', self)]" />
        <field name="supervisor_agent_id" string="Agente Superior" />

        <!-- Filtros superiores -->
        <filter string="Agentes" name="filter_agents" domain="[('role', '=', 'agent')]" />
        <filter string="Jugadores" name="filter_players" domain="[('role', '=', 'player')]" />

        <separator />

        <!-- Agrupar por -->
        <group expand="0" string="Agrupar por">
          <filter string="Rol" name="group_by_role" context="{'group_by': 'role'}" />
          <filter string="Agente Superior" name="group_by_supervisor"
            context="{'group_by': 'supervisor_agent_id'}" />
          <filter string="Fecha de Alta" name="group_by_date" context="{'group_by': 'create_date'}" />
        </group>

        <!-- Filtros laterales -->
        <searchpanel>
          <field name="role" string="Rol" icon="fa-user-circle" enable_counters="1" />
        </searchpanel>
      </search>
    </field>
  </record>

  <!-- Acción de ventana -->
  <record id="action_casino_agents_players" model="ir.actions.act_window">
    <field name="name">Usuarios</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_casino_agents_players_search" />
    <field name="domain">['|', ('is_agent', '=', True), ('is_player', '=', True)]</field>
    <field name="context">{
      'search_default_is_agent': 0,
      'search_default_is_player': 0
      }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No hay usuarios aún</p>
      <p>Los usuarios se crean como Contactos. Marca "Es agente" o "Es jugador" para clasificarlos.</p>
    </field>
  </record>

  <!-- Asignación de vistas preferidas a la acción -->
  <record id="action_casino_agents_players_view_kanban" model="ir.actions.act_window.view">
    <field name="sequence" eval="1" />
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="view_casino_agents_players_kanban" />
    <field name="act_window_id" ref="action_casino_agents_players" />
  </record>
  <!-- <record id="action_casino_agents_players_view_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="2" />
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_casino_agents_players_tree" />
    <field name="act_window_id" ref="action_casino_agents_players" />
  </record> -->
</odoo>
