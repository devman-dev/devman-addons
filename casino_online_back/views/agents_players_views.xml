<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Vista Tree: Agentes y Jugadores -->
  <record id="view_casino_agents_players_tree" model="ir.ui.view">
    <field name="name">res.partner.agents.players.list</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <list string="Usuarios" create="0">
        <field name="name" string="Nombre" />
        <field name="nickname" string="Nickname" optional="show" />
        <field name="supervisor_agent_id" string="Padre" />
        <field name="role" string="Rol"
          widget="badge"
          decoration-bf="True" />
        <field name="create_date" string="Fecha de Alta" />
        <!-- <button name="action_open_load_chips_wizard"
          type="object" groups="base.group_system"
          title="Cargar Fichas"
          icon="fa-coins"
          class="btn-primary" /> -->
        <button name="action_open_load_chips_wizard"
          type="object"
          groups="base.group_system"
          icon="fa-money"
          class="btn btn-link o_icon_button"
          string=""
          title="Cargar/Retirar fichas"
          help="Cargar/Retirar fichas" />
      </list>
    </field>
  </record>

  <!-- Vista Kanban: Agentes y Jugadores (UX similar a Contactos) -->
  <record id="view_casino_agents_players_kanban" model="ir.ui.view">
    <field name="name">res.partner.agents.players.kanban</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <!--
        Notas de UX:
        - Usa el layout estándar tipo Contactos: imagen + detalles.
        - Mantiene el botón de "Cargar/Retirar fichas" como acción primaria.
      -->
      <kanban class="o_res_partner_kanban">
        <!-- Campos necesarios para el template -->
        <field name="name" />
        <field name="nickname" />
        <field name="role" />
        <field name="email" />
        <field name="phone" />
        <field name="mobile" />
        <field name="image_128" />
        <field name="supervisor_agent_id" />
        <templates>
          <t t-name="kanban-box">
            <div class="o_kanban_record o_kanban_global_click">
              <div class="o_kanban_image">
                <img class="o_kanban_image_fill" loading="lazy" alt="Avatar"
                    t-att-src="kanban_image('res.partner', 'image_128', record.id.raw_value)"/>
              </div>

              <div class="o_kanban_details">
                <div class="o_kanban_details_title">
                  <strong>
                    <span t-esc="record.name.value"/>
                  </strong>

                  <t t-if="record.role &amp;&amp; record.role.raw_value">
                    <span class="badge rounded-pill ms-2"
                          t-att-class="record.role.raw_value === 'agent' ? 'text-bg-primary' : 'text-bg-success'">
                      <t t-esc="record.role.raw_value === 'agent' ? 'Agente' : 'Jugador'"/>
                    </span>
                  </t>
                </div>

                <t t-if="record.nickname &amp;&amp; record.nickname.value">
                  <div class="text-muted">
                    <i class="fa fa-at me-1" aria-label="Nickname" title="Nickname"/>
                    <t t-esc="record.nickname.value"/>
                  </div>
                </t>

                <t t-if="record.supervisor_agent_id &amp;&amp; record.supervisor_agent_id.value &amp;&amp; record.role &amp;&amp; record.role.raw_value === 'player'">
                  <div class="text-muted">
                    <i class="fa fa-user-shield me-1" aria-label="Agente superior" title="Agente superior"/>
                    <span t-esc="record.supervisor_agent_id.value"/>
                  </div>
                </t>

                <div class="mt-2">
                  <t t-if="record.email &amp;&amp; record.email.value">
                    <div class="o_kanban_inline">
                      <i class="fa fa-envelope me-1" aria-label="Correo electrónico" title="Correo electrónico"/>
                      <a class="text-break"
                        t-att-href="'mailto:' + record.email.value">
                        <t t-esc="record.email.value"/>
                      </a>
                    </div>
                  </t>

                  <t t-if="record.phone &amp;&amp; record.phone.value">
                    <div class="o_kanban_inline">
                      <i class="fa fa-phone me-1" aria-label="Teléfono" title="Teléfono"/>
                      <a t-att-href="'tel:' + record.phone.value">
                        <t t-esc="record.phone.value"/>
                      </a>
                    </div>
                  </t>

                  <t t-if="(!record.phone || !record.phone.value) &amp;&amp; record.mobile &amp;&amp; record.mobile.value">
                    <div class="o_kanban_inline">
                      <i class="fa fa-mobile me-1" aria-label="Celular" title="Celular"/>
                      <a t-att-href="'tel:' + record.mobile.value">
                        <t t-esc="record.mobile.value"/>
                      </a>
                    </div>
                  </t>
                </div>

                <div class="mt-3">
                  <button type="object"
                          name="action_open_load_chips_wizard"
                          class="btn btn-sm btn-primary w-100 oe_kanban_action"
                          title="Cargar/Retirar fichas">
                    <i class="fa fa-coins me-1"/>
                    Cargar / Retirar fichas
                  </button>
                </div>
              </div>
            </div>
          </t>
        </templates>

      </kanban>
    </field>
  </record>

  <!-- Vista Search: Filtros para Agentes y Jugadores -->
  <record id="view_casino_agents_players_search" model="ir.ui.view">
    <field name="name">res.partner.agents.players.search</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <search string="Buscar Usuarios">
        <!-- Barra de búsqueda -->
        <field name="name" string="Nombre" filter_domain="[('name', 'ilike', self)]" />
        <field name="nickname" string="Nickname" filter_domain="[('nickname', 'ilike', self)]" />
        <field name="supervisor_agent_id" string="Agente Superior" />

        <!-- Filtros superiores -->
        <filter string="Agentes" name="filter_agents" domain="[('role', '=', 'agent')]" />
        <filter string="Jugadores" name="filter_players" domain="[('role', '=', 'player')]" />

        <separator />

        <!-- Agrupar por -->
        <group expand="0" string="Agrupar por">
          <filter string="Rol" name="group_by_role" context="{'group_by': 'role'}" />
          <filter string="Agente Superior" name="group_by_supervisor"
            context="{'group_by': 'supervisor_agent_id'}" />
          <filter string="Fecha de Alta" name="group_by_date" context="{'group_by': 'create_date'}" />
        </group>

        <!-- Filtros laterales -->
        <searchpanel>
          <field name="role" string="Rol" icon="fa-user-circle" enable_counters="1" />
        </searchpanel>
      </search>
    </field>
  </record>

  <!-- Acción de ventana -->
  <record id="action_casino_agents_players" model="ir.actions.act_window">
    <field name="name">Usuarios</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_casino_agents_players_search" />
    <field name="domain">['|', ('is_agent', '=', True), ('is_player', '=', True)]</field>
    <field name="context">{
      'search_default_is_agent': 0,
      'search_default_is_player': 0
      }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No hay usuarios aún</p>
      <p>Los usuarios se crean como Contactos. Marca "Es agente" o "Es jugador" para clasificarlos.</p>
    </field>
  </record>

  <!-- Asignación de vistas preferidas a la acción -->
  <record id="action_casino_agents_players_view_kanban" model="ir.actions.act_window.view">
    <field name="sequence" eval="1" />
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="view_casino_agents_players_kanban" />
    <field name="act_window_id" ref="action_casino_agents_players" />
  </record>
  <!-- <record id="action_casino_agents_players_view_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="2" />
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_casino_agents_players_tree" />
    <field name="act_window_id" ref="action_casino_agents_players" />
  </record> -->
</odoo>
