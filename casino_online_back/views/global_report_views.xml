<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Vista Tree para las líneas del reporte -->
  <record id="view_casino_global_report_line_tree" model="ir.ui.view">
    <field name="name">casino.global.report.line.list</field>
    <field name="model">casino.global.report.line</field>
    <field name="arch" type="xml">
      <list string="Detalle por Categoría" create="0" edit="0" delete="0"
        default_order="netwin desc" >
        <!-- decoration-info="color == 0 or color == 6"
        decoration-success="color == 1 or color == 7"
        decoration-warning="color == 2 or color == 8"
        decoration-danger="color == 3 or color == 9"
        decoration-primary="color == 4 or color == 10"
        decoration-muted="color == 5 or color == 11" > -->
        
        <field name="color" column_invisible="1" />
        <field name="categoria" string="Categoría" />
        <field name="apostado" sum="Total Apostado" widget="monetary" />
        <field name="ganado" sum="Total Ganado" widget="monetary" />
        <field name="netwin" sum="Total Netwin" widget="monetary" />
        <field name="rake" sum="Total Rake" widget="monetary" />
        <field name="participacion" string="Peso %" widget="percentage" />
        <field name="currency_id" column_invisible="1" />
      </list>
    </field>
  </record>

  <!-- Vista Form del Wizard (solo filtros) -->
  <record id="view_casino_global_report_wizard_form" model="ir.ui.view">
    <field name="name">casino.global.report.wizard.form</field>
    <field name="model">casino.global.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Reporte General - Filtros">
        <sheet>
          <group name="filters">
            <separator string="Reporte General de Jugadores" colspan="2" />
            <group>
              <label for="date_from" string="Período" />
              <div class="o_row">
                <field name="date_from" required="1" />
                <span class="mx-2">a</span>
                <field name="date_to" required="1" />
              </div>
              <label for="time_from" string="Horario" />
              <div class="o_row">
                <field name="time_from" widget="float_time" />
                <span class="mx-2">a</span>
                <field name="time_to" widget="float_time" />
              </div>
            </group>
            <group>
              <field name="filter_type" widget="radio" options="{'horizontal': true}" />
              <field name="user_id" invisible="filter_type != 'user'" />
            </group>
          </group>
          <footer>
            <button name="action_generate_report" type="object" string="Buscar"
              class="btn-primary" />
            <button string="Cancelar" special="cancel" />
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Vista Form del Resultado (reporte con datos) -->
  <record id="view_casino_global_report_result_form" model="ir.ui.view">
    <field name="name">casino.global.report.result.form</field>
    <field name="model">casino.global.report</field>
    <field name="arch" type="xml">
      <form string="Reporte General" create="false" delete="false">
        <header>
          <button name="action_view_sessions" type="object" string="Ver Sesiones"
            class="btn-secondary" />
          <button name="action_view_withdrawals" type="object" string="Cargas y Retiros"
            class="btn-secondary" />
          <button name="action_back_to_wizard" type="object" string="Volver" class="btn-secondary" />
        </header>
        <sheet>
          <!-- Filtros utilizados (readonly) -->
          <group name="filters_readonly">
            <separator string="Parámetros del Reporte" colspan="2" />
            <group>
              <label for="date_from" string="Período" />
              <div class="o_row">
                <field name="date_from" readonly="1" />
                <span class="mx-2">a</span>
                <field name="date_to" readonly="1" />
              </div>
              <label for="time_from" string="Horario" />
              <div class="o_row">
                <field name="time_from" widget="float_time" readonly="1" />
                <span class="mx-2">a</span>
                <field name="time_to" widget="float_time" readonly="1" />
              </div>
            </group>
            <group>
              <field name="filter_type" widget="radio" readonly="1" />
              <field name="user_id" invisible="filter_type != 'user'" readonly="1" />
            </group>
          </group>

          <!-- Sección del Reporte -->
          <group name="report_section" string="REPORTE POR CATEGORÍA">
            <field name="currency_id" invisible="1" />
            <field name="line_ids" nolabel="1" colspan="2" widget="one2many" readonly="1" />
          </group>

          <!-- Totales -->
          <!-- <group name="totals">
            <group string="TOTAL GENERAL" class="oe_subtotal_footer oe_right">
              <field name="total_apostado" string="Total Apostado" widget="monetary"
                class="oe_subtotal_footer_separator" readonly="1" />
              <field name="total_ganado" string="Total Ganado" widget="monetary" readonly="1" />
              <field name="total_netwin" string="Total Netwin" widget="monetary"
                class="oe_subtotal_footer_separator" readonly="1" />
              <field name="total_rake" string="Total Rake" widget="monetary" readonly="1" />
              <field name="total_cargas" string="Total Cargas" widget="monetary" readonly="1" />
              <field name="total_retiros" string="Total Retiros" widget="monetary" readonly="1" />
            </group>
          </group> -->
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción para abrir el wizard -->
  <record id="action_casino_global_report" model="ir.actions.act_window">
    <field name="name">Reporte General</field>
    <field name="res_model">casino.global.report.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="view_id" ref="view_casino_global_report_wizard_form" />
  </record>

</odoo>