<odoo>
    <record id="view_casino_game_withdrawals_form" model="ir.ui.view">
        <field name="name">casino.game.withdrawals.form</field>
        <field name="model">casino.game.withdrawals</field>
        <field name="arch" type="xml">
            <form string="Sesión de Juego">
                <header>
                    <button name="action_change_state" type="object" string="Aprobar"
                        class="btn-primary"
                        context="{'new_state': 'approved'}"
                        state="pending,rejected"
                        invisible="state not in ('pending','rejected')" />

                    <button name="action_change_state" type="object" string="Desaprobar"
                        class="btn-secondary"
                        context="{'new_state': 'rejected'}"
                        invisible="state != 'pending'"
                        confirm="¿Seguro que quieres desaprobar este retiro?" />

                    <field name="state" widget="statusbar"
                        statusbar_visible="pending,approved,rejected" />
                </header>

                <group>
                    <field name="transaction_id" />
                    <field name="date" />
                    <field name="partner_id" />
                    <field name="description" />
                    <field name="amount" />
                    <field name="state" widget="badge"
                        decoration-success="state == 'approved'"
                        decoration-danger="state == 'rejected'"
                        decoration-muted="state == 'pending'" />
                </group>
            </form>
        </field>
    </record>

    <record id="view_casino_game_withdrawals_tree" model="ir.ui.view">
        <field name="name">casino.game.withdrawals.tree</field>
        <field name="model">casino.game.withdrawals</field>
        <field name="arch" type="xml">
            <list string="Sesiones de Juego">
                <field name="transaction_id" string="ID Transacción" />
                <field name="date" string="Fecha" />
                <field name="partner_id" string="Jugador" />
                <field name="description" string="Descripción" />
                <field name="amount" string="Monto" />

                <!-- Botones rápidos -->
                <button name="action_change_state" type="object" string="Aprobar"
                    icon="fa-check" class="text-success o-withdraw-approve"
                    context="{'new_state': 'approved'}"
                    invisible="state != 'pending'" />

                <button name="action_change_state" type="object" string="Rechazar"
                    icon="fa-times" class="text-danger o-withdraw-reject"
                    context="{'new_state': 'rejected'}"
                    invisible="state != 'pending'"
                    confirm="¿Rechazar este retiro?" />

                <field name="state" string="Estado" widget="badge"
                    decoration-success="state == 'approved'"
                    decoration-danger="state == 'rejected'"
                    decoration-muted="state == 'pending'" />
                <field name="approved_by_id" string="Resuelto por" />
                <field name="approved_date" string="Fecha Resolución" />
            </list>
        </field>
    </record>

    <!-- Vista de búsqueda con agrupación por transaction_id -->
    <record id="view_casino_game_withdrawals_search" model="ir.ui.view">
        <field name="name">casino.game.withdrawals.search</field>
        <field name="model">casino.game.withdrawals</field>
        <field name="arch" type="xml">
            <search string="Buscar Retiros">
                <field name="transaction_id" />
                <field name="date" />
                <field name="description" />
                <field name="amount" />
                <field name="state" />
                <!-- Filtro Pendientes -->
                <filter name="pending" string="Pendientes"
                    domain="[('state', '=', 'pending')]" />
                <filter name="approved" string="Aprobados"
                    domain="[('state', '=', 'approved')]" />
                <filter name="rejected" string="Rechazados"
                    domain="[('state', '=', 'rejected')]" />
            </search>
        </field>
    </record>

    <!-- Acción con agrupamiento por defecto en transaction_id -->
    <record id="action_casino_game_withdrawals" model="ir.actions.act_window">
        <field name="name">Retiros de Dinero</field>
        <field name="res_model">casino.game.withdrawals</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_casino_game_withdrawals_tree" />
        <field name="search_view_id" ref="view_casino_game_withdrawals_search" />
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>