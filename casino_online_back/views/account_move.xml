<odoo>
    
    <!-- Safe search view for casino account move lines: minimal fields, no user_id -->

    <record id="account_move_line_view_search_inherit_casino" model="ir.ui.view">
        <field name="name">account.move.line.view.search.inherit.casino</field>
        <field eval="15" name="priority"/>
        <field name="model">account.move.line</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search string="Buscar Movimientos Casino">
                <field name="partner_id"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="account_id"/>
            </search>
        </field>
    </record>

