<odoo>
    <record id="view_product_form_inherit_casino_game" model="ir.ui.view">
        <field name="name">product.template.form.inherit.casino.game</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Datos del juego">
                    <field name="is_game"/>
                    <field name="iframe_url"/>
                    <field name="provider_id"/>
                    <field name="code"/>
                    <field name="url_login"/> <!-- URL para login del usuario -->
                    <field name="url_debit"/> <!-- ganada-->
                    <field name="url_credit"/> <!--perdida -->
                    <field name="url_balance"/> <!-- balance del usuario -->
                    <field name="game_id"/> <!-- ID del juego en el proveedor -->
                    <field name="agency_id"/> <!-- Agencia asociada al juego -->
                    <field name="game_id"/> <!-- ID del juego en el proveedor -->
                </group>
            </xpath>
        </field>
    </record>
</odoo>
