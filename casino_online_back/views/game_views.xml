<odoo>
  <record id="view_product_form_inherit_casino_game" model="ir.ui.view">
    <field name="name">product.template.form.inherit.casino.game</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="priority" eval="500"/>
    <field name="arch" type="xml">

      <!-- Tu pestaña de juego, siempre visible -->
      <xpath expr="//notebook" position="inside">
        <page name="casino_game_data" string="Datos del juego">
          <group>
            <field name="is_game"/>
            <field name="iframe_url"/>
            <field name="provider_id"/>
            <field name="code"/>
            <field name="url_login"/>
            <field name="url_debit"/>
            <field name="url_credit"/>
            <field name="url_balance"/>
            <field name="game_id"/>
            <field name="agency_id"/>
          </group>
        </page>
      </xpath>
      <xpath expr="//page[@name='general_information']//group[@name='group_general']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//page[@name='general_information']//group[@name='group_standard_price']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//page[@name='general_information']//group[@name='internal_notes']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

    </field>
  </record>
</odoo>
