<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_update_balance_game" model="ir.cron">
            <field name="name">Actualización y Chequeo de Balance de Jugadores</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field name="state">code</field>
            <field name="code">model.cron_update_balance_game()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>

    <!-- Diario 00:00 -->
    <record id="ir_cron_bet_limits_daily" model="ir.cron">
        <field name="name">Bet Limits: Reset Diario</field>
        <field name="model_id" ref="casino_online_back.model_casino_game_bet_limits" />
        <field name="state">code</field>
        <field name="code">model._cron_reset('daily')</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Semanal (Lunes 00:05 aprox) -->
    <record id="ir_cron_bet_limits_weekly" model="ir.cron">
        <field name="name">Bet Limits: Reset Semanal</field>
        <field name="model_id" ref="casino_online_back.model_casino_game_bet_limits" />
        <field name="state">code</field>
        <field name="code">model._cron_reset('weekly')</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">True</field>
    </record>

    <!-- Mensual (día 1 00:10 aprox) -->
    <record id="ir_cron_bet_limits_monthly" model="ir.cron">
        <field name="name">Bet Limits: Reset Mensual</field>
        <field name="model_id" ref="casino_online_back.model_casino_game_bet_limits" />
        <field name="state">code</field>
        <field name="code">model._cron_reset('monthly')</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">True</field>
    </record>

</odoo>