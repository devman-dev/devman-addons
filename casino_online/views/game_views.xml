<odoo>
    <record id="view_product_form_inherit_casino_game" model="ir.ui.view">
        <field name="name">product.template.form.inherit.casino.game</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Datos del juego">
                    <field name="is_game"/>
                    <field name="iframe_url"/>
                    <field name="provider_id"/>
                    <field name="code"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
