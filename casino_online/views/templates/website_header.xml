<odoo>
  <template id="website_navbar_balance" inherit_id="website.template_header_default">
    <xpath expr="//ul[contains(@class, 'flex-shrink-0')]" position="inside">
      <!-- Calcular nickname y saldo si no vienen en el contexto (páginas fuera de /my) -->
      <t t-set="_partner" t-value="request.env.user.partner_id.commercial_partner_id" />
      <!-- <t t-set="nickname" t-value="(_partner.nickname or _partner.name)"/> -->
      <!-- <t t-set="saldo_final" t-value="_partner.sudo().website_wallet_balance()" /> -->
      <t t-set="saldo_final" t-value="_partner.sudo().balance_game" />
      <t t-if="not request.env.user._is_public()">
        <li class="nav-item">
          <span class="nav-link text-nowrap"> Saldo: <span
              t-att-data-partner-id="request.env.user.partner_id.commercial_partner_id.id"
              t-att-class="'badge rounded-pill ' + ('bg-success' if saldo_final >= 0 else 'bg-danger')">
              <t t-if="saldo_final >= 0">
                <t
                  t-esc="request.env['ir.qweb.field.monetary'].value_to_html(saldo_final, {'display_currency': request.env.company.currency_id})" />
              </t>
              <t t-else=""> -<t
                  t-esc="request.env['ir.qweb.field.monetary'].value_to_html(abs(saldo_final), {'display_currency': request.env.company.currency_id})" />
              </t>
            </span>
          </span>
        </li>
      </t>
    </xpath>
  </template>

  <!-- ═══════════════════════════════════════════════════════════════
       INLINE STYLES — bypass asset bundle regeneration issues.
       These rules are injected into &lt;head&gt; on every frontend page.
       ═══════════════════════════════════════════════════════════════ -->
  <template id="website_inline_navbar_styles" inherit_id="website.layout">
    <xpath expr="//head" position="inside">
      <style type="text/css">
        /* ── White-to-Gold Navbar Gradient ── */
        #wrapwrap > header#top {
            background: linear-gradient(180deg, #FFFFFF 0%, #E8C874 100%) !important;
        }
        #wrapwrap > header#top .navbar {
            background: transparent !important;
        }

        /* ── Administrator button — white text in normal state ──
           :not(:hover)  →  only applies when mouse is OFF the button.
           On hover, the rule stops matching and the inherited :hover
           colour from a.nav-link:hover cascades through unchanged.  */
        header .o_no_autohide_item a.nav-link:not(:hover) {
            color: #FFFFFF !important;
        }
      </style>
    </xpath>
  </template>
</odoo>