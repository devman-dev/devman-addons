<odoo>
  <template id="website_navbar_balance" inherit_id="website.template_header_default">
    <xpath expr="//ul[contains(@class, 'flex-shrink-0')]" position="inside">
      <t t-if="saldo_final is not None">
        <li class="nav-item">
          <span class="nav-link text-nowrap">
            Saldo:
            <span t-att-class="'badge rounded-pill ' + ('bg-success' if saldo_final >= 0 else 'bg-danger')">
              <t t-if="saldo_final >= 0">
                <t t-esc="request.env['ir.qweb.field.monetary'].value_to_html(saldo_final, {'display_currency': request.env.company.currency_id})"/>
              </t>
              <t t-else="">
                -<t t-esc="request.env['ir.qweb.field.monetary'].value_to_html(abs(saldo_final), {'display_currency': request.env.company.currency_id})"/>
              </t>
            </span>
          </span>
        </li>
      </t>
    </xpath>
  </template>
</odoo>