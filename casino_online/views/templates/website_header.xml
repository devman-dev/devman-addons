<odoo>
  <template id="website_navbar_balance" inherit_id="website.template_header_default">
    <xpath expr="//ul[contains(@class, 'flex-shrink-0')]" position="inside">
      <t t-if="saldo_final is not None">
        <li class="nav-item">
          <span class="nav-link text-nowrap">
            Saldo:
            <span t-att-class="'badge rounded-pill ' + ('bg-success' if saldo_final >= 0 else 'bg-danger')">
              <t t-if="saldo_final >= 0">$<t t-esc="'%.2f' % saldo_final"/></t>
              <t t-else="">-$<t t-esc="'%.2f' % abs(saldo_final)"/></t>
            </span>
          </span>
        </li>
      </t>
    </xpath>
  </template>
</odoo>
