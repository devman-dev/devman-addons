                                                    t-att-class="'disabled' if (page or 1) &gt;= (page_count or 1) else None">
                                                    <a class="page-link"
                                                        t-attf-href="{{ request.httprequest.path }}?{{ q }}&amp;page={{ (page or 1) + 1 }}#movimientos_form">
                                                        ￫</a>
                                                </li>
                                            </ul>
                                        </nav>
                                    </div>
                                    <!-- ===== /Paginación ===== -->

                                </div>
                            </div>
                            <!-- ===== /Card de Resultados ===== -->

                        </div>
                    </div>

                    <!-- ===== /Movimientos ===== -->

                    <div id="medios_pagos_form" class="d-none">
                        <t t-call="casino_online.portal_medios_pagos" />
                    </div>

                    <div id="mis_limites_form" class="d-none">
                        <t t-call="casino_online.portal_mis_limites" />
                    </div>

                    <div id="datos_bancarios_form" class="d-none"
                        t-att-data-partner-id="user_id.partner_id.id">
                        <!-- <t t-call="casino_online.portal_datos_bancarios" /> -->

                        <!-- Contenedor del widget -->
                        <div class="card-body">
                            <div name="o_casino_bank_list_container"
                                t-att-data-partner-id="user_id.partner_id.id">

                                <div class="card mb-4 shadow-sm">
                                    <div class="card-header bg-primary text-white">
                                        <strong>Mis Datos Bancarios</strong>
                                    </div>

                                    <!-- FORMULARIO -->
                                    <div class="card-body">
                                        <form class="o_casino_bank_form">
                                            <div class="row g-2">
                                                <div class="col-md-3">
                                                    <input type="text" name="bank_name"
                                                        class="form-control"
                                                        placeholder="Banco" required="required" />
                                                </div>
                                                <div class="col-md-3">
                                                    <input type="text" name="cbu"
                                                        class="form-control"
                                                        placeholder="CBU" required="required" />
                                                </div>
                                                <div class="col-md-3">
                                                    <input type="text" name="cuil"
                                                        class="form-control"
                                                        placeholder="CUIL" required="required" />
                                                </div>
                                                <div class="col-md-3">
                                                    <button type="submit"
                                                        class="btn btn-primary w-100">
                                                        Agregar Banco
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                                <div class="card shadow-sm">
                                    <div class="card-header bg-info text-white">
                                        <strong>Mis Cuentas Activas</strong>
                                    </div>
                                    <p class="text-muted mb-2">
                                        La primera transferencia puede demorar más de lo habitual
                                        hasta
                                        tanto
                                        validemos la información.
                                    </p>

                                    <!-- TABLA -->
                                    <div class="card-body p-0">
                                        <table
                                            class="table table-sm table-hover mb-0">
                                            <thead style="font-size:0.9rem;">
                                                <tr>
                                                    <th>Titular</th>
                                                    <th>CUIL</th>
                                                    <th>Banco</th>
                                                    <th>CBU</th>
                                                </tr>
                                            </thead>
                                            <tbody class="o_casino_bank_table_body"
                                                style="font-size:0.9rem;"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                <!-- Cerrar contenido principal -->
                </div> <!-- .casino-content-area -->
            </div> <!-- .col-lg-9 -->
        </div> <!-- .row -->

        <!-- Menú Móvil (Bottom Navigation) -->
        <div class="casino-mobile-menu">
            <button class="casino-mobile-toggle" type="button">
                <i class="fa fa-bars me-2"></i>Menú del Cajero
            </button>
            <div class="casino-mobile-collapse">
                <nav class="p-3">
                    <!-- Saldo visible en móvil -->
                    <t t-set="_partner_mobile" t-value="request.env.user.partner_id.commercial_partner_id" />
                    <t t-set="saldo_mobile" t-value="_partner_mobile.sudo().balance_game" />
                    <div class="mb-3 p-3 rounded" style="background-color: #d1e7dd; border-left: 4px solid #198754;">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="fw-bold" style="color: #198754;">Saldo:</span>
                            <span t-att-class="'badge rounded-pill fs-6 ' + ('bg-success' if saldo_mobile >= 0 else 'bg-danger')">
                                <t t-if="saldo_mobile >= 0">
                                    <t t-esc="request.env['ir.qweb.field.monetary'].value_to_html(saldo_mobile, {'display_currency': request.env.company.currency_id})" />
                                </t>
                                <t t-else="">
                                    -<t t-esc="request.env['ir.qweb.field.monetary'].value_to_html(abs(saldo_mobile), {'display_currency': request.env.company.currency_id})" />
                                </t>
                            </span>
                        </div>
                    </div>
                    
                    <a href="#" class="casino-nav-link primary success" data-target="#depositar_form">
                        <i class="fa fa-plus-circle me-2"></i>Depositar
                    </a>
                    <a href="#" class="casino-nav-link primary warning" data-target="#retirar_form">
                        <i class="fa fa-minus-circle me-2"></i>Retirar
                    </a>
                    <a href="#" class="casino-nav-link primary info" data-target="#registrar_bonus_form">
                        <i class="fa fa-gift me-2"></i>Registrar Bonus
                    </a>
                    <div class="casino-section-title">Cajero</div>
                    <a href="#" class="casino-nav-link movements" data-target="#movimientos_form">
                        <i class="fa fa-list me-2"></i>Movimientos
                    </a>
                    <a href="#" class="casino-nav-link payment-methods" data-target="#medios_pagos_form">
                        <i class="fa fa-credit-card me-2"></i>Mis Medios de Pago
                    </a>
                    <a href="#" class="casino-nav-link limits" data-target="#mis_limites_form">
                        <i class="fa fa-shield me-2"></i>Mis Límites
                    </a>
                    <a href="#" class="casino-nav-link bank-data" data-target="#datos_bancarios_form">
                        <i class="fa fa-bank me-2"></i>Mis Datos Bancarios
                    </a>
                </nav>
            </div>
        </div>
    </div> <!-- #portal_client_category_1 -->
    </xpath>
    </template>

