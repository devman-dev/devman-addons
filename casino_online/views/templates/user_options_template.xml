                    transform: translateX(4px);
                }
                .casino-nav-link.primary {
                    font-weight: 600;
                    padding: 1rem;
                }
                .casino-nav-link.success { background-color: #d1e7dd; border-left-color: #198754; }
                .casino-nav-link.warning { background-color: #fff3cd; border-left-color: #ffc107; }
                .casino-nav-link.info { background-color: #cff4fc; border-left-color: #0dcaf0; }
                .casino-nav-link.success:hover { background-color: #c0dbd3; }
                .casino-nav-link.warning:hover { background-color: #ffe9a8; }
                .casino-nav-link.info:hover { background-color: #b6effb; }
                /* Active para links con color base */
                .casino-nav-link.success.active { background-color: #198754; color: white; }
                .casino-nav-link.warning.active { background-color: #ffc107; color: #212529; }
                .casino-nav-link.info.active { background-color: #0dcaf0; color: white; }
                
                /* Colores específicos para opciones de Cajero */
                /* Movimientos - Azul Grisáceo Profundo (Neutralidad profesional) */
