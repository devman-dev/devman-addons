                    top: 1rem;
                    max-height: calc(100vh - 2rem);
                    overflow-y: auto;
                    overflow: hidden;
                }
                
                .casino-section-title {
                    font-size: 0.875rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    color: #6c757d;
                    margin: 1.5rem 0 0.75rem 0;
