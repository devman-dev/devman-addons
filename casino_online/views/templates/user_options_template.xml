                /* Prevenir overflow horizontal global */
                body, html {
                    overflow-x: hidden;
                    max-width: 100vw;
                }
                .o_portal_wrap {
                    overflow-x: hidden;
                    max-width: 100%;
                }
                
                /* Estilos responsivos para navegación del cajero */
