                    /*background-color: #e8eef5;
                    border-left-color: #263238;*/
                    color: #0449b3;
                }
                .casino-nav-link.movements:hover {
                    background-color: #E3F2FD;
                    border-left-color: #0093ff;
                }
                .casino-nav-link.movements.active {
                    background-color: #55a8d1;
                    color: white;
                    border-left-color: #55a8d1;
                }
                
                /* Mis Medios de Pago - Verde Bosque (Confianza + dinero) */
