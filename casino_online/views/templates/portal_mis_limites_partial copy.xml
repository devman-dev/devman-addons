<odoo>
    <template id="bet_limits_form_partial" t-name="casino_online.portal_bet_limits_form">
        <!-- <t t-name="casino_online.portal_bet_limits_form"> -->

        <!-- Símbolo de moneda (fallback a $) -->
        <t t-set="currency_symbol"
            t-value="(bl and bl.currency_id and bl.currency_id.symbol) or '$'" />

        <div class="card shadow-sm">
            <div class="card-header text-white" style="background-color:#6b4a63">
                <h3 class="mb-0">Límites de Depósito</h3>
            </div>

            <form class="card-body" t-attf-action="/casino/bet_limits/save" method="post"
                id="bet_limits_form" novalidate="novalidate">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />

                <!-- Límite diario -->
                <div class="mb-4">
                    <label class="form-label"> Límite diario de depósito (<t
                            t-esc="bl.currency_id and bl.currency_id.name or 'USD'" />) </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <t t-esc="currency_symbol" />
                        </span>
                        <input type="number" min="0" step="0.01"
                            class="form-control limit-input"
                            id="limit_daily" name="limit_daily"
                            t-att-value="bl.limit_daily or 0.0"
                            t-att-data-original="bl.limit_daily or 0.0"
                            placeholder="0.00" required="required" />
                    </div>
                </div>

                <!-- Límite semanal -->
                <div class="mb-4">
                    <label class="form-label"> Límite semanal de depósito (<t
                            t-esc="bl.currency_id and bl.currency_id.name or 'USD'" />) </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <t t-esc="currency_symbol" />
                        </span>
                        <input type="number" min="0" step="0.01"
                            class="form-control limit-input"
                            id="limit_weekly" name="limit_weekly"
                            t-att-value="bl.limit_weekly or 0.0"
                            t-att-data-original="bl.limit_weekly or 0.0"
                            placeholder="0.00" required="required" />
                    </div>
                </div>

                <!-- Límite mensual -->
                <div class="mb-4">
                    <label class="form-label"> Límite mensual de depósito (<t
                            t-esc="bl.currency_id and bl.currency_id.name or 'USD'" />) </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <t t-esc="currency_symbol" />
                        </span>
                        <input type="number" min="0" step="0.01"
                            class="form-control limit-input"
                            id="limit_monthly" name="limit_monthly"
                            t-att-value="bl.limit_monthly or 0.0"
                            t-att-data-original="bl.limit_monthly or 0.0"
                            placeholder="0.00" required="required" />
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button type="submit"
                        class="btn btn-lg text-white px-5"
                        id="btn_save_limits"
                        style="background-color:#6b4a63; border-radius:2rem;"
                        disabled="disabled">
                        Guardar Límites
                    </button>
                </div>
            </form>
        </div>

        <!-- JS: en XML escapá & como &amp; -->
        <script type="text/javascript">
            (function(){
            function toNumber(v){ return (v === '' || v === null || v === undefined) ? NaN :
            Number(v); }
            function isValid(n){ return !isNaN(n) &amp;&amp; isFinite(n) &amp;&amp; n &gt;= 0; }
            function fmt(x){ return isNaN(x) ? 'NaN' : Number(x).toFixed(2); }

            function refresh(){
            var inputs = document.querySelectorAll('#bet_limits_form .limit-input');
            var changed = false, allValid = true;

            inputs.forEach(function(inp){
            var val = toNumber(inp.value);
            var orig = toNumber(inp.getAttribute('data-original'));
            if(!isValid(val)){ allValid = false; inp.classList.add('is-invalid'); }
            else { inp.classList.remove('is-invalid'); }
            if(fmt(val) !== fmt(orig)) changed = true;
            });

            var btn = document.getElementById('btn_save_limits');
            if(btn) btn.disabled = !(changed &amp;&amp; allValid);
            }

            document.addEventListener('input', function(ev){
            if(ev.target &amp;&amp; ev.target.classList.contains('limit-input')) refresh();
            });
            document.addEventListener('DOMContentLoaded', refresh);
            })();
        </script>

        <!-- </t> -->
    </template>

