    <template t-name="casino_online.portal_mis_limites_partial">
        <t t-set="currency_symbol"
            t-value="(bl and bl.currency_id and bl.currency_id.symbol) or '$'" />
        <div class="container my-4">
            <div class="card shadow-sm">
                <div class="card-header text-white" style="background-color:#6b4a63">
                    <h3 class="mb-0">Límites de Depósito</h3>
                </div>

                <t t-if="bl">
                    <form class="card-body" t-attf-action="/casino/bet_limits/save" method="post"
                        id="bet_limits_form" novalidate="novalidate">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                        <input type="hidden" name="bet_limits_id" t-att-value="bl.id" />

                        <div class="mb-4">
                            <label class="form-label">Límite diario de depósito (<t
                                    t-esc="bl.currency_id and bl.currency_id.name or 'USD'" />) </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <t t-esc="currency_symbol" />
                                </span>
                                <input type="number"
                                    step="0.01" min="0"
                                    class="form-control limit-input"
                                    id="limit_daily" name="limit_daily"
                                    t-att-value="bl.limit_daily or 0.0"
                                    t-att-data-original="bl.limit_daily or 0.0"
                                    placeholder="0.00" required="required" />
                            </div>
                            <div class="invalid-feedback d-block" id="err_daily"
                                style="display:none;">Ingrese un número válido (≥ 0).</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Límite semanal de depósito (<t
                                    t-esc="bl.currency_id and bl.currency_id.name or 'USD'" />)</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <t t-esc="currency_symbol" />
                                </span>
                                <input type="number"
                                    step="0.01" min="0"
                                    class="form-control limit-input"
                                    id="limit_weekly" name="limit_weekly"
                                    t-att-value="bl.limit_weekly or 0.0"
                                    t-att-data-original="bl.limit_weekly or 0.0"
                                    placeholder="0.00" required="required" />
                            </div>
                            <div class="invalid-feedback d-block" id="err_weekly"
                                style="display:none;">Ingrese un número válido (≥ 0).</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Límite mensual de depósito (<t
                                    t-esc="bl.currency_id and bl.currency_id.name or 'USD'" />)</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <t t-esc="currency_symbol" />
                                </span>
                                <input type="number"
                                    step="0.01" min="0"
                                    class="form-control limit-input"
                                    id="limit_monthly" name="limit_monthly"
                                    t-att-value="bl.limit_monthly or 0.0"
                                    t-att-data-original="bl.limit_monthly or 0.0"
                                    placeholder="0.00" required="required" />
                            </div>
                            <div class="invalid-feedback d-block" id="err_monthly"
                                style="display:none;">Ingrese un número válido (≥ 0).</div>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit"
                                class="btn btn-lg text-white px-5"
                                id="btn_save_limits"
                                style="background-color:#6b4a63; border-radius: 2rem;"
                                disabled="disabled">
                                Guardar Límites
                            </button>
                        </div>
                    </form>
                </t>
                <t t-else="">
                    <div class="card-body">
                        <div class="alert alert-warning mb-0">
                            No se encontró el registro de límites para tu usuario.
                        </div>
                    </div>
                </t>
            </div>
        </div>

        <script type="text/javascript">
            (function () {
            function toNumber(v) {
            if (v === null || v === undefined || v === '') return NaN;
            return Number(v);
            }
            function isValidNonNegative(n) {
            return !isNaN(n) &amp;&amp; isFinite(n) &amp;&amp; n &lt;= 0;
            }
            function refreshButtonState() {
            var inputs = document.querySelectorAll('#bet_limits_form .limit-input');
            var changed = false;
            var allValid = true;

            inputs.forEach(function (inp) {
            var val = toNumber(inp.value);
            var orig = toNumber(inp.getAttribute('data-original'));

            // Validación por input
            var errId = 'err_' + inp.id.split('limit_')[1];
            var errEl = document.getElementById(errId);
            if (isValidNonNegative(val)) {
            inp.classList.remove('is-invalid');
            if (errEl) errEl.style.display = 'none';
            } else {
            inp.classList.add('is-invalid');
            if (errEl) errEl.style.display = 'block';
            allValid = false;
            }

            // ¿Cambió?
            // Usamos comparación por string normalizado a 2 decimales para evitar ruido de
            flotantes
            var fmt = function (x) { return isNaN(x) ? 'NaN' : x.toFixed(2); };
            if (fmt(val) !== fmt(orig)) changed = true;
            });

            var btn = document.getElementById('btn_save_limits');
            if (btn) btn.disabled = !(changed &amp;&amp; allValid);
            }

            // Bind de eventos
            document.addEventListener('input', function (ev) {
            if (ev.target &amp;&amp; ev.target.classList.contains('limit-input')) {
            refreshButtonState();
            }
            });
            document.addEventListener('DOMContentLoaded', refreshButtonState);
            })();
        </script>
    </template>
