<odoo>
    <template t-name="casino_online.portal_mis_limites_partial">
        <div id="mis_limites">
            <form action="/my/mis_limites" method="post" class="o_portal_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                <div class="mb-4">
                    <label for="daily_limit" class="form-label fw-bold">Límite diario de depósito</label>
                    <input type="number" step="1" min="0" name="daily_limit" id="daily_limit"
                        inputmode="numeric" pattern="\d*"
                        class="form-control"
                        t-att-value="int(daily_limit) if daily_limit else ''" />
                </div>

                <div class="mb-4">
                    <label for="weekly_limit" class="form-label fw-bold">Límite semanal de depósito</label>
                    <input type="number" step="1" min="0" name="weekly_limit" id="weekly_limit"
                        inputmode="numeric" pattern="\d*"
                        class="form-control"
                        t-att-value="int(weekly_limit) if weekly_limit else ''" />
                </div>

                <div class="mb-4">
                    <label for="monthly_limit" class="form-label fw-bold">Límite mensual de depósito</label>
                    <input type="number" step="1" min="0" name="monthly_limit" id="monthly_limit"
                        inputmode="numeric" pattern="\d*"
                        class="form-control"
                        t-att-value="int(monthly_limit) if monthly_limit else ''" />
                </div>
                <!-- <div>
                    <label>Límite Depósito Diario</label>
                    <input type="number" name="limite_deposito_diario"
                        t-att-value="partner.limite_deposito_diario" />
                </div>

                <div>
                    <label>Límite Pérdida Semanal</label>
                    <input type="number" name="limite_perdida_semanal"
                        t-att-value="partner.limite_perdida_semanal" />
                </div>
                <div>
                    <label>Tiempo de Sesión (min)</label>
                    <input type="number" name="tiempo_sesion"
                        t-att-value="partner.tiempo_sesion" />
                </div> -->
                <button type="submit" class="btn btn-primary">Guardar Límites</button>

            </form>
        </div>
    </template>
</odoo>